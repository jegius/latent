// UTF-8 scan: byte length vs. code-point count over a real multilingual
// string literal. Byte access is load8(ptr + 4 + i) — the [len u32][bytes]
// layout described in the WASM ABI. `rounds` passes; stats are written to
// addresses 128/132 so the JS host can display them.

fn main(rounds: int) -> int {
    let s = "Привет, Latent! 🚀 — naïve café, 日本語, Ελληνικά. Слава Україні!";
    let bytes = len(s);
    let acc = 0;
    let points = 0;
    let r = 0;
    while (r < rounds) {
        let i = 0;
        while (i < bytes) {
            let b = s[i];
            acc = (acc * 33 + b) & 2147483647;
            i = i + 1;
        }
        r = r + 1;
    }

    // Count code points once: UTF-8 continuation bytes have 10xxxxxx prefix.
    let i = 0;
    while (i < bytes) {
        let b = s[i];
        if ((b & 192) != 128) {
            points = points + 1;
        }
        i = i + 1;
    }
    store32(128, bytes);
    store32(132, points);
    return acc;
}
