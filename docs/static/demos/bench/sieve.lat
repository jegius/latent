// Sieve of Eratosthenes on a flat byte array.
// Allocates `n + 1` bytes once (address 8), resets and re-sieves on every call
// so the host can run it repeatedly for warm-up and measurement.

fn main(n: int) -> int {
    let ptr = load32(8);
    if (ptr == 0) {
        ptr = alloc(n + 8);
        store32(8, ptr);
    }

    let i = 0;
    while (i <= n) {
        store8(ptr + i, 1);
        i = i + 1;
    }
    store8(ptr, 0);
    if (n >= 1) {
        store8(ptr + 1, 0);
    }

    let p = 2;
    while (p * p <= n) {
        if (load8(ptr + p) != 0) {
            let j = p * p;
            while (j <= n) {
                store8(ptr + j, 0);
                j = j + p;
            }
        }
        p = p + 1;
    }

    let count = 0;
    i = 2;
    while (i <= n) {
        count = count + load8(ptr + i);
        i = i + 1;
    }
    return count;
}
