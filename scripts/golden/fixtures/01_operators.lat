// Golden-набор: операторы int, битовые, сравнения и логические.
// expect-main: 79

fn int_ops(a: int, b: int) -> int {
    let r = a + b;
    r = r - b;
    r = r * b;
    r = r / b;
    r = r % b;
    return r;
}

fn bit_ops(a: int, b: int) -> int {
    let r = a & b;
    r = r | (a << 2);
    r = r ^ (b >> 1);
    return r;
}

fn cmp_ops(a: int, b: int) -> int {
    let r = 0;
    if (a < b) { r = r + 1; }
    if (a <= b) { r = r + 2; }
    if (a > b) { r = r + 4; }
    if (a >= b) { r = r + 8; }
    if (a == b) { r = r + 16; }
    if (a != b) { r = r + 32; }
    return r;
}

fn logic(t: bool, g: bool) -> int {
    let r = 0;
    if (t && g) { r = r + 1; }
    if (t || g) { r = r + 2; }
    if (!t) { r = r + 4; }
    if (!g) { r = r + 8; }
    return r;
}

fn float_ops(x: float, y: float) -> float {
    let r = x + y;
    r = r - y;
    r = r * y;
    r = r / y;
    r = -r;
    return r;
}

fn unary_int(a: int) -> int {
    return -a;
}

fn main() -> int {
    print("int_ops =", int_ops(17, 5));
    print("bit_ops =", bit_ops(7, 3));
    print("cmp_ops =", cmp_ops(17, 5));
    print("logic =", logic(true, false));
    print("float_ops =", float_ops(1.5, 2.5));
    print("unary =", unary_int(7));
    return int_ops(17, 5) + bit_ops(7, 3) + cmp_ops(17, 5) + logic(true, false)
        + unary_int(7) + 0;
}
