// Golden-набор: управляющие конструкции — if/else, while, forC, for-in,
// spawn, select, yield, async/await, test-декларация.
// expect-main: 2

fn classify(n: int) -> int {
    if (n < 0) {
        return -1;
    } else if (n == 0) {
        return 0;
    } else {
        return 1;
    }
}

fn worker() -> int {
    yield;
    return 1;
}

fn consume(ch) -> int {
    select {
        case v <- ch: { print(v); }
        default: { print(0); }
    }
    return 2;
}

fn select_expr(ch) -> int {
    let first = select { case v <- ch: v };
    return first;
}

async fn value() -> int {
    return 5;
}

fn main() -> int {
    print("classify =", classify(-5) + classify(0) + classify(7));

    let n = 10;
    let steps = 0;
    while (n != 1) {
        if (n % 2 == 0) { n = n / 2; } else { n = 3 * n + 1; }
        steps = steps + 1;
    }
    print("collatz steps =", steps);

    let acc = 0;
    for (let i = 0; i < 5; i = i + 1) {
        acc = acc + i;
    }
    print("forC acc =", acc);

    for (let x in [1, 2, 3]) {
        acc = acc + x;
    }
    print("for-in acc =", acc);

    spawn {
        print("spawned");
    }

    let w = worker();
    print("worker =", w);
    let ch = 0;
    print("consume =", consume(ch));
    print("select_expr =", select_expr(ch));
    print("awaited =", await value());

    test "arithmetic" {
        assert(1 + 1 == 2);
    }
    assert(true);
    assert_eq(1 + 1, 2);

    return classify(0) + classify(7) + classify(-1) * 0 + w + select_expr(ch) + 0;
}
