// --- эмиссия ---
fn ev(b) -> int { return bput(FNB(), b); }
fn ev_leb(v) -> int { return bleb(FNB(), v); }
fn ev_sleb(v) -> int { return bsleb(FNB(), v); }
fn nf() -> int { return get(0, 2); }
fn ALLOC_FI() -> int { return get(0, 2) + 1; }
fn MEM_FI() -> int { return get(0, 2) + 2; }
fn SCAT_FI() -> int { return get(0, 2) + 3; }   // str_concat(a,b)->ptr
fn SEQ_FI() -> int { return get(0, 2) + 4; }    // str_eq(a,b)->i32
fn SCHR_FI() -> int { return get(0, 2) + 5; }   // str_char_at(ptr,idx)->i32
fn I32S_FI() -> int { return get(0, 2) + 6; }   // i32_to_str(n)->ptr
fn S2I_FI() -> int { return get(0, 2) + 7; }    // str_to_i32(ptr)->i32
fn NHELP() -> int { return 7; }                 // alloc+memcopy+3 str+2 conv

fn emit_bi1(fi, opcode, align) -> int {
    let base = get(0, 7);
    expect(20); level_or(); expect(21);
    if (opcode == 0) { ev(16); ev_leb(fi); } else { ev(opcode); ev(align); ev(0); }
    set(0, 5, 1);
    set(0, 7, base); tp(T_INT());
    return 0;
}
fn emit_bi2(fi, opcode, align, produces) -> int {
    let base = get(0, 7);
    expect(20); level_or();
    if (tkind() == 24) { adv(); }
    level_or(); expect(21);
    if (opcode == 0) { ev(16); ev_leb(fi); } else { ev(opcode); ev(align); ev(0); }
    set(0, 5, produces);
    set(0, 7, base);
    if (produces == 1) { tp(T_INT()); }
    return 0;
}
fn emit_memcopy() -> int {
    let base = get(0, 7);
    expect(20); level_or();
    if (tkind() == 24) { adv(); }
    level_or();
    if (tkind() == 24) { adv(); }
    level_or(); expect(21);
    ev(16); ev_leb(MEM_FI());
    set(0, 5, 1);
    set(0, 7, base); tp(T_INT());
    return 0;
}

fn emit_call(off, ln) -> int {
    if (is_lit(off, ln, "print", 5)) { return emit_call_named(0, 1); }
    if (is_lit(off, ln, "alloc", 5)) { return emit_bi1(ALLOC_FI(), 0, 0); }
    if (is_lit(off, ln, "memcopy", 7)) { return emit_memcopy(); }
    if (is_lit(off, ln, "load8", 5)) { return emit_bi1(0, 45, 0); }
    if (is_lit(off, ln, "load32", 6)) { return emit_bi1(0, 40, 2); }
    if (is_lit(off, ln, "store8", 6)) { return emit_bi2(0, 58, 0, 0); }
    if (is_lit(off, ln, "store32", 7)) { return emit_bi2(0, 54, 2, 0); }
    if (is_lit(off, ln, "len", 3)) { return emit_len(); }
    if (is_lit(off, ln, "push", 4)) { return emit_push_call(); }
    if (is_lit(off, ln, "assert", 6)) { return emit_assert(); }
    if (is_lit(off, ln, "assert_eq", 9)) { return emit_assert_eq(); }
    if (is_lit(off, ln, "str", 3)) { return emit_str_conv(); }
    if (is_lit(off, ln, "int", 3)) { return emit_int_conv(); }
    let fi = find_func(off, ln);
    if (fi < 0) {
        // Конструктор enum-варианта: Tag(args) → [tag i32][fields...].
        let tag = variant_tag(off, ln);
        if (tag >= 0) { return emit_variant(tag, variant_arity(off, ln)); }
        // Локаль, хранящая замыкание → косвенный вызов.
        let li = find_local(off, ln);
        if (li >= 0) { return emit_indirect_call(li); }
        err(); return 0;
    }
    return emit_call_named(fi + 1, 0);
}

// Tag(args) → указатель на [tag i32][field0]... 0-арный — сам тег.
fn emit_variant(tag, ar) -> int {
    let base = get(0, 7);
    expect(20);
    if (ar == 0) {
        while (tkind() != 21 && tkind() != 0) { set(0, 7, base); level_or(); if (tkind() == 24) { adv(); } }
        expect(21);
        ev(65); ev_sleb(tag);
        set(0, 5, 1); set(0, 7, base); tp(T_INT()); return 0;
    }
    let p = reserve();
    ev(65); ev_sleb(4 + ar * 4); ev(16); ev_leb(ALLOC_FI()); ev(33); ev_leb(p);
    let i = 0;
    while (tkind() != 21 && tkind() != 0) {
        set(0, 7, base);
        ev(32); ev_leb(p); ev(65); ev_sleb(4 + i * 4); ev(106);
        level_or();
        ev(54); ev(2); ev(0);
        i = i + 1;
        if (tkind() == 24) { adv(); }
    }
    expect(21);
    ev(32); ev_leb(p); ev(65); ev_sleb(tag); ev(54); ev(2); ev(0);
    ev(32); ev_leb(p);
    set(0, 5, 1); set(0, 7, base); tp(T_INT());
    return 0;
}

// len(x) -> длина из заголовка [len u32][...] (общее представление строк/массивов).
fn emit_len() -> int {
    let base = get(0, 7);
    expect(20); level_or(); expect(21);
    ev(40); ev(2); ev(0);
    set(0, 5, 1);
    set(0, 7, base); tp(T_INT());
    return 0;
}

// assert(cond): if !cond { unreachable }.
fn emit_assert() -> int {
    let base = get(0, 7);
    expect(20); level_or(); expect(21);
    ev(69); ev(4); ev(64); ev(0); ev(11);
    set(0, 5, 0);
    set(0, 7, base);
    return 0;
}

// assert_eq(a, b): if a != b { unreachable } (i32-равенство, как в oracle).
fn emit_assert_eq() -> int {
    let base = get(0, 7);
    expect(20); level_or();
    if (tkind() == 24) { adv(); }
    level_or(); expect(21);
    ev(70); ev(69); ev(4); ev(64); ev(0); ev(11);
    set(0, 5, 0);
    set(0, 7, base);
    return 0;
}

// str(x): строка остаётся, число конвертируется в строку (i32_to_str).
fn emit_str_conv() -> int {
    let base = get(0, 7);
    expect(20);
    if (tkind() == 21) { adv(); ev(65); ev_sleb(0); set(0, 5, 1); set(0, 7, base); tp(T_STR()); return 0; }
    level_or();
    let xt = load32(TSTK() + base * 4);
    expect(21);
    if (xt != T_STR()) { ev(16); ev_leb(I32S_FI()); }
    set(0, 5, 1); set(0, 7, base); tp(T_STR());
    return 0;
}
// int(x): строку парсим (str_to_i32), число как есть (f64-усечение не поддержано).
fn emit_int_conv() -> int {
    let base = get(0, 7);
    expect(20);
    if (tkind() == 21) { adv(); ev(65); ev_sleb(0); set(0, 5, 1); set(0, 7, base); tp(T_INT()); return 0; }
    level_or();
    let xt = load32(TSTK() + base * 4);
    expect(21);
    if (xt == T_STR()) { ev(16); ev_leb(S2I_FI()); }
    set(0, 5, 1); set(0, 7, base); tp(T_INT());
    return 0;
}

// push(arr, x): arr[len]=x; arr.len=len+1; результат — arr.
// Стек после разбора: [arr, x].
fn emit_push_call() -> int {
    let base = get(0, 7);
    expect(20); level_or();
    if (tkind() == 24) { adv(); }
    level_or(); expect(21);
    let xl = reserve(); ev(33); ev_leb(xl);
    let al = reserve(); ev(33); ev_leb(al);
    emit_push_seq(al, xl);
    set(0, 5, 1);
    set(0, 7, base); tp(T_INT());
    return 0;
}

// Общая последовательность push для уже сохранённых в локалях arr/x.
fn emit_push_seq(al, xl) -> int {
    ev(32); ev_leb(al); ev(32); ev_leb(al); ev(40); ev(2); ev(0); ev(65); ev_sleb(4); ev(108); ev(106); ev(65); ev_sleb(4); ev(106); ev(32); ev_leb(xl); ev(54); ev(2); ev(0);
    ev(32); ev_leb(al); ev(32); ev_leb(al); ev(40); ev(2); ev(0); ev(65); ev_sleb(1); ev(106); ev(54); ev(2); ev(0);
    ev(32); ev_leb(al);
    return 0;
}

// Общая последовательность pop для arr в локали: len--; результат arr[len].
fn emit_pop_seq(al) -> int {
    ev(32); ev_leb(al); ev(32); ev_leb(al); ev(40); ev(2); ev(0); ev(65); ev_sleb(1); ev(107); ev(54); ev(2); ev(0);
    ev(32); ev_leb(al); ev(32); ev_leb(al); ev(40); ev(2); ev(0); ev(65); ev_sleb(4); ev(108); ev(106); ev(65); ev_sleb(4); ev(106); ev(40); ev(2); ev(0);
    return 0;
}
fn emit_call_named(fidx, is_print) -> int {
    let base = get(0, 7);
    expect(20);
    let argc = 0;
    while (tkind() != 21 && tkind() != 0) {
        level_or(); argc = argc + 1;
        if (tkind() == 24) { adv(); }
    }
    expect(21);
    ev(16); ev_leb(fidx);
    set(0, 7, base);
    if (is_print == 1) { set(0, 5, 0); }
    else {
        set(0, 5, 1);
        // fidx = find_func(...)+1, функция index = fidx-1.
        tp(load32(FNRET() + (fidx - 1) * 4));
    }
    return 0;
}

fn level_primary() -> int {
    let k = tkind();
    if (k == 1) { ev(65); ev_sleb(tval()); adv(); set(0, 5, 1); tp(T_INT()); return 0; }
    if (k == 90) { ev(65); ev_sleb(1); adv(); set(0, 5, 1); tp(T_INT()); return 0; }
    if (k == 91) { ev(65); ev_sleb(0); adv(); set(0, 5, 1); tp(T_INT()); return 0; }
    if (k == 3) {
        let q = tval(); let ql = tlen();
        let addr = str_addr(q + 1, ql - 2);
        ev(65); ev_sleb(addr); adv(); set(0, 5, 1); tp(T_STR()); return 0;
    }
    if (k == 20) { adv(); level_or(); expect(21); return 0; }
    if (k == 80) { return level_array(); }
    if (k == 31) { adv(); ev(65); ev_sleb(0); level_unary(); ev(107); set(0, 5, 1); return 0; }
    if (k == 53) { adv(); level_unary(); ev(69); set(0, 5, 1); return 0; }
    if (k == 94) { adv(); ev(32); ev_leb(0); set(0, 5, 1); tp(T_INT()); set(0, 8, load32(FNCLS() + load32(CURFI()) * 4)); return 0; }
    if (k == 93) { return level_new(); }
    if (k == 95) { return level_match(); }
    if (k == 11) { return level_lambda(); }
    if (is_ident_kind(k)) {
        let off = tval(); let ln = tlen();
        // 0-арный enum-вариант как значение (без скобок).
        if (tkind_at(1) != 20 && find_local(off, ln) < 0 && find_func(off, ln) < 0
            && variant_tag(off, ln) >= 0) {
            ev(65); ev_sleb(variant_tag(off, ln)); adv();
            set(0, 5, 1); tp(T_INT()); set(0, 8, -1); return 0;
        }
        adv();
        if (tkind() == 20) { return emit_call(off, ln); }
        let li = find_local(off, ln);
        if (li >= 0) { ev(32); ev_leb(li); set(0, 5, 1); tp(local_tp(li)); set(0, 8, load32(LOCCLS() + li * 4)); return 0; }
        err(); return 0;
    }
    err(); set(0, 5, 1); tp(T_INT()); set(0, 8, -1); return 0;
}

// Литерал лямбды `fn(params) => expr` / `fn(params) { ... }` → closure-указатель
// [table_slot i32][env_ptr i32]. Лямбда уже вынесена в отдельную функцию
// (scan_lambdas); здесь создаётся env с захватами и сам closure-объект.
fn level_lambda() -> int {
    let li = lambda_at(get(0, 0));
    if (li < 0) { err(); return 0; }
    let nc = cap_count(li);
    // env = alloc(4*nc) или 0
    let env = reserve();
    if (nc > 0) {
        ev(65); ev_sleb(4 * nc); ev(16); ev_leb(ALLOC_FI()); ev(33); ev_leb(env);
    } else {
        ev(65); ev_sleb(0); ev(33); ev_leb(env);
    }
    let c = 0;
    while (c < nc) {
        let locali = find_local(cap_name_off(li, c), cap_name_len(li, c));
        if (locali >= 0) {
            ev(32); ev_leb(env); ev(65); ev_sleb(c * 4); ev(106);
            ev(32); ev_leb(locali);
            ev(54); ev(2); ev(0);
        }
        c = c + 1;
    }
    // closure = alloc(8); [0]=table_slot(=индекс функции); [4]=env
    let cl = reserve();
    ev(65); ev_sleb(8); ev(16); ev_leb(ALLOC_FI()); ev(33); ev_leb(cl);
    ev(32); ev_leb(cl); ev(65); ev_sleb(lam_fn(li)); ev(54); ev(2); ev(0);
    ev(32); ev_leb(cl); ev(65); ev_sleb(4); ev(106); ev(32); ev_leb(env); ev(54); ev(2); ev(0);
    ev(32); ev_leb(cl);
    // Пропускаем тело лямбды до его конца (оно уже скомпилировано отдельно).
    set(0, 0, lam_body_end(li));
    set(0, 5, 1); tp(T_INT()); set(0, 8, -1);
    return 0;
}

// Косвенный вызов замыкания: callee — локаль, хранящая closure-указатель.
// events: env в локали, аргументы, индекс таблицы; всё через call_indirect.
fn emit_indirect_call(callee_slot) -> int {
    let base = get(0, 7);
    expect(20);                   // '('
    // env = [closure+4]: адрес сначала, затем load.
    ev(32); ev_leb(callee_slot); ev(65); ev_sleb(4); ev(106); ev(40); ev(2); ev(0);
    let envl = reserve(); ev(33); ev_leb(envl);
    ev(32); ev_leb(envl);         // env — первый аргумент
    let argc = 0;
    while (tkind() != 21 && tkind() != 0) {
        set(0, 7, base);
        level_or();
        argc = argc + 1;
        if (tkind() == 24) { adv(); }
    }
    expect(21);
    // table index = [closure+0]
    ev(32); ev_leb(callee_slot); ev(40); ev(2); ev(0);
    ev(17); ev_leb(argc + 2); ev(0);    // call_indirect: тип арности argc+1 (env)
    set(0, 5, 1); set(0, 7, base); tp(T_INT()); set(0, 8, -1);
    return 0;
}

// match scrut { case pat: expr, ... }: цепочка IF/ELSE, значение на стеке.
// scrut сохраняется в локаль; каждый паттерн — условие, тело — ветвь THEN.
fn level_match() -> int {
    adv();
    let scrut = reserve();
    level_or(); ev(33); ev_leb(scrut);
    expect(22);                        // {
    let out = reserve();               // результат match
    emit_match_arms(scrut, out);
    expect(23);                        // }
    ev(32); ev_leb(out);
    set(0, 5, 1); tp(T_INT());
    return 0;
}
fn emit_match_arms(scrut, out) -> int {
    while (tkind() != 23 && tkind() != 0) {
        if (tkind() == 24) { adv(); }   // запятая между ветками
        if (tkind() == 97) { adv(); }   // case
        set(0, 7, 0);
        // wildcard `_` или `default`
        if (tkind() == 98) { adv(); expect(26); level_or(); ev(33); ev_leb(out); return 0; }
        if (is_ident_kind(tkind()) && ttext_is(tval(), tlen(), "_", 1) && tkind_at(1) == 26) {
            adv(); expect(26); level_or(); ev(33); ev_leb(out); return 0;
        }
        // паттерн
        let poff = tval(); let plen = tlen();
        let isvar = is_ident_kind(tkind());
        if (isvar) {
            adv();
            if (tkind() == 20) {
                // Конструктор: Tag(sub...)
                emit_ctor_test(poff, plen, scrut);
                ev(4); ev(64);              // if
                emit_bind_fields(scrut);
                expect(26); level_or(); ev(33); ev_leb(out);
                ev(5);                      // else
                emit_match_arms(scrut, out);
                ev(11);                     // end
                return 0;
            }
            if (tkind() == 26) {
                // Связывание: pat: expr
                expect(26);
                ev(32); ev_leb(scrut); ev(33); ev_leb(scrut);
                level_or(); ev(33); ev_leb(out);
                return 0;
            }
        }
        // числовой литерал
        if (tkind() == 1) {
            let v = tval(); adv(); expect(26);
            ev(32); ev_leb(scrut); ev(65); ev_sleb(v); ev(70); ev(4); ev(64);
            level_or(); ev(33); ev_leb(out);
            ev(5); emit_match_arms(scrut, out); ev(11);
            return 0;
        }
        err(); return 0;
    }
    ev(65); ev_sleb(0); ev(33); ev_leb(out);
    return 0;
}
// Условие «scrut это вариант Tag»: возвращает i32-условие на стеке.
fn emit_ctor_test(off, ln, scrut) -> int {
    let tag = variant_tag(off, ln);
    let ar = variant_arity(off, ln);
    if (ar == 0) {
        ev(32); ev_leb(scrut); ev(65); ev_sleb(tag); ev(70);
    } else {
        ev(32); ev_leb(scrut); ev(40); ev(2); ev(0); ev(65); ev_sleb(tag); ev(70);
    }
    return 0;
}
// Связывает под-паттерны конструктора из полей scrut (уже проверен THEN).
fn emit_bind_fields(scrut) -> int {
    // Имена под-паттернов идут сразу за именем конструктора в скобках.
    expect(20);
    let i = 0;
    while (tkind() != 21 && tkind() != 0) {
        if (is_ident_kind(tkind())) {
            let noff = tval(); let nlen = tlen(); adv();
            let slot = get(0, 3);
            add_local(noff, nlen, slot); set_local_tp(slot, T_INT()); store32(LOCCLS() + slot * 4, -1);
            ev(32); ev_leb(scrut); ev(65); ev_sleb(4 + i * 4); ev(106); ev(40); ev(2); ev(0);
            ev(33); ev_leb(slot);
        } else { adv(); }
        i = i + 1;
        if (tkind() == 24) { adv(); }
    }
    expect(21);
    return 0;
}
fn ttext_is(off, ln, s, sn) -> bool { return is_lit(off, ln, s, sn); }

// new Class(args): bump-alloc(CLSZ); вызвать Class_init/_new (this первым).
fn level_new() -> int {
    adv();
    let noff = tval(); let nlen = tlen();
    expect_ident();
    let cls = class_idx_by_name(noff, nlen);
    if (cls < 0) { err(); tp(T_INT()); return 0; }
    let sz = load32(CLSZ() + cls * 4);
    let p = reserve();
    ev(65); ev_sleb(sz); ev(16); ev_leb(ALLOC_FI()); ev(33); ev_leb(p);
    expect(20);
    let ctor = find_method_named(cls, "init", 4);
    if (ctor < 0) { ctor = find_method_named(cls, "new", 3); }
    if (ctor >= 0) {
        ev(32); ev_leb(p);                    // this — первый аргумент
        while (tkind() != 21 && tkind() != 0) {
            set(0, 7, 0);
            level_or();
            if (tkind() == 24) { adv(); }
        }
        ev(16); ev_leb(ctor + 1);
        if (fn_has_result(ctor)) { ev(26); }
    } else {
        while (tkind() != 21 && tkind() != 0) { set(0, 7, 0); level_or(); if (tkind() == 24) { adv(); } }
    }
    expect(21);
    ev(32); ev_leb(p);
    set(0, 5, 1); tp(T_INT()); set(0, 8, cls);
    return 0;
}

// Постфиксные операции: индексация a[i] и поле .length.
fn level_postfix() -> int {
    let base = get(0, 7);
    level_primary();
    while (true) {
        let k = tkind();
        if (k == 80) {
            let ot = load32(TSTK() + base * 4);
            adv(); level_or(); expect(81);
            if (ot == T_STR()) {
                // Индексация строки → байт-символ (str_char_at), не элемент массива.
                ev(16); ev_leb(SCHR_FI());
            } else {
                ev(65); ev_sleb(4); ev(108);   // idx*4
                ev(106);                        // obj + idx*4
                ev(65); ev_sleb(4); ev(106);    // + 4 (после заголовка длины)
                ev(40); ev(2); ev(0);           // i32.load
            }
            set(0, 5, 1);
            set(0, 7, base); tp(T_INT());
        } else {
            if (k == 29) {
                adv();
                let a = tval(); let al = tlen();
                expect_ident();
                if (tkind() == 20) { level_method(a, al); }
                else {
                    if (is_lit(a, al, "length", 6)) { ev(40); ev(2); ev(0); set(0, 5, 1); set(0, 7, base); tp(T_INT()); }
                    else {
                        let cls = get(0, 8);
                        if (cls >= 0) {
                            // Доступ к полю класса: obj + offset → load.
                            let off = field_off(cls, a, al);
                            if (off < 0) { err(); }
                            else {
                                if (off > 0) { ev(65); ev_sleb(off); ev(106); }
                                ev(40); ev(2); ev(0);
                                set(0, 5, 1); set(0, 7, base); tp(T_INT());
                            }
                        } else { err(); }
                    }
                }
            } else { return 0; }
        }
    }
    return 0;
}
// Метод-вызов obj.name(args). Объект уже лежит на стеке (из level_postfix).
// Поддерживаются: push(x), pop(), length().
fn level_method(off, ln) -> int {
    // Метод класса: объект уже на стеке → сохранить как this, затем вызвать.
    let cls = get(0, 8);
    if (cls >= 0 && (tkind_at(0) == 20)) {
        let mi = find_method(cls, off, ln);
        if (mi >= 0) {
            let tl = reserve(); ev(33); ev_leb(tl);
            let base = get(0, 7);
            expect(20);
            ev(32); ev_leb(tl);              // this первым
            while (tkind() != 21 && tkind() != 0) {
                set(0, 7, base);
                level_or();
                if (tkind() == 24) { adv(); }
            }
            expect(21);
            ev(16); ev_leb(mi + 1);
            set(0, 5, 1); set(0, 7, base); tp(load32(FNRET() + mi * 4)); set(0, 8, -1);
            return 0;
        }
    }
    if (is_lit(off, ln, "push", 4)) {
        let al = reserve(); ev(33); ev_leb(al);
        expect(20); level_or(); expect(21);
        let xl = reserve(); ev(33); ev_leb(xl);
        emit_push_seq(al, xl);
        set(0, 5, 1); return 0;
    }
    if (is_lit(off, ln, "pop", 3)) {
        let al = reserve(); ev(33); ev_leb(al);
        expect(20); expect(21);
        emit_pop_seq(al);
        set(0, 5, 1); return 0;
    }
    if (is_lit(off, ln, "length", 6)) {
        expect(20); expect(21);
        ev(40); ev(2); ev(0);
        set(0, 5, 1); return 0;
    }
    if (is_lit(off, ln, "to_str", 6) || is_lit(off, ln, "toString", 8)) {
        expect(20); expect(21);
        ev(16); ev_leb(I32S_FI());
        set(0, 5, 1); return 0;
    }
    if (is_lit(off, ln, "to_int", 6) || is_lit(off, ln, "toInt", 5)) {
        expect(20); expect(21);
        ev(16); ev_leb(S2I_FI());
        set(0, 5, 1); return 0;
    }
    err(); return 0;
}

fn level_unary() -> int { return level_postfix(); }

// Число элементов литерала массива: текущий токен — '['. Сканируем до
// парной ']', считая запятые на глубине 1. `[]` -> 0, `[x]` -> 1.
fn count_elems() -> int {
    let j = get(0, 0) + 1;
    let depth = 1; let c = 0; let any = 0;
    while (depth > 0) {
        let k = load32(KIND() + j * 4);
        if (k == 0) { return c; }
        if (k == 80) { depth = depth + 1; }
        else {
            if (k == 81) { depth = depth - 1; }
            else {
                if (depth == 1) {
                    if (k == 24) { c = c + 1; }
                    else { any = 1; }
                }
            }
        }
        j = j + 1;
    }
    if (any == 0) { return 0; }
    return c + 1;
}

// Литерал массива [e0, e1, ...] -> [len u32][e0][e1]... в линейной памяти.
fn level_array() -> int {
    let base = get(0, 7);
    adv();
    let cnt = count_elems();
    let size = 4 + cnt * 4;
    let t = reserve();
    ev(65); ev_sleb(size);
    ev(16); ev_leb(ALLOC_FI());
    ev(33); ev_leb(t);
    ev(32); ev_leb(t); ev(65); ev_sleb(cnt); ev(54); ev(2); ev(0);
    let i = 0;
    set(0, 7, base + 1);
    while (tkind() != 81 && tkind() != 0) {
        set(0, 7, base + 1);
        ev(32); ev_leb(t); ev(65); ev_sleb(4 + i * 4); ev(106);
        level_or();
        ev(54); ev(2); ev(0);
        i = i + 1;
        if (tkind() == 24) { adv(); }
    }
    expect(81);
    ev(32); ev_leb(t);
    set(0, 5, 1);
    set(0, 7, base); tp(T_INT());
    return 0;
}

fn parse_assign() -> int {
    let noff = tval(); let nlen = tlen();
    adv(); adv();
    level_or();
    let vt = tpop();
    let li = find_local(noff, nlen);
    if (li < 0) { err(); } else { ev(33); ev_leb(li); ev(32); ev_leb(li); set_local_tp(li, vt); }
    set(0, 5, 1);
    tp(vt);
    return 0;
}

fn level_or() -> int {
    if (is_ident_kind(tkind()) && tkind_at(1) == 27) { return parse_assign(); }
    if (is_index_assign()) { return parse_index_assign(); }
    let base = get(0, 7);
    level_and();
    while (tkind() == 47) {
        adv();
        ev(4); ev(127); ev(65); ev_sleb(1); ev(5);
        level_and();
        ev(69); ev(69);
        ev(11);
        set(0, 7, base); tp(T_INT());
    }
    return 0;
}

// Проверка «ident [ ... ]* = ...». Возвращает true только если после
// цепочки индексов идёт '='; иначе это обычное rvalue-выражение.
fn is_index_assign() -> bool {
    if (!is_ident_kind(tkind())) { return false; }
    let j = get(0, 0) + 1;
    let groups = 0;
    while (load32(KIND() + j * 4) == 80) {
        let depth = 0;
        let done = 0;
        while (done == 0) {
            let k = load32(KIND() + j * 4);
            if (k == 0) { return false; }
            if (k == 80) { depth = depth + 1; }
            else {
                if (k == 81) { depth = depth - 1; if (depth == 0) { j = j + 1; done = 1; } }
            }
            if (done == 0) { j = j + 1; }
        }
        groups = groups + 1;
    }
    if (groups == 0) { return false; }
    return load32(KIND() + j * 4) == 27;
}

// Присваивание в элемент a[i] = v (в т.ч. цепочка a[i][j] = v).
// Для промежуточных уровней загружаем указатель, на последнем — store.
fn parse_index_assign() -> int {
    let noff = tval(); let nlen = tlen();
    adv();
    let base = find_local(noff, nlen);
    if (base < 0) { err(); return 0; }
    let cur = reserve();
    ev(32); ev_leb(base); ev(33); ev_leb(cur);
    while (tkind() == 80) {
        adv(); level_or(); expect(81);
        let idx = reserve(); ev(33); ev_leb(idx);
        if (tkind() == 80) {
            ev(32); ev_leb(cur);
            ev(32); ev_leb(idx); ev(65); ev_sleb(4); ev(108); ev(106);
            ev(65); ev_sleb(4); ev(106);
            ev(40); ev(2); ev(0);
            ev(33); ev_leb(cur);
        } else {
            expect(27);
            level_or();
            let val = reserve(); ev(33); ev_leb(val);
            ev(32); ev_leb(cur);
            ev(32); ev_leb(idx); ev(65); ev_sleb(4); ev(108); ev(106);
            ev(65); ev_sleb(4); ev(106);
            ev(32); ev_leb(val);
            ev(54); ev(2); ev(0);
            ev(32); ev_leb(val);
            set(0, 5, 1);
            tp(T_INT());
        }
    }
    return 0;
}
fn level_and() -> int {
    let base = get(0, 7);
    level_eq();
    while (tkind() == 46) {
        adv();
        ev(4); ev(127);
        level_eq();
        ev(69); ev(69);
        ev(5); ev(65); ev_sleb(0);
        ev(11);
        set(0, 7, base); tp(T_INT());
    }
    return 0;
}
// Каждый уровень фиксирует base стека типов до левого операнда; типы операндов
// лежат по base и base+1, результат — по base. Устойчиво к несбалансировке.
fn level_eq() -> int {
    let base = get(0, 7);
    level_cmp();
    while (tkind() == 40 || tkind() == 41) {
        let k = tkind(); adv();
        let lt = load32(TSTK() + base * 4);
        level_cmp();
        let rt = load32(TSTK() + (base + 1) * 4);
        if (lt == T_STR() || rt == T_STR()) {
            // Сравнение строк по содержимому (str_eq), как в oracle.
            ev(16); ev_leb(SEQ_FI());
            if (k == 41) { ev(69); }
        } else {
            if (k == 40) { ev(70); } else { ev(71); }
        }
        set(0, 7, base); tp(T_INT());
    }
    return 0;
}
fn level_cmp() -> int {
    let base = get(0, 7);
    level_bit();
    while (tkind() == 42 || tkind() == 43 || tkind() == 44 || tkind() == 45) {
        let k = tkind(); adv();
        level_bit();
        if (k == 42) { ev(72); } else { if (k == 43) { ev(74); } else { if (k == 44) { ev(76); } else { ev(78); } } }
        set(0, 7, base); tp(T_INT());
    }
    return 0;
}
fn level_bit() -> int {
    let base = get(0, 7);
    level_shift();
    while (tkind() == 48 || tkind() == 49 || tkind() == 50) {
        let k = tkind(); adv();
        level_shift();
        if (k == 48) { ev(113); } else { if (k == 49) { ev(114); } else { ev(115); } }
        set(0, 7, base); tp(T_INT());
    }
    return 0;
}
fn level_shift() -> int {
    let base = get(0, 7);
    level_add();
    while (tkind() == 51 || tkind() == 52) {
        let k = tkind(); adv();
        level_add();
        if (k == 51) { ev(116); } else { ev(117); }
        set(0, 7, base); tp(T_INT());
    }
    return 0;
}
fn level_add() -> int {
    let base = get(0, 7);
    level_mul();
    while (tkind() == 30 || tkind() == 31) {
        let k = tkind(); adv();
        let lt = load32(TSTK() + base * 4);
        level_mul();
        let rt = load32(TSTK() + (base + 1) * 4);
        if (k == 30 && (lt == T_STR() || rt == T_STR())) {
            // Конкатенация строк: "+" над строками — не арифметика.
            // Не-строковый операнд коэрцится в строку (i32_to_str), как oracle.
            let rl = reserve(); ev(33); ev_leb(rl);
            let ll = reserve(); ev(33); ev_leb(ll);
            ev(32); ev_leb(ll); if (lt != T_STR()) { ev(16); ev_leb(I32S_FI()); }
            ev(32); ev_leb(rl); if (rt != T_STR()) { ev(16); ev_leb(I32S_FI()); }
            ev(16); ev_leb(SCAT_FI());
            set(0, 7, base); tp(T_STR());
        } else {
            if (k == 30) { ev(106); } else { ev(107); }
            set(0, 7, base); tp(T_INT());
        }
    }
    return 0;
}
fn level_mul() -> int {
    let base = get(0, 7);
    level_unary();
    while (tkind() == 32 || tkind() == 33 || tkind() == 34) {
        let k = tkind(); adv();
        level_unary();
        if (k == 32) { ev(108); } else { if (k == 33) { ev(109); } else { ev(111); } }
        set(0, 7, base); tp(T_INT());
    }
    return 0;
}
