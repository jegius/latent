// СГЕНЕРИРОВАНО selfhost/build.mjs из selfhost/src/*.lat — не редактировать вручную.
// Пересобрать: node selfhost/build.mjs

// ===== часть: 00_abi.lat =====
// --- фиксированные адреса областей ---
// Входной исходник вынесен в отдельную высокую область (128K): он растёт
// вместе с компилятором, и раньше при исходнике >32K хвост залезал на OUTB,
// который binit() занулял при старте — это молча портило последние токены.
fn INPUT() -> int { return 3145728; }    // 128K (выше всех рабочих областей)
fn OUTB() -> int { return 65536; }       // 192K готовый wasm
fn SCRB() -> int { return 262144; }      // 192K скретч секции
fn FNB() -> int { return 458752; }       // 192K тело текущей функции
fn BODYC() -> int { return 655360; }     // 192K финальное тело
fn CODEB() -> int { return 851968; }     // 384K все тела
fn KIND() -> int { return 1245184; }     // 256K
fn TVAL() -> int { return 1507328; }     // 256K
fn TLEN() -> int { return 1769472; }     // 256K
fn FNOFF() -> int { return 2031616; }    // 32K
fn FNLEN() -> int { return 2064384; }    // 32K
fn FNNP() -> int { return 2097152; }     // 32K
fn FNTOK() -> int { return 2129920; }    // 32K
fn LOCOFF() -> int { return 2162688; }   // 32K
fn LOCLEN() -> int { return 2195456; }   // 32K
fn LOCIDX() -> int { return 2228224; }   // 32K
fn ST() -> int { return 2260992; }       // 256
fn CODEOF() -> int { return 2261248; }   // 32K
fn CODELN() -> int { return 2293760; }   // 32K
fn DATAB() -> int { return 2326528; }    // 256K
fn STRO() -> int { return 2588672; }     // 128K
fn STRL() -> int { return 2719744; }     // 128K
fn STRA() -> int { return 2850816; }     // 128K
fn LOTP() -> int { return 2981888; }     // 32K  тип локальной (0=int 1=float 2=str)
fn TSTK() -> int { return 3014656; }     // 32K  стек типов выражений
fn FNRET() -> int { return 3047424; }    // 32K  тип результата функции
fn FPT() -> int { return 3080192; }      // 32K  типы параметров функций (stride 8)
fn FLOATB() -> int { return 3112960; }   // 32K  f64-константы (8 байт/слот)
// --- таблицы классов (для new / полей / методов) ---
// Размещены выше области INPUT (3145728..3276800); память наращивается
// driver-ом через alloc(4100000) до использования.
fn CLNO() -> int { return 3407872; }     // 16K  имя класса: оффсет в исходник
fn CLNL() -> int { return 3424256; }     // 16K  имя класса: длина
fn CLNF() -> int { return 3440640; }     // 4K   число полей класса
fn CLNM() -> int { return 3444736; }     // 4K   число методов класса
fn CLSZ() -> int { return 3448832; }     // 4K   размер класса в байтах
fn NCLA() -> int { return 3452928; }     // 4K   число классов (слот-указатель)
fn FLDO() -> int { return 3457024; }     // 32K  поле: оффсет имени
fn FLDL() -> int { return 3489792; }     // 32K  поле: длина имени
fn FLDOC() -> int { return 3522560; }    // 32K  поле: смещение в объекте
fn FLDCL() -> int { return 3555328; }    // 32K  поле: индекс класса
fn LOCCLS() -> int { return 3588096; }   // 32K  класс локальной (-1 если нет)
fn FNCLS() -> int { return 3620864; }    // 32K  класс-владелец функции (-1 если нет)
// Таблица методов: каждый метод = функция с неявным первым параметром `this`.
fn METHTOK() -> int { return 3653632; }  // 32K  токен `fn` метода
fn METHCLS() -> int { return 3686400; }  // 32K  класс метода
fn METHFI() -> int { return 3719168; }   // 32K  индекс функции метода
fn NMETH() -> int { return 3751936; }    // 4K   число методов (слот-указатель)
fn CLFFI() -> int { return 3756032; }    // 4K   первый индекс полей класса
fn NCLS() -> int { return 3760128; }     // 4K   число классов (счётчик)
fn NFCLS() -> int { return 3764224; }    // 4K   число полей (счётчик)
fn NFNCL() -> int { return 3768320; }    // 4K   число методов (счётчик)
fn CURFI() -> int { return 3772416; }    // 16   индекс текущей компилируемой функции
fn LASTCLS() -> int { return 3776512; }   // 16   класс последнего первичного выражения
// --- таблицы enum-вариантов ---
fn VNO() -> int { return 3780608; }      // 16K  вариант: оффсет имени
fn VNL() -> int { return 3796992; }      // 16K  вариант: длина имени
fn VTAG() -> int { return 3813376; }     // 4K   вариант: тег
fn VARY() -> int { return 3817472; }     // 4K   вариант: арность
fn NVAR() -> int { return 3821568; }     // 4K   число вариантов
// --- таблицы лямбд (замыканий) ---
// Раскладка: 32K-массивы индексируются номером лямбды (<~2048 штук), 4K-
// массивы — под мелкие счётчики. Всё выровнено по 32K на границах блоков.
fn LAMTOK() -> int { return 3932160; }   // 32K  токен `fn` лямбды
fn LAMNP() -> int { return 3964928; }    // 32K  число параметров лямбды
fn LAMS0() -> int { return 3997696; }    // 32K  первый индекс захвата лямбды
fn LAMNC() -> int { return 4030464; }    // 32K  число захватов лямбды
fn LAMBODY() -> int { return 4063232; }  // 32K  токен начала тела лямбды
fn LAMBEND() -> int { return 4096000; }  // 32K  токен конца тела (исключая)
fn CAPO() -> int { return 4128768; }     // 32K  захват: оффсет имени
fn CAPL() -> int { return 4161536; }     // 32K  захват: длина имени
fn LPOFF() -> int { return 4194304; }    // 32K  параметр лямбды: оффсет имени
fn LPLEN() -> int { return 4227072; }    // 32K  параметр лямбды: длина имени
fn LAMFN() -> int { return 4259840; }    // 32K  индекс функции лямбды
fn NLAM() -> int { return 4292608; }     // 4K   число лямбд
fn NCAP() -> int { return 4296704; }     // 4K   всего записей захватов
fn LAMBLK() -> int { return 4300800; }   // 4K   тело лямбды — блок (1) или выражение (0)
fn NPNL() -> int { return 4304896; }     // 4K   всего параметров лямбд
fn NBASE() -> int { return 4308992; }    // 4K   индекс первой функции лямбды
// --- таблицы тайп-чекера ---
fn TV_OFF() -> int { return 4313088; }   // 32K  переменная: оффсет имени
fn TV_LEN() -> int { return 4345856; }   // 32K  переменная: длина имени
fn TV_TY() -> int { return 4378624; }    // 32K  переменная: тег типа
fn TV_AUX() -> int { return 4411392; }   // 32K  переменная: вспом. (тип результата fn)
fn TV_NP() -> int { return 4444160; }    // 32K  переменная: число параметров (fn)
fn TV_NEST() -> int { return 4476928; }  // 32K  переменная: глубина области видимости
fn FRETTY() -> int { return 4509696; }   // 32K  тип результата функции
fn TCCUR() -> int { return 4542464; }    // 16   текущий индекс функции в тайп-чеке
fn ERRB() -> int { return 4547072; }     // 4K   буфер сообщения об ошибке
// --- float: WASM-опкоды вынесены как функции для читаемости эмиттера ---
fn F64_ADD_OP() -> int { return 160; }
fn F64_SUB_OP() -> int { return 161; }
fn F64_MUL_OP() -> int { return 162; }
fn F64_DIV_OP() -> int { return 163; }
fn F64_EQ_OP() -> int { return 97; }
fn F64_NE_OP() -> int { return 98; }
fn F64_LT_OP() -> int { return 99; }
fn F64_GT_OP() -> int { return 100; }
fn F64_LE_OP() -> int { return 101; }
fn F64_GE_OP() -> int { return 102; }
fn F64_CONST_OP() -> int { return 68; }
fn F64_CONV_I32_OP() -> int { return 183; }   // f64.convert_i32_s
fn I32_TRUNC_F64_OP() -> int { return 170; }  // i32.trunc_f64_s

// Слоты состояния: 0=PC 1=NT 2=NF 3=NL 4=status 5=produces 6=NS(strings) 7=TS
fn get(st, k) -> int { return load32(ST() + st * 4 + k * 4); }
fn set(st, k, v) -> int { store32(ST() + st * 4 + k * 4, v); return v; }

// Типы значений выражений (для выбора опкодов и строковых операций).
fn T_INT() -> int { return 0; }
fn T_FLT() -> int { return 1; }
fn T_STR() -> int { return 2; }

// Стек типов: эмиссия выражений идёт снизу вверх, поэтому тип операнда
// доступен сразу после его эмиссии — это зеркало стека значений WASM.
fn tp(t) -> int { let p = get(0, 7); store32(TSTK() + p * 4, t); set(0, 7, p + 1); return t; }
// Толерантный pop: пустой стек типов считаем int (не критично для опкодов).
fn tpop() -> int { let p = get(0, 7); if (p <= 0) { return T_INT(); } set(0, 7, p - 1); return load32(TSTK() + (p - 1) * 4); }
fn ttop() -> int { let p = get(0, 7); if (p <= 0) { return T_INT(); } return load32(TSTK() + (p - 1) * 4); }

// ===== часть: 10_buffer.lat =====
// --- байтовые буферы [len u32][bytes] ---
fn binit(b) -> int { store32(b, 0); return b; }
fn bput(b, x) -> int { store8(b + 4 + load32(b), x & 255); store32(b, load32(b) + 1); return b; }
fn bleb(b, value) -> int {
    let v = value;
    while (true) {
        let byte = v & 127;
        v = v >> 7;
        if (v != 0) { byte = byte | 128; }
        bput(b, byte);
        if (v == 0) { return b; }
    }
    return b;
}
// Signed LEB128 (для немедленных i32.const).
fn bsleb(b, value) -> int {
    let v = value;
    while (true) {
        let byte = v & 127;
        v = v >> 7;
        let done = 0;
        if (v == 0 && (byte & 64) == 0) { done = 1; }
        if (v == -1 && (byte & 64) != 0) { done = 1; }
        if (done == 0) { byte = byte | 128; }
        bput(b, byte);
        if (done == 1) { return b; }
    }
    return b;
}
fn bcopy(b, s, off, n) -> int { memcopy(b + 4 + load32(b), s + 4 + off, n); store32(b, load32(b) + n); return b; }
fn blen(b) -> int { return load32(b); }

// ===== часть: 20_lexer.lat =====
// ============================ ЛЕКСЕР ============================
fn is_digit(c) -> bool { return c >= 48 && c <= 57; }
fn is_alpha(c) -> bool { return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95; }
fn is_alnum(c) -> bool { return is_alpha(c) || is_digit(c); }
fn is_space(c) -> bool { return c == 32 || c == 9 || c == 10 || c == 13; }
fn sc(src, i) -> int { return load8(src + 4 + i); }

fn match_at(src, base, off, lit, n) -> bool {
    let i = 0;
    while (i < n) {
        if (load8(src + base + off + i) != load8(lit + 4 + i)) { return false; }
        i = i + 1;
    }
    return true;
}

fn kw_code(src, off, n) -> int {
    if (n == 2) {
        if (match_at(src, 4, off, "if", 2)) { return 12; }
        if (match_at(src, 4, off, "fn", 2)) { return 11; }
        if (match_at(src, 4, off, "in", 2)) { return 17; }
    }
    if (n == 3) {
        if (match_at(src, 4, off, "let", 3)) { return 10; }
        if (match_at(src, 4, off, "for", 3)) { return 16; }
        if (match_at(src, 4, off, "new", 3)) { return 93; }
    }
    if (n == 4) {
        if (match_at(src, 4, off, "else", 4)) { return 13; }
        if (match_at(src, 4, off, "true", 4)) { return 90; }
        if (match_at(src, 4, off, "this", 4)) { return 94; }
        if (match_at(src, 4, off, "case", 4)) { return 97; }
        if (match_at(src, 4, off, "test", 4)) { return 105; }
        if (match_at(src, 4, off, "null", 4)) { return 107; }
    }
    if (n == 5) {
        if (match_at(src, 4, off, "while", 5)) { return 14; }
        if (match_at(src, 4, off, "false", 5)) { return 91; }
        if (match_at(src, 4, off, "class", 5)) { return 92; }
        if (match_at(src, 4, off, "match", 5)) { return 95; }
        if (match_at(src, 4, off, "spawn", 5)) { return 100; }
        if (match_at(src, 4, off, "yield", 5)) { return 101; }
        if (match_at(src, 4, off, "async", 5)) { return 102; }
        if (match_at(src, 4, off, "await", 5)) { return 103; }
    }
    if (n == 4) { if (match_at(src, 4, off, "enum", 4)) { return 96; } }
    if (n == 6) {
        if (match_at(src, 4, off, "return", 6)) { return 15; }
        if (match_at(src, 4, off, "select", 6)) { return 104; }
    }
    if (n == 7) { if (match_at(src, 4, off, "default", 7)) { return 98; } }
    return 0;
}

fn punct_kind(c, d) -> int {
    if (c == 40) { return 20; }
    if (c == 41) { return 21; }
    if (c == 123) { return 22; }
    if (c == 125) { return 23; }
    if (c == 44) { return 24; }
    if (c == 59) { return 25; }
    if (c == 58) { return 26; }
    if (c == 91) { return 80; }
    if (c == 93) { return 81; }
    if (c == 46) { return 29; }
    if (c == 43) { return 30; }
    if (c == 42) { return 32; }
    if (c == 37) { return 34; }
    if (c == 45 && d == 62) { return 28; }
    if (c == 45) { return 31; }
    if (c == 47) { return 33; }
    if (c == 61 && d == 61) { return 40; }
    if (c == 61 && d == 62) { return 99; }
    if (c == 61) { return 27; }
    if (c == 33 && d == 61) { return 41; }
    if (c == 33) { return 53; }
    if (c == 60 && d == 61) { return 44; }
    if (c == 60 && d == 60) { return 51; }
    if (c == 60 && d == 45) { return 106; }   // <- (канал)
    if (c == 60) { return 42; }
    if (c == 62 && d == 61) { return 45; }
    if (c == 62 && d == 62) { return 52; }
    if (c == 62) { return 43; }
    if (c == 38 && d == 38) { return 46; }
    if (c == 38) { return 48; }
    if (c == 124 && d == 124) { return 47; }
    if (c == 124) { return 49; }
    if (c == 94) { return 50; }
    return 0;
}
fn punct_len(k) -> int {
    if (k == 28 || k == 40 || k == 41 || k == 44 || k == 45 || k == 46 || k == 47 || k == 51 || k == 52 || k == 99 || k == 106) { return 2; }
    return 1;
}

fn tokenize() -> int {
    let src = INPUT();
    let L = load32(src);
    let i = 0; let n = 0;
    while (i < L) {
        let c = sc(src, i);
        if (is_space(c)) { i = i + 1; }
        else {
            if (is_digit(c)) {
                let s = i;
                while (i < L && is_digit(sc(src, i))) { i = i + 1; }
                // Дробная часть `NNN.NNN`.
                let has_dot = 0;
                if (i + 1 < L && sc(src, i) == 46 && is_digit(sc(src, i + 1))) {
                    has_dot = 1;
                    i = i + 1;
                    while (i < L && is_digit(sc(src, i))) { i = i + 1; }
                }
                // Экспонента `1e10`, `1.5e-3`, `2E+2`.
                let has_exp = 0;
                if (i < L && (sc(src, i) == 101 || sc(src, i) == 69)) {
                    let j = i + 1;
                    if (j < L && (sc(src, j) == 43 || sc(src, j) == 45)) { j = j + 1; }
                    if (j < L && is_digit(sc(src, j))) {
                        has_exp = 1;
                        i = j;
                        while (i < L && is_digit(sc(src, i))) { i = i + 1; }
                    }
                }
                if (has_dot == 1 || has_exp == 1) {
                    // Токен-литерал float (4): оффсет/длину разберёт эмиттер.
                    store32(KIND() + n * 4, 4); store32(TVAL() + n * 4, s); store32(TLEN() + n * 4, i - s); n = n + 1;
                } else {
                    let v = 0; let q = s;
                    while (q < i) { v = v * 10 + (sc(src, q) - 48); q = q + 1; }
                    store32(KIND() + n * 4, 1); store32(TVAL() + n * 4, v); store32(TLEN() + n * 4, 0); n = n + 1;
                }
            } else {
                if (is_alpha(c)) {
                    let s = i;
                    while (i < L && is_alnum(sc(src, i))) { i = i + 1; }
                    let wl = i - s;
                    let k = kw_code(src, s, wl);
                    if (k != 0) { store32(KIND() + n * 4, k); store32(TVAL() + n * 4, 0); }
                    else { store32(KIND() + n * 4, 2); store32(TVAL() + n * 4, s); }
                    store32(TLEN() + n * 4, wl); n = n + 1;
                } else {
                    if (c == 34) {
                        let s = i; i = i + 1;
                        // Кавычка внутри литерала может быть экранирована.
                        while (i < L && sc(src, i) != 34) {
                            if (sc(src, i) == 92 && i + 1 < L) { i = i + 2; } else { i = i + 1; }
                        }
                        if (i < L) { i = i + 1; }
                        store32(KIND() + n * 4, 3); store32(TVAL() + n * 4, s); store32(TLEN() + n * 4, i - s); n = n + 1;
                    } else {
                        if (c == 47 && i + 1 < L && sc(src, i + 1) == 47) {
                            while (i < L && sc(src, i) != 10) { i = i + 1; }
                        } else {
                            if (c == 47 && i + 1 < L && sc(src, i + 1) == 42) {
                                // Блочный комментарий с вложенностью (как oracle).
                                let cd = 1;
                                i = i + 2;
                                while (i + 1 < L && cd > 0) {
                                    if (sc(src, i) == 47 && sc(src, i + 1) == 42) { cd = cd + 1; i = i + 2; }
                                    else {
                                        if (sc(src, i) == 42 && sc(src, i + 1) == 47) { cd = cd - 1; i = i + 2; }
                                        else { i = i + 1; }
                                    }
                                }
                                if (cd > 0) { i = L; }
                            } else {
                            let two = 0;
                            if (i + 1 < L) { two = sc(src, i + 1); }
                            let k = punct_kind(c, two);
                            if (k != 0) {
                                store32(KIND() + n * 4, k); store32(TVAL() + n * 4, 0); store32(TLEN() + n * 4, 0);
                                n = n + 1; i = i + punct_len(k);
                            } else { i = i + 1; }
                            }
                        }
                    }
                }
            }
        }
    }
    store32(KIND() + n * 4, 0); store32(TVAL() + n * 4, 0); store32(TLEN() + n * 4, 0);
    return n + 1;
}

// ===== часть: 30_syntax.lat =====
// ============================ ПАРСЕР ============================
fn tok_kind() -> int { return load32(KIND() + get(0, 0) * 4); }
fn tok_kind_at(off) -> int { return load32(KIND() + (get(0, 0) + off) * 4); }
fn tok_val() -> int { return load32(TVAL() + get(0, 0) * 4); }
fn tok_len() -> int { return load32(TLEN() + get(0, 0) * 4); }
fn next_token() -> int { return set(0, 0, get(0, 0) + 1); }
fn err() -> int { return set(0, 4, 1); }
fn is_ident_kind(k) -> bool { return k == 2 || (k >= 10 && k <= 19); }

fn expect(k) -> int { if (tok_kind() == k) { return next_token(); } err(); return 0; }
fn expect_ident() -> int {
    let k = tok_kind();
    if (k == 2 || (k >= 10 && k <= 19)) { return next_token(); }
    err(); return 0;
}

fn name_eq(aoff, alen, boff, blen) -> bool {
    if (alen != blen) { return false; }
    let i = 0;
    while (i < alen) {
        if (load8(INPUT() + 4 + aoff + i) != load8(INPUT() + 4 + boff + i)) { return false; }
        i = i + 1;
    }
    return true;
}
fn is_lit(off, ln, s, sn) -> bool {
    if (ln != sn) { return false; }
    let i = 0;
    while (i < ln) {
        if (load8(INPUT() + 4 + off + i) != load8(s + 4 + i)) { return false; }
        i = i + 1;
    }
    return true;
}

// Поиск локальной переменной. Идём с конца таблицы: последнее объявление
// с этим именем затеняет предыдущие. add_local всегда выделяет свежий слот,
// поэтому поиск «первого совпадения» рассинхронизировал бы запись (новый слот)
// и чтение (старый слот) при повторном `let` одного имени — так ломался
// tokenize при самокомпиляции.
fn find_local(off, ln) -> int {
    let i = get(0, 3) - 1;
    while (i >= 0) {
        if (name_eq(off, ln, load32(LOCOFF() + i * 4), load32(LOCLEN() + i * 4))) { return load32(LOCIDX() + i * 4); }
        i = i - 1;
    }
    return -1;
}
fn add_local(off, ln, idx) -> int {
    let nl = get(0, 3);
    store32(LOCOFF() + nl * 4, off); store32(LOCLEN() + nl * 4, ln); store32(LOCIDX() + nl * 4, idx);
    set(0, 3, nl + 1);
    return idx;
}
// Тип локальной по её слоту (все слоты объявляются i32; типы — для выбора
// строковых/числовых опкодов, как int/str в статически типизированном oracle).
fn local_tp(idx) -> int { return load32(LOTP() + idx * 4); }
fn set_local_tp(idx, t) -> int { store32(LOTP() + idx * 4, t); return t; }
// Свежий безымянный слот (временные для индексации/массивов/for-in).
// Тип всегда i32 — финальное тело объявляет nlocals i32-локалей.
fn reserve() -> int { let idx = get(0, 3); set(0, 3, idx + 1); set_local_tp(idx, T_INT()); return idx; }
// Резерв f64-типизированного временного слота (для смешанной float-арифметики).
fn reserve_flt() -> int { let idx = get(0, 3); set(0, 3, idx + 1); set_local_tp(idx, T_FLT()); return idx; }
fn find_func(off, ln) -> int {
    let i = 0; let nf = get(0, 2);
    while (i < nf) {
        // Методы (класс-владелец >= 0) не видны как свободные функции.
        if (load32(FNCLS() + i * 4) < 0
            && name_eq(off, ln, load32(FNOFF() + i * 4), load32(FNLEN() + i * 4))) { return i; }
        i = i + 1;
    }
    return -1;
}

// --- строковые литералы: таблица + data-секция ---
fn find_str(off, ln) -> int {
    let i = 0; let ns = get(0, 6);
    while (i < ns) {
        if (load32(STRL() + i * 4) == ln) {
            let so = load32(STRO() + i * 4);
            let j = 0; let same = 1;
            while (j < ln) {
                if (load8(INPUT() + 4 + off + j) != load8(INPUT() + 4 + so + j)) { same = 0; j = ln; } else { j = j + 1; }
            }
            if (same == 1) { return load32(STRA() + i * 4); }
        }
        i = i + 1;
    }
    return -1;
}
fn add_str(off, ln) -> int {
    let addr = 1024 + load32(DATAB());
    store32(STRO() + get(0, 6) * 4, off);
    store32(STRL() + get(0, 6) * 4, ln);
    store32(STRA() + get(0, 6) * 4, addr);
    set(0, 6, get(0, 6) + 1);
    // Blob: [len u32 LE][bytes]. Escape-последовательности (\n \t \\ \")
    // разворачиваются, как в oracle; длина считается уже по байтам результата.
    let u = 0; let i = 0;
    while (i < ln) {
        if (load8(INPUT() + 4 + off + i) == 92 && i + 1 < ln) { u = u + 1; i = i + 2; }
        else { u = u + 1; i = i + 1; }
    }
    bput(DATAB(), u & 255); bput(DATAB(), (u >> 8) & 255); bput(DATAB(), (u >> 16) & 255); bput(DATAB(), (u >> 24) & 255);
    i = 0;
    while (i < ln) {
        let c = load8(INPUT() + 4 + off + i);
        if (c == 92 && i + 1 < ln) {
            let e = load8(INPUT() + 4 + off + i + 1);
            if (e == 110) { bput(DATAB(), 10); }
            else { if (e == 116) { bput(DATAB(), 9); } else { bput(DATAB(), e); } }
            i = i + 2;
        } else { bput(DATAB(), c); i = i + 1; }
    }
    return addr;
}
fn str_addr(off, ln) -> int {
    let a = find_str(off, ln);
    if (a >= 0) { return a; }
    return add_str(off, ln);
}

// ===== часть: 35_class.lat =====
// ============================ КЛАССЫ ============================
// Первый проход: регистрация классов, их полей (имя, смещение) и методов
// (токен `fn`, класс-владелец). Layout — как в oracle: поля по 4 байта
// подряд (int/bool/string/указатель); float вне подмножества.

fn get_nvar() -> int { return load32(NVAR()); }
fn set_nvar(v) -> int { store32(NVAR(), v); return v; }

// Регистрация enum-вариантов: `enum Name { V, W(T), ... }`. Тег — порядковый
// номер варианта; арность — число полей в скобках. Индексация глобальная.
fn scan_enums() -> int {
    // Индексы 0..3 зарезервированы под встроенные Ok/Err/Some/None
    // (variant_tag/arity отвечают за них константами); пользовательские
    // варианты начинаются с 4.
    let i = 0; let total = get(0, 1); let nvar = 4;
    while (i < total) {
        if (load32(KIND() + i * 4) == 96) {
            let j = i + 3;                    // после `enum` IDENT `{`
            while (j < total && load32(KIND() + j * 4) != 23 && load32(KIND() + j * 4) != 0) {
                if (is_ident_kind(load32(KIND() + j * 4))) {
                    store32(VNO() + nvar * 4, load32(TVAL() + j * 4));
                    store32(VNL() + nvar * 4, load32(TLEN() + j * 4));
                    let ar = 0;
                    j = j + 1;
                    if (load32(KIND() + j * 4) == 20) {
                        let d = 1; j = j + 1;
                        while (d > 0 && j < total) {
                            let k = load32(KIND() + j * 4);
                            if (k == 20) { d = d + 1; }
                            else { if (k == 21) { d = d - 1; if (d == 0) { j = j + 1; } } }
                            if (d > 0) { ar = ar + 1; j = j + 1; }
                        }
                    }
                    store32(VARY() + nvar * 4, ar);
                    nvar = nvar + 1;
                } else { j = j + 1; }
                if (load32(KIND() + j * 4) == 24) { j = j + 1; }
            }
            i = j + 1;
        } else { i = i + 1; }
    }
    set_nvar(nvar);
    return nvar;
}
// Тег варианта по имени (-1 если нет). Первые 4 записи — Ok/Err/Some/None.
fn variant_tag(off, ln) -> int {
    if (is_lit(off, ln, "Ok", 2)) { return 0; }
    if (is_lit(off, ln, "Err", 3)) { return 1; }
    if (is_lit(off, ln, "Some", 4)) { return 2; }
    if (is_lit(off, ln, "None", 4)) { return 3; }
    let i = 4; let n = get_nvar();
    while (i < n) {
        if (name_eq(off, ln, load32(VNO() + i * 4), load32(VNL() + i * 4))) { return i; }
        i = i + 1;
    }
    return -1;
}
fn variant_arity(off, ln) -> int {
    if (is_lit(off, ln, "Ok", 2) || is_lit(off, ln, "Err", 3) || is_lit(off, ln, "Some", 4)) { return 1; }
    if (is_lit(off, ln, "None", 4)) { return 0; }
    let i = 4; let n = get_nvar();
    while (i < n) {
        if (name_eq(off, ln, load32(VNO() + i * 4), load32(VNL() + i * 4))) { return load32(VARY() + i * 4); }
        i = i + 1;
    }
    return -1;
}

fn get_ncls() -> int { return load32(NCLS()); }
fn set_ncls(v) -> int { store32(NCLS(), v); return v; }
fn get_nfcls() -> int { return load32(NFCLS()); }
fn set_nfcls(v) -> int { store32(NFCLS(), v); return v; }
fn get_nmeth() -> int { return load32(NFNCL()); }
fn set_nmeth(v) -> int { store32(NFNCL(), v); return v; }

// Пропускает метод от токена `fn` до токена ПОСЛЕ закрывающей `}` тела.
fn skip_fn_body(j, total) -> int {
    let k = j;
    while (k < total && load32(KIND() + k * 4) != 22) { k = k + 1; }
    let depth = 0;
    while (k < total) {
        let t = load32(KIND() + k * 4);
        if (t == 22) { depth = depth + 1; }
        else {
            if (t == 23) { depth = depth - 1; if (depth == 0) { return k + 1; } }
        }
        k = k + 1;
    }
    return k;
}

// Индекс класса по имени (-1 если нет).
fn class_idx_by_name(off, ln) -> int {
    let i = 0; let n = get_ncls();
    while (i < n) {
        if (name_eq(off, ln, load32(CLNO() + i * 4), load32(CLNL() + i * 4))) { return i; }
        i = i + 1;
    }
    return -1;
}

fn scan_classes() -> int {
    let i = 0; let total = get(0, 1);
    let ncls = 0;
    while (i < total) {
        if (load32(KIND() + i * 4) == 92) {
            let no = load32(TVAL() + (i + 1) * 4); let nl = load32(TLEN() + (i + 1) * 4);
            store32(CLNO() + ncls * 4, no); store32(CLNL() + ncls * 4, nl);
            store32(CLFFI() + ncls * 4, get_nfcls());
            let nfld = 0; let nsz = 0;
            let j = i + 3;                       // после `class` IDENT `{`
            let depth = 1;
            while (j < total && depth > 0) {
                let k = load32(KIND() + j * 4);
                if (k == 22) { depth = depth + 1; j = j + 1; }
                else {
                    if (k == 23) { depth = depth - 1; j = j + 1; }
                    else {
                        if (depth == 1 && k == 11) {
                            let mi = get_nmeth();
                            store32(METHTOK() + mi * 4, j); store32(METHCLS() + mi * 4, ncls);
                            set_nmeth(mi + 1);
                            j = skip_fn_body(j, total);
                        } else {
                            if (depth == 1 && is_field_start(k)) {
                                let fo = load32(TVAL() + j * 4); let fl = load32(TLEN() + j * 4);
                                let fld = get_nfcls();
                                store32(FLDO() + fld * 4, fo); store32(FLDL() + fld * 4, fl);
                                store32(FLDCL() + fld * 4, ncls); store32(FLDOC() + fld * 4, nsz);
                                set_nfcls(fld + 1);
                                nfld = nfld + 1; nsz = nsz + 4;
                                while (j < total && load32(KIND() + j * 4) != 25) { j = j + 1; }
                                j = j + 1;
                            } else { j = j + 1; }
                        }
                    }
                }
            }
            store32(CLNF() + ncls * 4, nfld);
            store32(CLSZ() + ncls * 4, nsz);
            ncls = ncls + 1;
            i = j;
        } else { i = i + 1; }
    }
    set_ncls(ncls);
    return ncls;
}

// Поле начинается с идентификатора/мягкого слова, но не с `fn`.
fn is_field_start(k) -> bool { return k == 2 || (k >= 10 && k <= 19); }

// Класс метода по токену `fn` (-1 если это свободная функция).
fn method_class(fntok) -> int {
    let i = 0; let n = get_nmeth();
    while (i < n) {
        if (load32(METHTOK() + i * 4) == fntok) { return load32(METHCLS() + i * 4); }
        i = i + 1;
    }
    return -1;
}

// Смещение поля в объекте класса (-1 если поле не найдено).
fn field_off(cls, off, ln) -> int {
    let i = load32(CLFFI() + cls * 4);
    let n = i + load32(CLNF() + cls * 4);
    while (i < n) {
        if (name_eq(off, ln, load32(FLDO() + i * 4), load32(FLDL() + i * 4))) { return load32(FLDOC() + i * 4); }
        i = i + 1;
    }
    return -1;
}

// Индекс функции метода класса по имени (-1 если нет).
fn find_method(cls, off, ln) -> int {
    let i = 0; let n = get(0, 2);
    while (i < n) {
        if (load32(FNCLS() + i * 4) == cls
            && name_eq(off, ln, load32(FNOFF() + i * 4), load32(FNLEN() + i * 4))) { return i; }
        i = i + 1;
    }
    return -1;
}

// Индекс функции метода класса по имени-литералу.
fn find_method_named(cls, name, nl) -> int {
    let i = 0; let n = get(0, 2);
    while (i < n) {
        if (load32(FNCLS() + i * 4) == cls
            && is_lit(load32(FNOFF() + i * 4), load32(FNLEN() + i * 4), name, nl)) { return i; }
        i = i + 1;
    }
    return -1;
}

// Результат функции оставляет значение? (для drop при вызове конструктора).
fn fn_has_result(fi) -> bool {
    let total = get(0, 1);
    let i = load32(FNTOK() + fi * 4);
    // ищем `->` после ')' или `return <expr>`
    let j = i;
    while (j < total && load32(KIND() + j * 4) != 22 && load32(KIND() + j * 4) != 0) {
        if (load32(KIND() + j * 4) == 28) { return true; }
        j = j + 1;
    }
    j = i;
    while (j < total && load32(KIND() + j * 4) != 0) {
        if (load32(KIND() + j * 4) == 15) {
            if (load32(KIND() + (j + 1) * 4) != 25 && load32(KIND() + (j + 1) * 4) != 23) { return true; }
        }
        j = j + 1;
    }
    return false;
}

// ===== часть: 36_lambda.lat =====
// ============================ ЛЯМБДЫ / ЗАМЫКАНИЯ ============================
// Первый проход: находит `fn` внутри тел (не методы, не верхний уровень),
// регистрирует параметры, границы тела и захваты (свободные имена).
// Closure representation: [table_slot i32][env_ptr i32]; env хранит
// захваченные i32 по слотам. Косвенный вызов — call_indirect с типом
// (env, params...) -> i32.

fn nlam() -> int { return load32(NLAM()); }
fn set_nlam(v) -> int { store32(NLAM(), v); return v; }
fn ncap() -> int { return load32(NCAP()); }
fn set_ncap(v) -> int { store32(NCAP(), v); return v; }

// Область параметров/захватов физически одна: LPST..(LPST+4*np-1) для
// параметров, CAPO/CAPL — для захватов (отдельные массивы).

fn skip_lambda_body(j, total) -> int {
    // j указывает на `{` или на начало выражения `=>`.
    while (j < total && load32(KIND() + j * 4) != 27 && load32(KIND() + j * 4) != 22) { j = j + 1; }
    return j;
}

// Собирает захваты лямбды `li`: свободные идентификаторы тела, не являющиеся
// параметрами, локальными объявлениями тела или функциями верхнего уровня.
// Параметры лямбды лежат в сквозном массиве LPOFF/LPLEN, начиная с индекса
// параметров этой лямбды (нужно вычислить смещение).
fn scan_lambda_captures(bs, be, is_blk, np, li, poff, plen) -> int {
    let first = ncap();
    let pbase = param_base(li);
    let i = bs;
    while (i < be) {
        let tk = load32(KIND() + i * 4);
        if (tk == 2) {
            let off = load32(TVAL() + i * 4); let ln = load32(TLEN() + i * 4);
            if (!is_cap_param(pbase, np, off, ln)
                && !is_cap_local(bs, i, off, ln)
                && find_func(off, ln) < 0
                && variant_tag(off, ln) < 0
                && !is_cap_dup(first, off, ln)
                && !is_ident_kw(off, ln)) {
                add_cap(off, ln);
            }
        }
        i = i + 1;
    }
    return 0;
}

// Начало параметров лямбды li в сквозном массиве LPOFF/LPLEN.
fn param_base(li) -> int {
    let i = 0; let b = 0;
    while (i < li) { b = b + load32(LAMNP() + i * 4); i = i + 1; }
    return b;
}

fn is_ident_kw(off, ln) -> bool {
    // Мягкие встроенные имена не захватываем.
    if (is_lit(off, ln, "print", 5)) { return true; }
    if (is_lit(off, ln, "len", 3)) { return true; }
    if (is_lit(off, ln, "push", 4)) { return true; }
    if (is_lit(off, ln, "str", 3)) { return true; }
    if (is_lit(off, ln, "int", 3)) { return true; }
    if (is_lit(off, ln, "true", 4) || is_lit(off, ln, "false", 5)) { return true; }
    return false;
}

fn is_cap_param(pbase, np, off, ln) -> bool {
    let i = 0;
    while (i < np) {
        if (name_eq(off, ln, load32(LPOFF() + (pbase + i) * 4), load32(LPLEN() + (pbase + i) * 4))) { return true; }
        i = i + 1;
    }
    return false;
}

// `let <this>` где-то в теле (до или после) — считаем локальным, не захватом.
fn is_cap_local(bs, cur, off, ln) -> bool {
    let i = bs;
    while (i < cur) {
        if (load32(KIND() + i * 4) == 10) {
            if (name_eq(off, ln, load32(TVAL() + (i + 1) * 4), load32(TLEN() + (i + 1) * 4))) { return true; }
        }
        i = i + 1;
    }
    return false;
}

fn is_cap_dup(first, off, ln) -> bool {
    let i = first;
    let n = ncap();
    while (i < n) {
        if (name_eq(off, ln, load32(CAPO() + i * 4), load32(CAPL() + i * 4))) { return true; }
        i = i + 1;
    }
    return false;
}

fn add_cap(off, ln) -> int {
    let i = ncap();
    store32(CAPO() + i * 4, off); store32(CAPL() + i * 4, ln);
    set_ncap(i + 1);
    return i;
}

// Пропуск тела лямбды: блочное (`{...}`) или выражение до `,`/`;`/`}`/`)`.
fn lambda_body_end(bs, is_blk, total) -> int {
    if (is_blk == 1) {
        let d = 0; let i = bs;
        while (i < total) {
            let tk = load32(KIND() + i * 4);
            if (tk == 22) { d = d + 1; }
            else { if (tk == 23) { d = d - 1; if (d == 0) { return i + 1; } } }
            i = i + 1;
        }
        return i;
    }
    // выражение: до `,` `;` `}` `)` на верхнем уровне вложенности
    let d = 0; let i = bs;
    while (i < total) {
        let tk = load32(KIND() + i * 4);
        if (tk == 20 || tk == 80 || tk == 22) { d = d + 1; }
        else {
            if (tk == 21 || tk == 81 || tk == 23) {
                if (d == 0) { return i; }
                d = d - 1;
            } else {
                if (d == 0 && (tk == 24 || tk == 25)) { return i; }
            }
        }
        i = i + 1;
    }
    return i;
}

fn scan_lambdas() -> int {
    let total = get(0, 1);
    let i = 0; let nl = 0; let depth = 0;
    let npnl = 0;                 // сквозной счётчик параметров лямбд
    while (i < total) {
        let tk = load32(KIND() + i * 4);
        if (tk == 22) { depth = depth + 1; i = i + 1; }
        else {
            if (tk == 23) { depth = depth - 1; i = i + 1; }
            else {
                if (tk == 11 && depth > 0 && method_class(i) < 0) {
                    store32(LAMTOK() + nl * 4, i);
                    let np = 0; let j = i + 2; let prev = 20;
                    while (j < total && load32(KIND() + j * 4) != 21) {
                        let kk = load32(KIND() + j * 4);
                        if ((kk == 2 || (kk >= 10 && kk <= 19)) && (prev == 20 || prev == 24)) {
                            store32(LPOFF() + npnl * 4, load32(TVAL() + j * 4));
                            store32(LPLEN() + npnl * 4, load32(TLEN() + j * 4));
                            np = np + 1; npnl = npnl + 1;
                        }
                        prev = kk; j = j + 1;
                    }
                    store32(LAMNP() + nl * 4, np);
                    j = j + 1;                     // через ')'
                    if (load32(KIND() + j * 4) == 28) {
                        j = j + 1;
                        while (j < total && load32(KIND() + j * 4) != 27 && load32(KIND() + j * 4) != 22) { j = j + 1; }
                    }
                    let is_blk = 0;
                    if (load32(KIND() + j * 4) == 99) { j = j + 1; } else { is_blk = 1; }
                    store32(LAMBLK() + nl * 4, is_blk);
                    let bs = j;
                    let be = lambda_body_end(bs, is_blk, total);
                    store32(LAMBODY() + nl * 4, bs);
                    store32(LAMBEND() + nl * 4, be);
                    let first = ncap();
                    store32(LAMS0() + nl * 4, first);
                    scan_lambda_captures(bs, be, is_blk, np, nl, LPOFF(), LPLEN());
                    store32(LAMNC() + nl * 4, ncap() - first);
                    nl = nl + 1;
                    i = be;
                } else { i = i + 1; }
            }
        }
    }
    store32(NPNL(), npnl);
    set_nlam(nl);
    return nl;
}

fn lam_tok(li) -> int { return load32(LAMTOK() + li * 4); }
fn lam_np(li) -> int { return load32(LAMNP() + li * 4); }
fn lam_body_start(li) -> int { return load32(LAMBODY() + li * 4); }
fn lam_body_end(li) -> int { return load32(LAMBEND() + li * 4); }
fn lam_is_block(li) -> int { return load32(LAMBLK() + li * 4); }
fn lam_fn(li) -> int { return load32(LAMFN() + li * 4); }

// Лямбда по токену `fn` (-1 если нет).
fn lambda_at(token) -> int {
    let i = 0; let n = nlam();
    while (i < n) {
        if (load32(LAMTOK() + i * 4) == token) { return i; }
        i = i + 1;
    }
    return -1;
}

fn cap_start(li) -> int { return load32(LAMS0() + li * 4); }
fn cap_count(li) -> int { return load32(LAMNC() + li * 4); }
fn cap_name_off(li, c) -> int { return load32(CAPO() + (cap_start(li) + c) * 4); }
fn cap_name_len(li, c) -> int { return load32(CAPL() + (cap_start(li) + c) * 4); }

// Модульный индекс функции лямбды: 1(import)+nf()+7(хелперы)+li.
fn lam_fidx(li) -> int { return nf() + 9 + li; }
// Тип лямбды: (env, params...) -> i32 = арность np+1.
// В type-секции тип арности a имеет индекс a+1, значит индекс = np+2.
fn lam_tp(li) -> int { return lam_np(li) + 2; }

// Регистрирует индекс функции каждой лямбды (вызывается после scan_signatures,
// когда nf() уже известно).
fn register_lambdas() -> int {
    let i = 0; let n = nlam();
    while (i < n) {
        store32(LAMFN() + i * 4, lam_fidx(i));
        i = i + 1;
    }
    return n;
}

// Компилирует тело лямбды li в CODEB-слот lam_fidx(li).
fn compile_lambda(li) -> int {
    set(0, 0, lam_body_start(li));
    binit(FNB());
    set(0, 3, 0);
    // Локаль 0 — env-указатель.
    add_local(-2, 1, 0); set_local_tp(0, T_INT());
    // Параметры.
    let pbase = param_base(li);
    let np = lam_np(li);
    let pi = 0;
    while (pi < np) {
        let slot = get(0, 3);
        add_local(load32(LPOFF() + (pbase + pi) * 4), load32(LPLEN() + (pbase + pi) * 4), slot);
        set_local_tp(slot, T_INT());
        pi = pi + 1;
    }
    // Захваты: читаем env[c] → свежие локали.
    let nc = cap_count(li);
    let ci = 0;
    while (ci < nc) {
        let slot = get(0, 3);
        add_local(cap_name_off(li, ci), cap_name_len(li, ci), slot);
        set_local_tp(slot, T_INT());
        emit_op(32); emit_leb(0); emit_op(65); emit_sleb(ci * 4); emit_op(106); emit_op(40); emit_op(2); emit_op(0);
        emit_op(33); emit_leb(slot);
        ci = ci + 1;
    }
    // Тело.
    if (lam_is_block(li) == 1) {
        expect(22);
        stmts();
        expect(23);
    } else {
        level_or();
        emit_op(15);   // return
    }
    let lb = load8(FNB() + 4 + load32(FNB()) - 1);
    if (lb != 15) { emit_op(65); emit_sleb(0); }
    emit_op(11);
    // финальное тело: nlocals = все слоты минус (env + np)
    binit(BODYC());
    let nparams = np + 1;
    let nlocals = get(0, 3) - nparams;
    if (nlocals < 0) { nlocals = 0; }
    if (nlocals > 0) { bleb(BODYC(), 1); bleb(BODYC(), nlocals); bput(BODYC(), 127); } else { bleb(BODYC(), 0); }
    bcopy(BODYC(), FNB(), 0, blen(FNB()));
    // Слот code-секции = индекс функции минус 1 (импорт print не имеет тела).
    let slot = lam_fidx(li) - 1;
    store32(CODEOF() + slot * 4, load32(CODEB()));
    store32(CODELN() + slot * 4, blen(BODYC()));
    bcopy(CODEB(), BODYC(), 0, blen(BODYC()));
    return 0;
}

// ===== часть: 40a_expr_emit.lat =====
// --- эмиссия: опкоды, встроенные вызовы, print ---
// Отвечает за «словарь» эмиттера: байт/LEB в буфер функции, разбор
// аргументов встроенных (память, строки, конверсии, assert, print) и
// диспетчеризацию вызова по имени. Pratt-уровни и объектные выражения —
// в соседних частях 40b..40g.

// --- эмиссия опкодов: два слоя ---
// Чистый слой: буфер передаётся параметром, результат зависит только от
// аргументов и содержимого памяти — никаких фиксированных адресов.
fn emit_byte(b, op) -> int { return bput(b, op); }
fn emit_i32_to(b, v) -> int { emit_byte(b, 65); return bsleb(b, v); }      // i32.const
fn emit_get_from(b, l) -> int { emit_byte(b, 32); return bleb(b, l); }     // local.get
fn emit_set_in(b, l) -> int { emit_byte(b, 33); return bleb(b, l); }       // local.set
fn emit_call_in(b, fi) -> int { emit_byte(b, 16); return bleb(b, fi); }    // call
fn emit_load32_from(b) -> int { emit_byte(b, 40); emit_byte(b, 2); return emit_byte(b, 0); }
fn emit_store32_to(b) -> int { emit_byte(b, 54); emit_byte(b, 2); return emit_byte(b, 0); }

// Императивная граница: текущий буфер тела функции (FNB) — состояние
// компилятора, поэтому эти обёртки не «чистые» и сосредоточены только здесь.
fn emit_op(b) -> int { return emit_byte(FNB(), b); }
fn emit_leb(v) -> int { return bleb(FNB(), v); }
fn emit_sleb(v) -> int { return bsleb(FNB(), v); }
fn ev_i32(v) -> int { return emit_i32_to(FNB(), v); }
fn ev_get(l) -> int { return emit_get_from(FNB(), l); }
fn ev_set(l) -> int { return emit_set_in(FNB(), l); }
fn ev_call(fi) -> int { return emit_call_in(FNB(), fi); }
fn ev_load32() -> int { return emit_load32_from(FNB()); }
fn ev_store32() -> int { return emit_store32_to(FNB()); }
fn nf() -> int { return get(0, 2); }
fn ALLOC_FI() -> int { return get(0, 2) + 1; }
fn MEM_FI() -> int { return get(0, 2) + 2; }
fn SCAT_FI() -> int { return get(0, 2) + 3; }   // str_concat(a,b)->ptr
fn SEQ_FI() -> int { return get(0, 2) + 4; }    // str_eq(a,b)->i32
fn SCHR_FI() -> int { return get(0, 2) + 5; }   // str_char_at(ptr,idx)->i32
fn I32S_FI() -> int { return get(0, 2) + 6; }   // i32_to_str(n)->ptr
fn S2I_FI() -> int { return get(0, 2) + 7; }    // str_to_i32(ptr)->i32
fn F64S_FI() -> int { return get(0, 2) + 8; }   // f64_to_str(n)->ptr
fn NHELP() -> int { return 8; }                 // alloc+memcopy+3 str+3 conv

fn emit_bi1(fi, opcode, align) -> int {
    let base = get(0, 7);
    expect(20); level_or(); expect(21);
    if (opcode == 0) { ev_call(fi); } else { emit_op(opcode); emit_op(align); emit_op(0); }
    set(0, 5, 1);
    set(0, 7, base); tp(T_INT());
    return 0;
}
fn emit_bi2(fi, opcode, align, produces) -> int {
    let base = get(0, 7);
    expect(20); level_or();
    if (tok_kind() == 24) { next_token(); }
    level_or(); expect(21);
    if (opcode == 0) { ev_call(fi); } else { emit_op(opcode); emit_op(align); emit_op(0); }
    set(0, 5, produces);
    set(0, 7, base);
    if (produces == 1) { tp(T_INT()); }
    return 0;
}
fn emit_memcopy() -> int {
    let base = get(0, 7);
    expect(20); level_or();
    if (tok_kind() == 24) { next_token(); }
    level_or();
    if (tok_kind() == 24) { next_token(); }
    level_or(); expect(21);
    ev_call(MEM_FI());
    set(0, 5, 1);
    set(0, 7, base); tp(T_INT());
    return 0;
}

fn emit_call(off, ln) -> int {
    if (is_lit(off, ln, "print", 5)) { return emit_print(); }
    if (is_host_builtin(off, ln)) { return emit_host_builtin(off, ln); }
    if (is_lit(off, ln, "alloc", 5)) { return emit_bi1(ALLOC_FI(), 0, 0); }
    if (is_lit(off, ln, "memcopy", 7)) { return emit_memcopy(); }
    if (is_lit(off, ln, "load8", 5)) { return emit_bi1(0, 45, 0); }
    if (is_lit(off, ln, "load32", 6)) { return emit_bi1(0, 40, 2); }
    if (is_lit(off, ln, "store8", 6)) { return emit_bi2(0, 58, 0, 0); }
    if (is_lit(off, ln, "store32", 7)) { return emit_bi2(0, 54, 2, 0); }
    if (is_lit(off, ln, "len", 3)) { return emit_len(); }
    if (is_lit(off, ln, "push", 4)) { return emit_push_call(); }
    if (is_lit(off, ln, "assert", 6)) { return emit_assert(); }
    if (is_lit(off, ln, "assert_eq", 9)) { return emit_assert_eq(); }
    if (is_lit(off, ln, "str", 3)) { return emit_str_conv(); }
    if (is_lit(off, ln, "int", 3)) { return emit_int_conv(); }
    if (is_lit(off, ln, "float", 5)) { return emit_float_conv(); }
    if (is_lit(off, ln, "sqrt", 4)) { return emit_sqrt(); }
    let fi = find_func(off, ln);
    if (fi < 0) {
        // Конструктор enum-варианта: Tag(args) → [tag i32][fields...].
        let tag = variant_tag(off, ln);
        if (tag >= 0) { return emit_variant(tag, variant_arity(off, ln)); }
        // Локаль, хранящая замыкание → косвенный вызов.
        let li = find_local(off, ln);
        if (li >= 0) { return emit_indirect_call(li); }
        err_named("error: undefined function: ", off, ln, "");
        return 0;
    }
    return emit_call_named(fi + 1, 0);
}

// Tag(args) → указатель на [tag i32][field0]... 0-арный — сам тег.
fn emit_variant(tag, ar) -> int {
    let base = get(0, 7);
    expect(20);
    if (ar == 0) {
        while (tok_kind() != 21 && tok_kind() != 0) { set(0, 7, base); level_or(); if (tok_kind() == 24) { next_token(); } }
        expect(21);
        ev_i32(tag);
        set(0, 5, 1); set(0, 7, base); tp(T_INT()); return 0;
    }
    let p = reserve();
    ev_i32(4 + ar * 4); ev_call(ALLOC_FI()); ev_set(p);
    let i = 0;
    while (tok_kind() != 21 && tok_kind() != 0) {
        set(0, 7, base);
        ev_get(p); ev_i32(4 + i * 4); emit_op(106);
        level_or();
        ev_store32();
        i = i + 1;
        if (tok_kind() == 24) { next_token(); }
    }
    expect(21);
    ev_get(p); ev_i32(tag); ev_store32();
    ev_get(p);
    set(0, 5, 1); set(0, 7, base); tp(T_INT());
    return 0;
}

// len(x) -> длина из заголовка [len u32][...] (общее представление строк/массивов).
fn emit_len() -> int {
    let base = get(0, 7);
    expect(20); level_or(); expect(21);
    ev_load32();
    set(0, 5, 1);
    set(0, 7, base); tp(T_INT());
    return 0;
}

// assert(cond): if !cond { unreachable }.
fn emit_assert() -> int {
    let base = get(0, 7);
    expect(20); level_or(); expect(21);
    emit_op(69); emit_op(4); emit_op(64); emit_op(0); emit_op(11);
    set(0, 5, 0);
    set(0, 7, base);
    return 0;
}

// assert_eq(a, b): if a != b { unreachable } (i32-равенство, как в oracle).
fn emit_assert_eq() -> int {
    let base = get(0, 7);
    expect(20); level_or();
    if (tok_kind() == 24) { next_token(); }
    level_or(); expect(21);
    emit_op(70); emit_op(69); emit_op(4); emit_op(64); emit_op(0); emit_op(11);
    set(0, 5, 0);
    set(0, 7, base);
    return 0;
}

// str(x): строка остаётся, число конвертируется в строку (i32_to_str).
fn emit_str_conv() -> int {
    let base = get(0, 7);
    expect(20);
    if (tok_kind() == 21) { next_token(); ev_i32(0); set(0, 5, 1); set(0, 7, base); tp(T_STR()); return 0; }
    level_or();
    let xt = load32(TSTK() + base * 4);
    expect(21);
    if (xt == T_FLT()) { ev_call(F64S_FI()); }
    else { if (xt != T_STR()) { ev_call(I32S_FI()); } }
    set(0, 5, 1); set(0, 7, base); tp(T_STR());
    return 0;
}
// int(x): строку парсим (str_to_i32), число как есть (f64-усечение не поддержано).
fn emit_int_conv() -> int {
    let base = get(0, 7);
    expect(20);
    if (tok_kind() == 21) { next_token(); ev_i32(0); set(0, 5, 1); set(0, 7, base); tp(T_INT()); return 0; }
    level_or();
    let xt = load32(TSTK() + base * 4);
    expect(21);
    if (xt == T_STR()) { ev_call(S2I_FI()); }
    else { if (xt == T_FLT()) { emit_op(I32_TRUNC_F64_OP()); } }
    set(0, 5, 1); set(0, 7, base); tp(T_INT());
    return 0;
}

// float(x): int → f64 (f64.convert_i32_s); строку парсим (str_to_i32) и
// конвертируем; float оставляем как есть — как oracle.
fn emit_float_conv() -> int {
    let base = get(0, 7);
    expect(20);
    if (tok_kind() == 21) { next_token(); ev_i32(0); emit_op(F64_CONV_I32_OP()); set(0, 5, 1); set(0, 7, base); tp(T_FLT()); return 0; }
    level_or();
    let xt = load32(TSTK() + base * 4);
    expect(21);
    if (xt == T_STR()) { ev_call(S2I_FI()); emit_op(F64_CONV_I32_OP()); }
    else { if (xt != T_FLT()) { emit_op(F64_CONV_I32_OP()); } }
    set(0, 5, 1); set(0, 7, base); tp(T_FLT());
    return 0;
}
// sqrt(x): f64.sqrt; не-float операнд сначала конвертим.
fn emit_sqrt() -> int {
    let base = get(0, 7);
    expect(20);
    if (tok_kind() == 21) { next_token(); ev_i32(0); emit_op(F64_CONV_I32_OP()); emit_op(159); set(0, 5, 1); set(0, 7, base); tp(T_FLT()); return 0; }
    level_or();
    let xt = load32(TSTK() + base * 4);
    expect(21);
    if (xt != T_FLT()) { emit_op(F64_CONV_I32_OP()); }
    emit_op(159);                             // f64.sqrt
    set(0, 5, 1); set(0, 7, base); tp(T_FLT());
    return 0;
}

// push(arr, x): arr[len]=x; arr.len=len+1; результат — arr.
// Стек после разбора: [arr, x].
fn emit_push_call() -> int {
    let base = get(0, 7);
    expect(20); level_or();
    if (tok_kind() == 24) { next_token(); }
    level_or(); expect(21);
    let xl = reserve(); ev_set(xl);
    let al = reserve(); ev_set(al);
    emit_push_seq(al, xl);
    set(0, 5, 1);
    set(0, 7, base); tp(T_INT());
    return 0;
}

// Общая последовательность push для уже сохранённых в локалях arr/x.
fn emit_push_seq(al, xl) -> int {
    ev_get(al); ev_get(al); ev_load32(); ev_i32(4); emit_op(108); emit_op(106); ev_i32(4); emit_op(106); ev_get(xl); ev_store32();
    ev_get(al); ev_get(al); ev_load32(); ev_i32(1); emit_op(106); ev_store32();
    ev_get(al);
    return 0;
}

// Общая последовательность pop для arr в локали: len--; результат arr[len].
fn emit_pop_seq(al) -> int {
    ev_get(al); ev_get(al); ev_load32(); ev_i32(1); emit_op(107); ev_store32();
    ev_get(al); ev_get(al); ev_load32(); ev_i32(4); emit_op(108); emit_op(106); ev_i32(4); emit_op(106); ev_load32();
    return 0;
}
// print(a, b, ...) — каждый аргумент конвертируется в строку и печатается
// отдельной строкой (как в oracle): int → i32_to_str, float → f64_to_str,
// строка — как есть.
fn emit_print() -> int {
    let base = get(0, 7);
    expect(20);
    while (tok_kind() != 21 && tok_kind() != 0) {
        set(0, 7, base);
        level_or();
        let t = load32(TSTK() + base * 4);
        if (t == T_FLT()) { ev_call(F64S_FI()); }
        else { if (t != T_STR()) { ev_call(I32S_FI()); } }
        ev_call(0);                 // call env.print (импорт, индекс 0)
        set(0, 5, 0);
        set(0, 7, base);
        if (tok_kind() == 24) { next_token(); }
    }
    expect(21);
    set(0, 5, 0);
    set(0, 7, base);
    return 0;
}

// ===== часть: 40b_expr_values.lat =====
// --- эмиссия: host-builtin'ы, вызов по индексу, float-литералы ---
// Host-конструкции (AI/каналы) дают ошибку с именем builtin'а; здесь же
// вычисление значения float-литерала без кодирования битов IEEE754 и
// повышение int→f64 для смешанной арифметики.

// Встроенные, которым нужен host-рантайм движка №1 (HOST_BUILTINS в oracle):
// oracle даёт по ним понятную ошибку кодогена — повторяем её с именем.
fn is_host_builtin(off, ln) -> bool {
    if (is_lit(off, ln, "channel", 7)) { return true; }
    if (is_lit(off, ln, "tensor", 6)) { return true; }
    if (is_lit(off, ln, "semantic", 8)) { return true; }
    if (is_lit(off, ln, "matmul", 6)) { return true; }
    if (is_lit(off, ln, "cosine_similarity", 17)) { return true; }
    if (is_lit(off, ln, "dot", 3)) { return true; }
    if (is_lit(off, ln, "magnitude", 9)) { return true; }
    if (is_lit(off, ln, "zeros", 5)) { return true; }
    if (is_lit(off, ln, "ones", 4)) { return true; }
    if (is_lit(off, ln, "snapshot", 8)) { return true; }
    if (is_lit(off, ln, "ai_contract", 11)) { return true; }
    if (is_lit(off, ln, "enforce_contract", 16)) { return true; }
    if (is_lit(off, ln, "ai_infer", 8)) { return true; }
    if (is_lit(off, ln, "ai_embed", 8)) { return true; }
    if (is_lit(off, ln, "ai_stream", 9)) { return true; }
    if (is_lit(off, ln, "stream_next", 11)) { return true; }
    return false;
}

// channel<T>(args): generic-параметр отбрасывается (как в oracle), далее —
// обычная host-ошибка с именем builtin'а.
fn emit_channel_generic(off, ln) -> int {
    next_token(); next_token();                        // channel, <
    while (tok_kind() != 43 && tok_kind() != 0) { next_token(); }
    if (tok_kind() == 43) { next_token(); }
    return emit_host_builtin(off, ln);
}

// Разбирает аргументы host-builtin'а и сообщает об ошибке с его именем:
// движок №2 не имеет host-рантайма (AI/tensor/каналы).
fn emit_host_builtin(off, ln) -> int {
    let base = get(0, 7);
    expect(20);
    while (tok_kind() != 21 && tok_kind() != 0) {
        set(0, 7, base);
        level_or();
        if (tok_kind() == 24) { next_token(); }
    }
    expect(21);
    err_named("error: builtin '", off, ln, "' requires host runtime (engine #2)");
    set(0, 5, 0);
    set(0, 7, base);
    return 0;
}

fn emit_call_named(fidx, is_print) -> int {
    let base = get(0, 7);
    expect(20);
    let argc = 0;
    while (tok_kind() != 21 && tok_kind() != 0) {
        level_or(); argc = argc + 1;
        if (tok_kind() == 24) { next_token(); }
    }
    expect(21);
    ev_call(fidx);
    set(0, 7, base);
    if (is_print == 1) { set(0, 5, 0); }
    else {
        set(0, 5, 1);
        // fidx = find_func(...)+1, функция index = fidx-1.
        tp(load32(FNRET() + (fidx - 1) * 4));
    }
    return 0;
}

// Литерал с плавающей точкой `I.F`, `IeN`, `I.FeN`: значение = mant / 10^k *
// 10^exp. Целочисленно-значные литералы (по oracle: f64.fract()==0) эмитятся
// как i32.const и имеют тип int — это наблюдаемо через str(2.0) → "2".
// Дробные — как f64-арифметика без кодирования битов IEEE754.
// Возвращает T_INT или T_FLT (тип литерала).
fn emit_float_lit(off, ln) -> int {
    // Позиция экспоненты (e/E), -1 если её нет.
    let epos = -1; let i = 0;
    while (i < ln) {
        let c = load8(INPUT() + 4 + off + i);
        if (c == 101 || c == 69) { epos = i; i = ln; } else { i = i + 1; }
    }
    let mend = ln; if (epos >= 0) { mend = epos; }
    // Мантисса: целые/дробные цифры, k — число цифр после точки.
    let mant = 0; let k = 0; let dot = 0;
    i = 0;
    while (i < mend) {
        let c = load8(INPUT() + 4 + off + i);
        if (c == 46) { dot = 1; }
        else {
            mant = mant * 10 + (c - 48);
            if (dot == 1) { k = k + 1; }
        }
        i = i + 1;
    }
    // Экспонента (со знаком).
    let exp = 0; let esign = 1;
    if (epos >= 0) {
        i = epos + 1;
        if (i < ln && load8(INPUT() + 4 + off + i) == 45) { esign = -1; i = i + 1; }
        else { if (i < ln && load8(INPUT() + 4 + off + i) == 43) { i = i + 1; } }
        while (i < ln) { exp = exp * 10 + (load8(INPUT() + 4 + off + i) - 48); i = i + 1; }
        exp = exp * esign;
    }
    if (exp >= k) {
        ev_i32(mant * pow10(exp - k));
        return T_INT();
    }
    let d = k - exp;
    let p = pow10(d);
    if (mant % p == 0) { ev_i32(mant / p); return T_INT(); }
    ev_i32(mant); emit_op(183);      // mant → f64
    ev_i32(p); emit_op(183);         // 10^d → f64
    emit_op(163);                             // f64.div
    return T_FLT();
}
// Меняет местами/повышает два верхних операнда в локалях: когда один int,
// другой float — int конвертируется в f64, чтобы f64-операция была валидна.
// Значения уже на стеке как [l, r]; сохраняем в локали и перекладываем.
fn promote_pair(base, lt, rt) -> int {
    // Каждый операнд сохраняем в локаль СВОЕГО типа (иначе local.set невалиден),
    // затем повторно кладём на стек, конвертируя int→f64.
    let rl = reserve_any(rt); ev_set(rl);
    let ll = reserve_any(lt); ev_set(ll);
    ev_get(ll); if (lt != T_FLT()) { emit_op(F64_CONV_I32_OP()); }
    ev_get(rl); if (rt != T_FLT()) { emit_op(F64_CONV_I32_OP()); }
    set(0, 7, base);
    return 0;
}
// Резерв слота под конкретный тип операнда (int → i32, иначе f64).
fn reserve_any(t) -> int {
    if (t == T_FLT()) { return reserve_flt(); }
    return reserve();
}
fn pow10(k) -> int {
    let v = 1; let i = 0;
    while (i < k) { v = v * 10; i = i + 1; }
    return v;
}

// ===== часть: 40c_expr_primary.lat =====
// --- эмиссия: первичные выражения и замыкания ---
// Литералы, идентификаторы, `await`, `null`, лямбда-литерал (создание env
// и closure-объекта) и косвенный вызов замыкания.

fn level_primary() -> int {
    let k = tok_kind();
    if (k == 1) { ev_i32(tok_val()); next_token(); set(0, 5, 1); tp(T_INT()); return 0; }
    if (k == 4) {
        let t = emit_float_lit(tok_val(), tok_len()); next_token(); set(0, 5, 1); tp(t);
        return 0;
    }
    if (k == 90) { ev_i32(1); next_token(); set(0, 5, 1); tp(T_INT()); return 0; }
    if (k == 91) { ev_i32(0); next_token(); set(0, 5, 1); tp(T_INT()); return 0; }
    if (k == 107) { ev_i32(0); next_token(); set(0, 5, 1); tp(T_INT()); return 0; }   // null ≡ 0
    if (k == 3) {
        let q = tok_val(); let ql = tok_len();
        let addr = str_addr(q + 1, ql - 2);
        ev_i32(addr); next_token(); set(0, 5, 1); tp(T_STR()); return 0;
    }
    if (k == 20) { next_token(); level_or(); expect(21); return 0; }
    if (k == 80) { return level_array(); }
    if (k == 31) { next_token(); ev_i32(0); level_unary(); emit_op(107); set(0, 5, 1); return 0; }
    if (k == 53) { next_token(); level_unary(); emit_op(69); set(0, 5, 1); return 0; }
    if (k == 94) { next_token(); ev_get(0); set(0, 5, 1); tp(T_INT()); set(0, 8, load32(FNCLS() + load32(CURFI()) * 4)); return 0; }
    if (k == 93) { return level_new(); }
    if (k == 95) { return level_match(); }
    if (k == 104) { return level_select(); }
    if (k == 11) { return level_lambda(); }
    // await — прозрачное разворачивание значения (Promise в WASM нет).
    if (k == 103) { next_token(); return level_unary(); }
    // <-ch — приём из канала: host-рантайм движка №1.
    if (k == 106) { return level_receive(); }
    if (is_ident_kind(k)) { return level_ident(); }
    err(); set(0, 5, 1); tp(T_INT()); set(0, 8, -1); return 0;
}

// <-ch: выражение разбирается целиком, но каналы требуют host-рантайма №1.
fn level_receive() -> int {
    next_token(); level_unary();
    err_named("error: channel operations require host runtime (engine #1)", 0, 0, "");
    set(0, 5, 1); tp(T_INT()); set(0, 8, -1);
    return 0;
}

// Идентификатор: AI-примитив, generic-канал, 0-арный вариант, вызов функции,
// локальная переменная — или ошибка «undefined variable» с именем.
fn level_ident() -> int {
    let off = tok_val(); let ln = tok_len();
    if (tok_kind_at(1) == 53 && is_lit(off, ln, "ai_generate", 11)) {
        return emit_ai_generate_error();
    }
    if (tok_kind_at(1) == 42 && is_lit(off, ln, "channel", 7)) {
        return emit_channel_generic(off, ln);
    }
    // 0-арный enum-вариант как значение (без скобок).
    if (tok_kind_at(1) != 20 && find_local(off, ln) < 0 && find_func(off, ln) < 0
        && variant_tag(off, ln) >= 0) {
        ev_i32(variant_tag(off, ln)); next_token();
        set(0, 5, 1); tp(T_INT()); set(0, 8, -1); return 0;
    }
    next_token();
    if (tok_kind() == 20) { return emit_call(off, ln); }
    let li = find_local(off, ln);
    if (li >= 0) {
        ev_get(li); set(0, 5, 1); tp(local_tp(li));
        set(0, 8, load32(LOCCLS() + li * 4));
        return 0;
    }
    err_named("error: undefined variable: ", off, ln, "");
    set(0, 5, 1); tp(T_INT()); set(0, 8, -1);
    return 0;
}

// ai_generate!("prompt") — AI-примитив, требует host-рантайма.
fn emit_ai_generate_error() -> int {
    next_token(); next_token();                  // ai_generate !
    expect(20);
    if (tok_kind() == 3) { next_token(); } else { err(); }
    expect(21);
    err_named("error: AI primitives require host runtime (engine #1)", 0, 0, "");
    set(0, 5, 1); tp(T_INT()); set(0, 8, -1);
    return 0;
}

// Литерал лямбды `fn(params) => expr` / `fn(params) { ... }` → closure-указатель
// [table_slot i32][env_ptr i32]. Лямбда уже вынесена в отдельную функцию
// (scan_lambdas); здесь создаётся env с захватами и сам closure-объект.
fn level_lambda() -> int {
    let li = lambda_at(get(0, 0));
    if (li < 0) { err(); return 0; }
    let nc = cap_count(li);
    // env = alloc(4*nc) или 0
    let env = reserve();
    if (nc > 0) {
        ev_i32(4 * nc); ev_call(ALLOC_FI()); ev_set(env);
    } else {
        ev_i32(0); ev_set(env);
    }
    let c = 0;
    while (c < nc) {
        let locali = find_local(cap_name_off(li, c), cap_name_len(li, c));
        if (locali >= 0) {
            ev_get(env); ev_i32(c * 4); emit_op(106);
            ev_get(locali);
            ev_store32();
        }
        c = c + 1;
    }
    // closure = alloc(8); [0]=table_slot(=индекс функции); [4]=env
    let cl = reserve();
    ev_i32(8); ev_call(ALLOC_FI()); ev_set(cl);
    ev_get(cl); ev_i32(lam_fn(li)); ev_store32();
    ev_get(cl); ev_i32(4); emit_op(106); ev_get(env); ev_store32();
    ev_get(cl);
    // Пропускаем тело лямбды до его конца (оно уже скомпилировано отдельно).
    set(0, 0, lam_body_end(li));
    set(0, 5, 1); tp(T_INT()); set(0, 8, -1);
    return 0;
}

// Косвенный вызов замыкания: callee — локаль, хранящая closure-указатель.
// events: env в локали, аргументы, индекс таблицы; всё через call_indirect.
fn emit_indirect_call(callee_slot) -> int {
    let base = get(0, 7);
    expect(20);                   // '('
    // env = [closure+4]: адрес сначала, затем load.
    ev_get(callee_slot); ev_i32(4); emit_op(106); ev_load32();
    let envl = reserve(); ev_set(envl);
    ev_get(envl);         // env — первый аргумент
    let argc = 0;
    while (tok_kind() != 21 && tok_kind() != 0) {
        set(0, 7, base);
        level_or();
        argc = argc + 1;
        if (tok_kind() == 24) { next_token(); }
    }
    expect(21);
    // table index = [closure+0]
    ev_get(callee_slot); ev_load32();
    emit_op(17); emit_leb(argc + 2); emit_op(0);    // call_indirect: тип арности argc+1 (env)
    set(0, 5, 1); set(0, 7, base); tp(T_INT()); set(0, 8, -1);
    return 0;
}

// ===== часть: 40d_expr_objects.lat =====
// --- эмиссия: match, select, new ---
// Ветвления по образцу (числа/строки/конструкторы/`_`), select-выражение
// (исполняется первая ветка) и создание объекта класса с init/new.

// match scrut { case pat: expr, ... }: цепочка IF/ELSE, значение на стеке.
// scrut сохраняется в локаль; каждый паттерн — условие, тело — ветвь THEN.
fn level_match() -> int {
    next_token();
    let scrut = reserve();
    level_or(); ev_set(scrut);
    expect(22);                        // {
    let out = reserve();               // результат match
    emit_match_arms(scrut, out);
    expect(23);                        // }
    ev_get(out);
    set(0, 5, 1); tp(T_INT());
    return 0;
}

// select-выражение: oracle исполняет тело ПЕРВОЙ ветки (переменная = 0),
// default — только если веток нет; выражения каналов не вычисляются.
fn level_select() -> int {
    next_token(); expect(22);                 // select {
    let out = reserve();
    if (tok_kind() == 98) {               // default: expr
        next_token(); expect(26);
        level_or(); ev_set(out);
        skip_to_rbrace(); expect(23);
        ev_get(out);
        set(0, 5, 1); tp(T_INT()); set(0, 8, -1);
        return 0;
    }
    if (tok_kind() == 23) {               // пустой select
        ev_i32(0); ev_set(out);
        expect(23);
        ev_get(out);
        set(0, 5, 1); tp(T_INT()); set(0, 8, -1);
        return 0;
    }
    if (tok_kind() == 97) { next_token(); }      // case
    if (is_ident_kind(tok_kind()) && tok_kind_at(1) == 106) {
        let voff = tok_val(); let vlen = tok_len();
        next_token(); next_token();                  // IDENT, <-
        let slot = get(0, 3);
        add_local(voff, vlen, slot);
        set_local_tp(slot, T_INT());
        store32(LOCCLS() + slot * 4, -1);
        ev_i32(0); ev_set(slot);
    } else {
        if (tok_kind() == 106) { next_token(); }
    }
    // Выражение канала не исполняется: эмитим и откатываем буфер.
    let save = blen(FNB()); let tsp = get(0, 7);
    if (tok_kind() != 26) { level_or(); }
    store32(FNB(), save); set(0, 7, tsp);
    expect(26);
    level_or(); ev_set(out);
    skip_to_rbrace(); expect(23);
    ev_get(out);
    set(0, 5, 1); tp(T_INT()); set(0, 8, -1);
    return 0;
}

fn emit_match_arms(scrut, out) -> int {
    while (tok_kind() != 23 && tok_kind() != 0) {
        if (tok_kind() == 24) { next_token(); }   // запятая между ветками
        if (tok_kind() == 97) { next_token(); }   // case
        set(0, 7, 0);
        // wildcard `_` или `default`
        if (tok_kind() == 98) { next_token(); expect(26); level_or(); ev_set(out); return 0; }
        if (is_ident_kind(tok_kind()) && ttext_is(tok_val(), tok_len(), "_", 1) && tok_kind_at(1) == 26) {
            next_token(); expect(26); level_or(); ev_set(out); return 0;
        }
        // паттерн
        let poff = tok_val(); let plen = tok_len();
        let isvar = is_ident_kind(tok_kind());
        if (isvar) {
            next_token();
            if (tok_kind() == 20) {
                // Конструктор: Tag(sub...)
                emit_ctor_test(poff, plen, scrut);
                emit_op(4); emit_op(64);              // if
                emit_bind_fields(scrut);
                expect(26); level_or(); ev_set(out);
                emit_op(5);                      // else
                emit_match_arms(scrut, out);
                emit_op(11);                     // end
                return 0;
            }
            if (tok_kind() == 26) {
                // Связывание: pat: expr
                expect(26);
                ev_get(scrut); ev_set(scrut);
                level_or(); ev_set(out);
                return 0;
            }
        }
        // числовой литерал
        if (tok_kind() == 1) {
            let v = tok_val(); next_token(); expect(26);
            ev_get(scrut); ev_i32(v); emit_op(70); emit_op(4); emit_op(64);
            level_or(); ev_set(out);
            emit_op(5); emit_match_arms(scrut, out); emit_op(11);
            return 0;
        }
        // строковый литерал — сравнение по содержимому (str_eq), как oracle
        if (tok_kind() == 3) {
            let q = tok_val(); let ql = tok_len();
            let addr = str_addr(q + 1, ql - 2);
            next_token(); expect(26);
            ev_get(scrut); ev_i32(addr);
            ev_call(SEQ_FI()); emit_op(4); emit_op(64);
            level_or(); ev_set(out);
            emit_op(5); emit_match_arms(scrut, out); emit_op(11);
            return 0;
        }
        err(); return 0;
    }
    ev_i32(0); ev_set(out);
    return 0;
}
// Условие «scrut это вариант Tag»: возвращает i32-условие на стеке.
fn emit_ctor_test(off, ln, scrut) -> int {
    let tag = variant_tag(off, ln);
    let ar = variant_arity(off, ln);
    if (ar == 0) {
        ev_get(scrut); ev_i32(tag); emit_op(70);
    } else {
        ev_get(scrut); ev_load32(); ev_i32(tag); emit_op(70);
    }
    return 0;
}
// Связывает под-паттерны конструктора из полей scrut (уже проверен THEN).
fn emit_bind_fields(scrut) -> int {
    // Имена под-паттернов идут сразу за именем конструктора в скобках.
    expect(20);
    let i = 0;
    while (tok_kind() != 21 && tok_kind() != 0) {
        if (is_ident_kind(tok_kind())) {
            let noff = tok_val(); let nlen = tok_len(); next_token();
            let slot = get(0, 3);
            add_local(noff, nlen, slot); set_local_tp(slot, T_INT()); store32(LOCCLS() + slot * 4, -1);
            ev_get(scrut); ev_i32(4 + i * 4); emit_op(106); ev_load32();
            ev_set(slot);
        } else { next_token(); }
        i = i + 1;
        if (tok_kind() == 24) { next_token(); }
    }
    expect(21);
    return 0;
}
fn ttext_is(off, ln, s, sn) -> bool { return is_lit(off, ln, s, sn); }

// new Class(args): bump-alloc(CLSZ); вызвать Class_init/_new (this первым).
fn level_new() -> int {
    next_token();
    let noff = tok_val(); let nlen = tok_len();
    expect_ident();
    let cls = class_idx_by_name(noff, nlen);
    if (cls < 0) { err(); tp(T_INT()); return 0; }
    let sz = load32(CLSZ() + cls * 4);
    let p = reserve();
    ev_i32(sz); ev_call(ALLOC_FI()); ev_set(p);
    expect(20);
    let ctor = find_method_named(cls, "init", 4);
    if (ctor < 0) { ctor = find_method_named(cls, "new", 3); }
    if (ctor >= 0) {
        ev_get(p);                    // this — первый аргумент
        while (tok_kind() != 21 && tok_kind() != 0) {
            set(0, 7, 0);
            level_or();
            if (tok_kind() == 24) { next_token(); }
        }
        ev_call(ctor + 1);
        if (fn_has_result(ctor)) { emit_op(26); }
    } else {
        while (tok_kind() != 21 && tok_kind() != 0) { set(0, 7, 0); level_or(); if (tok_kind() == 24) { next_token(); } }
    }
    expect(21);
    ev_get(p);
    set(0, 5, 1); tp(T_INT()); set(0, 8, cls);
    return 0;
}

// ===== часть: 40e_expr_postfix.lat =====
// --- эмиссия: постфиксные операции ---
// Индексация `a[i]` (байт строки vs элемент массива), `.length`, доступ к
// полю класса и вызов метода (push/pop/length/to_str/to_int).

// Постфиксные операции: индексация a[i] и поле .length.
fn level_postfix() -> int {
    let base = get(0, 7);
    level_primary();
    while (true) {
        let k = tok_kind();
        if (k == 80) {
            let ot = load32(TSTK() + base * 4);
            next_token(); level_or(); expect(81);
            if (ot == T_STR()) {
                // Индексация строки → байт-символ (str_char_at), не элемент массива.
                ev_call(SCHR_FI());
            } else {
                ev_i32(4); emit_op(108);   // idx*4
                emit_op(106);                        // obj + idx*4
                ev_i32(4); emit_op(106);    // + 4 (после заголовка длины)
                ev_load32();           // i32.load
            }
            set(0, 5, 1);
            set(0, 7, base); tp(T_INT());
        } else {
            if (k == 29) {
                next_token();
                let a = tok_val(); let al = tok_len();
                expect_ident();
                if (tok_kind() == 20) { level_method(a, al, base); }
                else {
                    if (is_lit(a, al, "length", 6)) { ev_load32(); set(0, 5, 1); set(0, 7, base); tp(T_INT()); }
                    else {
                        let cls = get(0, 8);
                        if (cls >= 0) {
                            // Доступ к полю класса: obj + offset → load.
                            let off = field_off(cls, a, al);
                            if (off < 0) { err(); }
                            else {
                                if (off > 0) { ev_i32(off); emit_op(106); }
                                ev_load32();
                                set(0, 5, 1); set(0, 7, base); tp(T_INT());
                            }
                        } else { err(); }
                    }
                }
            } else { return 0; }
        }
    }
    return 0;
}
// Метод-вызов obj.name(args). Объект уже лежит на стеке (из level_postfix);
// base — позиция его типа в TSTK. Поддерживаются: push(x), pop(), length(),
// to_str()/to_int() с учётом статического типа получателя (как oracle).
fn level_method(off, ln, base) -> int {
    // Метод класса: объект уже на стеке → сохранить как this, затем вызвать.
    let cls = get(0, 8);
    if (cls >= 0 && (tok_kind_at(0) == 20)) {
        if (emit_class_method(cls, off, ln, base) == 1) { return 0; }
    }
    if (is_lit(off, ln, "push", 4)) { return level_push_method(base); }
    if (is_lit(off, ln, "pop", 3)) { return level_pop_method(base); }
    if (is_lit(off, ln, "length", 6)) { return level_length_method(base); }
    if (is_lit(off, ln, "to_str", 6) || is_lit(off, ln, "toString", 8)) { return level_to_str_method(base); }
    if (is_lit(off, ln, "to_int", 6) || is_lit(off, ln, "toInt", 5)) { return level_to_int_method(base); }
    err_named("error: method '", off, ln, "' requires host runtime (engine #2)");
    set(0, 5, 0);
    return 0;
}

// Вызов метода класса: сохраняет объект как this и передаёт его первым
// аргументом; возвращает 1, если метод найден (0 — не метод класса).
fn emit_class_method(cls, off, ln, base) -> int {
    let mi = find_method(cls, off, ln);
    if (mi < 0) { return 0; }
    let tl = reserve(); ev_set(tl);
    let tbase = get(0, 7);
    expect(20);
    ev_get(tl);              // this первым
    while (tok_kind() != 21 && tok_kind() != 0) {
        set(0, 7, tbase);
        level_or();
        if (tok_kind() == 24) { next_token(); }
    }
    expect(21);
    ev_call(mi + 1);
    set(0, 5, 1); set(0, 7, base); tp(load32(FNRET() + mi * 4)); set(0, 8, -1);
    return 1;
}

fn level_push_method(base) -> int {
    let al = reserve(); ev_set(al);
    expect(20); level_or(); expect(21);
    let xl = reserve(); ev_set(xl);
    emit_push_seq(al, xl);
    set(0, 5, 1); set(0, 7, base); tp(T_INT());
    return 0;
}

fn level_pop_method(base) -> int {
    let al = reserve(); ev_set(al);
    expect(20); expect(21);
    emit_pop_seq(al);
    set(0, 5, 1); set(0, 7, base); tp(T_INT());
    return 0;
}

fn level_length_method(base) -> int {
    expect(20); expect(21);
    ev_load32();
    set(0, 5, 1); set(0, 7, base); tp(T_INT());
    return 0;
}

// to_str() по статическому типу получателя: float → f64_to_str, иначе
// int → i32_to_str, строка — без изменений (как oracle).
fn level_to_str_method(base) -> int {
    expect(20); expect(21);
    let rt = load32(TSTK() + base * 4);
    if (rt == T_FLT()) { ev_call(F64S_FI()); }
    else { if (rt != T_STR()) { ev_call(I32S_FI()); } }
    set(0, 5, 1); set(0, 7, base); tp(T_STR());
    return 0;
}

// to_int(): строка → str_to_i32, float → i32.trunc_f64_s, int — как есть.
fn level_to_int_method(base) -> int {
    expect(20); expect(21);
    let rt = load32(TSTK() + base * 4);
    if (rt == T_STR()) { ev_call(S2I_FI()); }
    else { if (rt == T_FLT()) { emit_op(I32_TRUNC_F64_OP()); } }
    set(0, 5, 1); set(0, 7, base); tp(T_INT());
    return 0;
}

// ===== часть: 40f_expr_assign.lat =====
// --- эмиссия: унарные выражения, массивы, присваивания ---
// Унарный минус/`!`, литерал массива, присваивание в переменную/индекс/
// канал и вход в Pratt-парсер (level_or).

fn level_unary() -> int { return level_postfix(); }

// Число элементов литерала массива: текущий токен — '['. Сканируем до
// парной ']', считая запятые на глубине 1. `[]` -> 0, `[x]` -> 1.
fn count_elems() -> int {
    let j = get(0, 0);              // текущий токен — первый элемент (или ']')
    let depth = 1; let c = 0; let any = 0;
    while (depth > 0) {
        let k = load32(KIND() + j * 4);
        if (k == 0) { return c; }
        if (k == 80) { depth = depth + 1; }
        else {
            if (k == 81) { depth = depth - 1; }
            else {
                if (depth == 1) {
                    if (k == 24) { c = c + 1; }
                    else { any = 1; }
                }
            }
        }
        j = j + 1;
    }
    if (any == 0) { return 0; }
    return c + 1;
}

// Литерал массива [e0, e1, ...] -> [len u32][e0][e1]... в линейной памяти.
fn level_array() -> int {
    let base = get(0, 7);
    next_token();
    let cnt = count_elems();
    let size = 4 + cnt * 4;
    let t = reserve();
    ev_i32(size);
    ev_call(ALLOC_FI());
    ev_set(t);
    ev_get(t); ev_i32(cnt); ev_store32();
    let i = 0;
    set(0, 7, base + 1);
    while (tok_kind() != 81 && tok_kind() != 0) {
        set(0, 7, base + 1);
        ev_get(t); ev_i32(4 + i * 4); emit_op(106);
        level_or();
        ev_store32();
        i = i + 1;
        if (tok_kind() == 24) { next_token(); }
    }
    expect(81);
    ev_get(t);
    set(0, 5, 1);
    set(0, 7, base); tp(T_INT());
    return 0;
}

fn parse_assign() -> int {
    let noff = tok_val(); let nlen = tok_len();
    next_token(); next_token();
    level_or();
    let vt = tpop();
    let li = find_local(noff, nlen);
    if (li < 0) { err(); } else { ev_set(li); ev_get(li); set_local_tp(li, vt); }
    set(0, 5, 1);
    tp(vt);
    return 0;
}

// ch <- v — отправка в канал: host-рантайм движка №1 (ошибка с тем же
// смыслом, что у oracle; правый операнд разбираем для целостности парсера).
fn parse_send() -> int {
    next_token(); next_token();                        // IDENT, <-
    level_or();
    err_named("error: channel operations require host runtime (engine #1)", 0, 0, "");
    set(0, 5, 1); tp(T_INT());
    return 0;
}

fn level_or() -> int {
    if (is_ident_kind(tok_kind()) && tok_kind_at(1) == 27) { return parse_assign(); }
    if (is_ident_kind(tok_kind()) && tok_kind_at(1) == 106) { return parse_send(); }
    if (is_index_assign()) { return parse_index_assign(); }
    let base = get(0, 7);
    level_and();
    while (tok_kind() == 47) {
        next_token();
        emit_op(4); emit_op(127); ev_i32(1); emit_op(5);
        level_and();
        emit_op(69); emit_op(69);
        emit_op(11);
        set(0, 7, base); tp(T_INT());
    }
    return 0;
}

// Проверка «ident [ ... ]* = ...». Возвращает true только если после
// цепочки индексов идёт '='; иначе это обычное rvalue-выражение.
fn is_index_assign() -> bool {
    if (!is_ident_kind(tok_kind())) { return false; }
    let j = get(0, 0) + 1;
    let groups = 0;
    while (load32(KIND() + j * 4) == 80) {
        let depth = 0;
        let done = 0;
        while (done == 0) {
            let k = load32(KIND() + j * 4);
            if (k == 0) { return false; }
            if (k == 80) { depth = depth + 1; }
            else {
                if (k == 81) { depth = depth - 1; if (depth == 0) { j = j + 1; done = 1; } }
            }
            if (done == 0) { j = j + 1; }
        }
        groups = groups + 1;
    }
    if (groups == 0) { return false; }
    return load32(KIND() + j * 4) == 27;
}

// Присваивание в элемент a[i] = v (в т.ч. цепочка a[i][j] = v).
// Для промежуточных уровней загружаем указатель, на последнем — store.
fn parse_index_assign() -> int {
    let noff = tok_val(); let nlen = tok_len();
    next_token();
    let base = find_local(noff, nlen);
    if (base < 0) { err(); return 0; }
    let cur = reserve();
    ev_get(base); ev_set(cur);
    while (tok_kind() == 80) {
        next_token(); level_or(); expect(81);
        let idx = reserve(); ev_set(idx);
        if (tok_kind() == 80) {
            ev_get(cur);
            ev_get(idx); ev_i32(4); emit_op(108); emit_op(106);
            ev_i32(4); emit_op(106);
            ev_load32();
            ev_set(cur);
        } else {
            expect(27);
            level_or();
            let val = reserve(); ev_set(val);
            ev_get(cur);
            ev_get(idx); ev_i32(4); emit_op(108); emit_op(106);
            ev_i32(4); emit_op(106);
            ev_get(val);
            ev_store32();
            ev_get(val);
            set(0, 5, 1);
            tp(T_INT());
        }
    }
    return 0;
}

// ===== часть: 40g_expr_operators.lat =====
// --- эмиссия: бинарные уровни Pratt-парсера ---
// &&/|| с коротким замыканием, ==/!=, сравнения, битовые, сдвиги,
// + - * / % с выбором i32/f64-опкодов и конкатенацией строк.

// Чистые отображения «токен оператора → WASM-опкод»: результат зависит только
// от аргумента, поэтому таблицы проверяются отдельно от эмиссии.
fn eq_opcode(k) -> int { if (k == 40) { return 70; } return 71; }
fn cmp_opcode(k) -> int { if (k == 42) { return 72; } if (k == 43) { return 74; } if (k == 44) { return 76; } return 78; }
fn f64_cmp_opcode(k) -> int {
    if (k == 42) { return F64_LT_OP(); }
    if (k == 43) { return F64_GT_OP(); }
    if (k == 44) { return F64_LE_OP(); }
    return F64_GE_OP();
}
fn bit_opcode(k) -> int { if (k == 48) { return 113; } if (k == 49) { return 114; } return 115; }
fn shift_opcode(k) -> int { if (k == 51) { return 116; } return 117; }
fn int_arith_opcode(k) -> int {
    if (k == 30) { return 106; }
    if (k == 31) { return 107; }
    if (k == 32) { return 108; }
    if (k == 33) { return 109; }
    return 111;
}
fn f64_arith_opcode(k) -> int {
    if (k == 30) { return F64_ADD_OP(); }
    if (k == 31) { return F64_SUB_OP(); }
    if (k == 32) { return F64_MUL_OP(); }
    return F64_DIV_OP();
}

fn level_and() -> int {
    let base = get(0, 7);
    level_eq();
    while (tok_kind() == 46) {
        next_token();
        emit_op(4); emit_op(127);
        level_eq();
        emit_op(69); emit_op(69);
        emit_op(5); ev_i32(0);
        emit_op(11);
        set(0, 7, base); tp(T_INT());
    }
    return 0;
}
// Каждый уровень фиксирует base стека типов до левого операнда; типы операндов
// лежат по base и base+1, результат — по base. Устойчиво к несбалансировке.
fn level_eq() -> int {
    let base = get(0, 7);
    level_cmp();
    while (tok_kind() == 40 || tok_kind() == 41) {
        let k = tok_kind(); next_token();
        let lt = load32(TSTK() + base * 4);
        level_cmp();
        let rt = load32(TSTK() + (base + 1) * 4);
        if (lt == T_STR() || rt == T_STR()) {
            // Сравнение строк по содержимому (str_eq), как в oracle.
            ev_call(SEQ_FI());
            if (k == 41) { emit_op(69); }
        } else {
            emit_op(eq_opcode(k));
        }
        set(0, 7, base); tp(T_INT());
    }
    return 0;
}
fn level_cmp() -> int {
    let base = get(0, 7);
    level_bit();
    while (tok_kind() == 42 || tok_kind() == 43 || tok_kind() == 44 || tok_kind() == 45) {
        let k = tok_kind(); next_token();
        let lt = load32(TSTK() + base * 4);
        level_bit();
        let rt = load32(TSTK() + (base + 1) * 4);
        if (lt == T_FLT() || rt == T_FLT()) {
            if (lt != rt) { promote_pair(base, lt, rt); }
            emit_op(f64_cmp_opcode(k));
        } else {
            emit_op(cmp_opcode(k));
        }
        set(0, 7, base); tp(T_INT());
    }
    return 0;
}
fn level_bit() -> int {
    let base = get(0, 7);
    level_shift();
    while (tok_kind() == 48 || tok_kind() == 49 || tok_kind() == 50) {
        let k = tok_kind(); next_token();
        level_shift();
        emit_op(bit_opcode(k));
        set(0, 7, base); tp(T_INT());
    }
    return 0;
}
fn level_shift() -> int {
    let base = get(0, 7);
    level_add();
    while (tok_kind() == 51 || tok_kind() == 52) {
        let k = tok_kind(); next_token();
        level_add();
        emit_op(shift_opcode(k));
        set(0, 7, base); tp(T_INT());
    }
    return 0;
}
fn level_add() -> int {
    let base = get(0, 7);
    level_mul();
    while (tok_kind() == 30 || tok_kind() == 31) {
        let k = tok_kind(); next_token();
        let lt = load32(TSTK() + base * 4);
        level_mul();
        let rt = load32(TSTK() + (base + 1) * 4);
        if (k == 30 && (lt == T_STR() || rt == T_STR())) {
            // Конкатенация строк: "+" над строками — не арифметика.
            // Не-строковый операнд коэрцится в строку (i32_to_str), как oracle.
            let rl = reserve(); ev_set(rl);
            let ll = reserve(); ev_set(ll);
            ev_get(ll); if (lt != T_STR()) { ev_call(I32S_FI()); }
            ev_get(rl); if (rt != T_STR()) { ev_call(I32S_FI()); }
            ev_call(SCAT_FI());
            set(0, 7, base); tp(T_STR());
        } else {
            if (lt == T_FLT() || rt == T_FLT()) {
                // '-' у float в oracle не проходит, но эмитим корректный f64.
                if (lt != rt) { promote_pair(base, lt, rt); }
                emit_op(f64_arith_opcode(k));
                set(0, 7, base); tp(T_FLT());
            } else {
                emit_op(int_arith_opcode(k));
                set(0, 7, base); tp(T_INT());
            }
        }
    }
    return 0;
}
fn level_mul() -> int {
    let base = get(0, 7);
    level_unary();
    while (tok_kind() == 32 || tok_kind() == 33 || tok_kind() == 34) {
        let k = tok_kind(); next_token();
        let lt = load32(TSTK() + base * 4);
        level_unary();
        let rt = load32(TSTK() + (base + 1) * 4);
        if (lt == T_FLT() || rt == T_FLT()) {
            // Смешанные операнды: перекладываем в локали и повышаем int→f64.
            if (lt != rt) { promote_pair(base, lt, rt); }
            if (k == 34) { err(); } else { emit_op(f64_arith_opcode(k)); }
            set(0, 7, base); tp(T_FLT());
        } else {
            emit_op(int_arith_opcode(k));
            set(0, 7, base); tp(T_INT());
        }
    }
    return 0;
}

// ===== часть: 45a_tc_core.lat =====
// ============================ ТАЙП-ЧЕКЕР: ЯДРО ============================
// Теги типов, канал ошибок (ERRB), курсор токенов, таблица переменных
// со слоями видимости и разбор аннотаций типов.

// ============================ ТАЙП-ЧЕКЕР ============================
// Отдельный проход после лексера/регистрации: строит таблицу переменных с
// типами и проверяет аннотации, возвраты, арность вызовов, условия. При
// ошибке выставляет status=1 и пишет сообщение в ERRB; кодоген тогда
// пропускается, а хост получает текст ошибки вместо WASM.

// Тег типа (совместим с oracle: числа = NUM, int/float взаимозаменяемы).
fn TY_UNK() -> int { return 0; }
fn TY_NUM() -> int { return 1; }
fn TY_BOOL() -> int { return 2; }
fn TY_STR() -> int { return 3; }
fn TY_UNIT() -> int { return 4; }
fn TY_ARRAY() -> int { return 5; }
fn TY_FN() -> int { return 6; }
fn TY_NAMED() -> int { return 7; }

// Копирует строку-сообщение в ERRB как [len][bytes], читая символы через
// индексацию (s[i]) — так oracle-инференс не связывает параметр с числом.
fn tcerr_msg(s: string) -> int {
    let n = len(s);
    store32(ERRB(), n);
    let i = 0;
    while (i < n) { store8(ERRB() + 4 + i, s[i]); i = i + 1; }
    return 0;
}
fn tcerr(msg: string) -> int {
    if (get(0, 4) == 0) { tcerr_msg(msg); set(0, 4, 1); }
    return 0;
}
// Ошибка с подстановкой имени: pre + <имя из исходника> + post.
// Пишет [len][utf8] в ERRB и включает статус; используется кодогеном для
// ошибок с именем конструкции (undefined variable/function/method, builtin).
fn err_named(pre: string, off, ln, post: string) -> int {
    if (get(0, 4) == 0) {
        binit(ERRB());
        let i = 0;
        while (i < len(pre)) { bput(ERRB(), pre[i]); i = i + 1; }
        i = 0;
        while (i < ln) { bput(ERRB(), load8(INPUT() + 4 + off + i)); i = i + 1; }
        i = 0;
        while (i < len(post)) { bput(ERRB(), post[i]); i = i + 1; }
    }
    set(0, 4, 1);
    return 0;
}
fn tc_kind() -> int { return load32(KIND() + get(0, 9) * 4); }
fn tck_at(d) -> int { return load32(KIND() + (get(0, 9) + d) * 4); }
fn tc_next() -> int { return set(0, 9, get(0, 9) + 1); }
fn tc_is_tok(k) -> bool { return k == 2 || (k >= 10 && k <= 19); }

// --- таблица переменных типов ---
fn tv_add(off, ln, ty, aux, np) -> int {
    let i = get(0, 10);
    store32(TV_OFF() + i * 4, off); store32(TV_LEN() + i * 4, ln);
    store32(TV_TY() + i * 4, ty); store32(TV_AUX() + i * 4, aux);
    store32(TV_NP() + i * 4, np); store32(TV_NEST() + i * 4, get(0, 11));
    set(0, 10, i + 1);
    return i;
}
fn tv_find(off, ln) -> int {
    let i = get(0, 10) - 1;
    while (i >= 0) {
        if (name_eq(off, ln, load32(TV_OFF() + i * 4), load32(TV_LEN() + i * 4))) { return i; }
        i = i - 1;
    }
    return -1;
}
fn tc_enter() -> int { return set(0, 11, get(0, 11) + 1); }
fn tc_exit() -> int {
    let d = get(0, 11);
    while (get(0, 10) > 0 && load32(TV_NEST() + (get(0, 10) - 1) * 4) >= d) { set(0, 10, get(0, 10) - 1); }
    set(0, 11, d - 1);
    return 0;
}

// --- аннотация типа -> тег ---
fn tc_ann() -> int {
    let k = tc_kind();
    if (tc_is_tok(k)) {
        let off = load32(TVAL() + get(0, 9) * 4); let ln = load32(TLEN() + get(0, 9) * 4);
        tc_next();
        if (is_lit(off, ln, "int", 3) || is_lit(off, ln, "float", 5)) { return TY_NUM(); }
        if (is_lit(off, ln, "bool", 4)) { return TY_BOOL(); }
        if (is_lit(off, ln, "string", 6)) { return TY_STR(); }
        if (is_lit(off, ln, "void", 4) || is_lit(off, ln, "unit", 4)) { return TY_UNIT(); }
        return TY_NAMED();
    }
    return TY_UNK();
}

// ===== часть: 45b_tc_expr.lat =====
// ============================ ТАЙП-ЧЕКЕР: ВЫРАЖЕНИЯ ============================
// Вывод типа выражения по токенам: литералы, вызовы и арность, постфиксные
// операции, лямбды и бинарные уровни приоритета.

// --- вычисление типа выражения по токенам ---
// Упрощённый, но достаточный для приёмки/отклонения: возвращает тег.
fn tc_expr() -> int {
    // Присваивание в переменную: IDENT = expr (не в поле/индекс).
    if (tc_is_tok(tc_kind()) && tck_at(1) == 27) {
        let noff = load32(TVAL() + get(0, 9) * 4); let nlen = load32(TLEN() + get(0, 9) * 4);
        tc_next(); tc_next();                    // IDENT '='
        let vt = tc_expr();
        let vi = tv_find(noff, nlen);
        if (vi >= 0) {
            let want = load32(TV_TY() + vi * 4);
            if (want != TY_UNK() && vt != TY_UNK() && want != vt) { tcerr("error: type mismatch"); }
        }
        return vt;
    }
    let t = tc_binary();
    // тернарный `?` не поддерживается языком
    return t;
}
fn tc_primary() -> int {
    let k = tc_kind();
    if (k == 1) { tc_next(); return TY_NUM(); }
    if (k == 4) { tc_next(); return TY_NUM(); }   // литерал float
    if (k == 3) { tc_next(); return TY_STR(); }
    if (k == 90 || k == 91) { tc_next(); return TY_BOOL(); }
    if (k == 107) { tc_next(); return TY_UNK(); }          // null
    if (k == 103) { tc_next(); return tc_unary_operand(); } // await — passthrough
    if (k == 106) { tc_next(); tc_unary_operand(); return TY_UNK(); }   // <-ch
    if (k == 20) { tc_next(); let t = tc_expr(); if (tc_kind() == 21) { tc_next(); } return t; }
    if (k == 80) {               // литерал массива
        tc_next();
        while (tc_kind() != 81 && tc_kind() != 0) { tc_expr(); if (tc_kind() == 24) { tc_next(); } }
        if (tc_kind() == 81) { tc_next(); }
        return TY_ARRAY();
    }
    if (k == 31) { tc_next(); tc_unary_operand(); return TY_NUM(); }   // -x
    if (k == 53) { tc_next(); tc_unary_operand(); return TY_BOOL(); }  // !x
    if (k == 94) { tc_next(); return TY_NAMED(); }   // this
    if (k == 93) {                                // new Class
        tc_next(); tc_next();                             // new IDENT
        if (tc_kind() == 20) { tc_arglist(); }
        return TY_NAMED();
    }
    if (k == 95) { return tc_match(); }
    if (k == 104) { return tc_select_expr(); }
    if (k == 11) { return tc_lambda(); }
    if (tc_is_tok(k)) {
        let off = load32(TVAL() + get(0, 9) * 4); let ln = load32(TLEN() + get(0, 9) * 4);
        // ai_generate!("prompt") — AI-примитив (в кодогене — host-ошибка).
        if (tck_at(1) == 53 && is_lit(off, ln, "ai_generate", 11)) {
            tc_next(); tc_next();                       // ai_generate, '!'
            if (tc_kind() == 20) { tc_next(); if (tc_kind() == 3) { tc_next(); } if (tc_kind() == 21) { tc_next(); } }
            return TY_STR();
        }
        // channel<T>() — generic-параметр потребляем, тип не важен (host-ошибка).
        if (tck_at(1) == 42 && is_lit(off, ln, "channel", 7)) {
            tc_next(); tc_next();                       // channel, <
            while (tc_kind() != 43 && tc_kind() != 0) { tc_next(); }
            if (tc_kind() == 43) { tc_next(); }
            if (tc_kind() == 20) { tc_arglist(); }
            return TY_UNK();
        }
        // вызов функции?
        if (tck_at(1) == 20) { tc_next(); return tc_call(off, ln); }
        // 0-арный enum-вариант
        if (variant_tag(off, ln) >= 0) { tc_next(); return TY_NAMED(); }
        tc_next();
        let vi = tv_find(off, ln);
        if (vi >= 0) { return load32(TV_TY() + vi * 4); }
        let fi = find_func(off, ln);
        if (fi >= 0) { return TY_FN(); }
        // Внутри лямбды свободное имя может быть захватом внешней переменной —
        // не считаем это ошибкой (захваты вычисляются отдельным проходом).
        if (get(0, 12) == 0) { err_named("error: undefined variable: ", off, ln, ""); }
        return TY_UNK();
    }
    return TY_UNK();
}
fn tc_unary_operand() -> int { return tc_primary(); }

fn tc_arglist() -> int {
    // текущий токен — '('
    tc_next();
    while (tc_kind() != 21 && tc_kind() != 0) { tc_expr(); if (tc_kind() == 24) { tc_next(); } }
    if (tc_kind() == 21) { tc_next(); }
    return 0;
}

// Тип вызова: арность + возвращаемый тип.
fn tc_call(off, ln) -> int {
    // встроенные — вариативные, проверяем только аргументы
    if (is_builtin_tyname(off, ln)) { tc_arglist(); return tc_builtin_ret(off, ln); }
    if (variant_tag(off, ln) >= 0) { tc_arglist(); return TY_NAMED(); }
    let fi = find_func(off, ln);
    if (fi < 0) {
        // Локаль/параметр, вызываемый как функция (замыкание или колбэк):
        // принимаем без строгой проверки типа результата.
        let vi = tv_find(off, ln);
        if (vi >= 0) { tc_arglist(); return TY_UNK(); }
        err_named("error: undefined function: ", off, ln, "");
        tc_arglist();
        return TY_UNK();
    }
    let want = load32(FNNP() + fi * 4);
    // считаем аргументы
    let cnt = 0;
    tc_next();                       // '('
    while (tc_kind() != 21 && tc_kind() != 0) {
        tc_expr();
        cnt = cnt + 1;
        if (tc_kind() == 24) { tc_next(); }
    }
    if (tc_kind() == 21) { tc_next(); }
    if (cnt != want) { tcerr("error: arity mismatch"); }
    return load32(FRETTY() + fi * 4);
}

fn is_builtin_tyname(off, ln) -> bool {
    // Host-builtins (AI/tensor/каналы) принимаем при типизации: осмысленную
    // ошибку про host-рантайм выдаёт кодоген — как в oracle.
    if (is_host_builtin(off, ln)) { return true; }
    if (is_lit(off, ln, "print", 5)) { return true; }
    if (is_lit(off, ln, "len", 3)) { return true; }
    if (is_lit(off, ln, "push", 4)) { return true; }
    if (is_lit(off, ln, "str", 3)) { return true; }
    if (is_lit(off, ln, "int", 3)) { return true; }
    if (is_lit(off, ln, "float", 5)) { return true; }
    if (is_lit(off, ln, "sqrt", 4)) { return true; }
    if (is_lit(off, ln, "int", 3)) { return true; }
    if (is_lit(off, ln, "assert", 6)) { return true; }
    if (is_lit(off, ln, "assert_eq", 9)) { return true; }
    if (is_lit(off, ln, "alloc", 5)) { return true; }
    if (is_lit(off, ln, "load8", 5)) { return true; }
    if (is_lit(off, ln, "load32", 6)) { return true; }
    if (is_lit(off, ln, "store8", 6)) { return true; }
    if (is_lit(off, ln, "store32", 7)) { return true; }
    if (is_lit(off, ln, "memcopy", 7)) { return true; }
    return false;
}
fn tc_builtin_ret(off, ln) -> int {
    if (is_host_builtin(off, ln)) { return TY_UNK(); }
    if (is_lit(off, ln, "len", 3)) { return TY_NUM(); }
    if (is_lit(off, ln, "str", 3)) { return TY_STR(); }
    if (is_lit(off, ln, "int", 3)) { return TY_NUM(); }
    if (is_lit(off, ln, "float", 5)) { return TY_NUM(); }
    if (is_lit(off, ln, "sqrt", 4)) { return TY_NUM(); }
    if (is_lit(off, ln, "alloc", 5)) { return TY_NUM(); }
    if (is_lit(off, ln, "load8", 5)) { return TY_NUM(); }
    if (is_lit(off, ln, "load32", 6)) { return TY_NUM(); }
    return TY_UNIT();
}

// Операторы: результат по oracle (числа/сравнения/логика/биты).
fn tc_binary() -> int { return tc_bin(0); }

// Уровни по возрастанию приоритета: or,and,eq,cmp,bit,shift,add,mul,postfix.
fn tc_bin(level) -> int {
    if (level >= 8) { return tc_postfix(); }
    let base = tc_bin(level + 1);
    while (is_op_at(level, tc_kind())) {
        let op = tc_kind(); tc_next();
        let lt = base;
        let rt = tc_bin(level + 1);
        // "+" над строкой (любой стороной) даёт строку, как в oracle.
        if (op == 30 && (lt == TY_STR() || rt == TY_STR())) { base = TY_STR(); }
        else { base = op_result(op); }
    }
    return base;
}
fn is_op_at(level, k) -> bool {
    if (level == 0) { return k == 47; }                          // ||
    if (level == 1) { return k == 46; }                          // &&
    if (level == 2) { return k == 40 || k == 41; }               // == !=
    if (level == 3) { return k == 42 || k == 43 || k == 44 || k == 45; }
    if (level == 4) { return k == 48 || k == 49 || k == 50; }
    if (level == 5) { return k == 51 || k == 52; }
    if (level == 6) { return k == 30 || k == 31; }               // + -
    if (level == 7) { return k == 32 || k == 33 || k == 34; }    // * / %
    return false;
}
fn op_result(op) -> int {
    if (op == 40 || op == 41) { return TY_BOOL(); }
    if (op == 42 || op == 43 || op == 44 || op == 45) { return TY_BOOL(); }
    if (op == 46 || op == 47) { return TY_BOOL(); }
    if (op == 48 || op == 49 || op == 50) { return TY_NUM(); }
    if (op == 51 || op == 52) { return TY_NUM(); }
    return TY_NUM();
}
fn tc_postfix() -> int {
    let t = tc_primary();
    while (true) {
        let k = tc_kind();
        if (k == 80) {                       // индексация
            tc_next(); tc_expr();
            if (tc_kind() == 81) { tc_next(); }
            t = TY_NUM();
        } else {
            if (k == 29) {                   // .field / .method()
                tc_next();
                if (tc_is_tok(tc_kind())) { tc_next(); }
                if (tc_kind() == 20) { tc_next(); while (tc_kind() != 21 && tc_kind() != 0) { tc_expr(); if (tc_kind() == 24) { tc_next(); } } if (tc_kind() == 21) { tc_next(); } t = TY_NUM(); }
                else { t = TY_NUM(); }
            } else { return t; }
        }
    }
    return t;
}

fn tc_lambda() -> int {
    tc_next();                        // fn
    set(0, 12, get(0, 12) + 1);   // внутри лямбды свободные имена — захваты
    tc_enter();                   // область параметров лямбды
    if (tc_kind() == 20) {
        tc_next();
        while (tc_kind() != 21 && tc_kind() != 0) {
            if (tc_is_tok(tc_kind())) {
                let po = load32(TVAL() + get(0, 9) * 4); let pl = load32(TLEN() + get(0, 9) * 4);
                tc_next();
                let pt = TY_UNK();
                if (tc_kind() == 26) { tc_next(); pt = tc_ann(); }
                tv_add(po, pl, pt, TY_UNK(), 0);
            }
            if (tc_kind() == 24) { tc_next(); }
        }
        if (tc_kind() == 21) { tc_next(); }
    }
    if (tc_kind() == 28) { tc_next(); tc_ann(); }
    if (tc_kind() == 99) { tc_next(); tc_expr(); }
    else {
        if (tc_kind() == 22) { tc_next(); tc_block(); if (tc_kind() == 23) { tc_next(); } }
    }
    tc_exit();
    set(0, 12, get(0, 12) - 1);
    return TY_FN();
}
fn skip_braces() -> int {
    if (tc_kind() != 22) { return 0; }
    let d = 0;
    while (tc_kind() != 0) {
        let k = tc_kind();
        if (k == 22) { d = d + 1; }
        else { if (k == 23) { d = d - 1; } }
        tc_next();
        if (d == 0) { return 0; }
    }
    return 0;
}

// ===== часть: 45c_tc_flow.lat =====
// ============================ ТАЙП-ЧЕКЕР: MATCH И ИНСТРУКЦИИ ============================
// match, ветки инструкций (let/return/if/while/for/spawn/yield/test/select)
// и блоки; области видимости открываются и закрываются tc_enter/tc_exit.

fn tc_match() -> int {
    tc_next();                        // match
    tc_expr();                    // scrutinee
    if (tc_kind() == 22) { tc_next(); }
    let rt = TY_UNK();
    while (tc_kind() != 23 && tc_kind() != 0) {
        let before = get(0, 9);
        if (tc_kind() == 24) { tc_next(); }
        if (tc_kind() == 97) { tc_next(); }
        if (tc_kind() == 98) { tc_next(); }        // default
        // паттерн: литерал / идентификатор / конструктор / _
        if (tc_is_tok(tc_kind())) {
            tc_next();
            if (tc_kind() == 20) {
                tc_next();
                while (tc_kind() != 21 && tc_kind() != 0) {
                    // Связываем имя под-паттерна конструктора как переменную.
                    if (tc_is_tok(tc_kind())) {
                        let so = load32(TVAL() + get(0, 9) * 4); let sl = load32(TLEN() + get(0, 9) * 4);
                        tc_next(); tv_add(so, sl, TY_UNK(), TY_UNK(), 0);
                    } else { tc_next(); }
                    if (tc_kind() == 24) { tc_next(); }
                }
                if (tc_kind() == 21) { tc_next(); }
            }
        } else { if (tc_kind() == 1 || tc_kind() == 3 || tc_kind() == 90 || tc_kind() == 91) { tc_next(); } }
        if (tc_kind() == 26) { tc_next(); }
        rt = tc_expr();
        if (get(0, 9) == before) { tc_next(); }   // защита от зацикливания
    }
    if (tc_kind() == 23) { tc_next(); }
    return rt;
}

// --- инструкции ---
fn tc_stmt() -> int {
    let k = tc_kind();
    if (k == 10) { return tc_let(); }
    if (k == 15) { return tc_return(); }
    if (k == 12) { return tc_if(); }
    if (k == 14) { return tc_while(); }
    if (k == 16) { return tc_for(); }
    if (k == 100) { return tc_spawn(); }
    if (k == 101) { return tc_yield(); }
    if (k == 104) { return tc_select_stmt(); }
    if (k == 105) { return tc_test(); }
    if (k == 25) { tc_next(); return 0; }
    // выражение-инструкция (в т.ч. присваивание)
    tc_expr();
    if (tc_kind() == 25) { tc_next(); }
    return 0;
}
fn tc_let() -> int {
    tc_next();                        // let
    let noff = load32(TVAL() + get(0, 9) * 4); let nlen = load32(TLEN() + get(0, 9) * 4);
    tc_next();                        // IDENT
    let ann = TY_UNK();
    if (tc_kind() == 26) { tc_next(); ann = tc_ann(); }
    let vt = TY_UNK();
    if (tc_kind() == 27) { tc_next(); vt = tc_expr(); }
    if (tc_kind() == 25) { tc_next(); }
    if (ann != TY_UNK() && vt != TY_UNK() && ann != vt) { tcerr("error: type mismatch"); }
    if (ann == TY_UNK()) { ann = vt; }
    tv_add(noff, nlen, ann, TY_UNK(), 0);
    return 0;
}
fn tc_return() -> int {
    tc_next();                        // return
    let rt = TY_UNK();
    if (tc_kind() != 25 && tc_kind() != 23 && tc_kind() != 0) { rt = tc_expr(); }
    if (tc_kind() == 25) { tc_next(); }
    let want = load32(FRETTY() + load32(TCCUR()) * 4);
    if (rt != TY_UNK() && want != TY_UNK() && want != TY_UNIT() && rt != want) { tcerr("error: return type mismatch"); }
    return 0;
}
fn tc_if() -> int {
    tc_next(); if (tc_kind() == 20) { tc_next(); let c = tc_expr(); if (c != TY_BOOL() && c != TY_UNK()) { tcerr("error: condition must be bool"); } if (tc_kind() == 21) { tc_next(); } }
    tc_enter(); if (tc_kind() == 22) { tc_next(); tc_block(); if (tc_kind() == 23) { tc_next(); } } tc_exit();
    if (tc_kind() == 13) { tc_next(); if (tc_kind() == 12) { tc_if(); } else { tc_enter(); if (tc_kind() == 22) { tc_next(); tc_block(); if (tc_kind() == 23) { tc_next(); } } tc_exit(); } }
    return 0;
}
fn tc_while() -> int {
    tc_next(); if (tc_kind() == 20) { tc_next(); let c = tc_expr(); if (c != TY_BOOL() && c != TY_UNK()) { tcerr("error: condition must be bool"); } if (tc_kind() == 21) { tc_next(); } }
    tc_enter(); if (tc_kind() == 22) { tc_next(); tc_block(); if (tc_kind() == 23) { tc_next(); } } tc_exit();
    return 0;
}
fn tc_for() -> int {
    tc_next(); if (tc_kind() == 20) { tc_next(); }     // for (
    tc_enter();
    // for (let x in arr) — for-in.
    if (tc_kind() == 10 && is_for_in_tc()) { return tc_for_in(); }
    if (tc_kind() == 10) { tc_let(); } else { if (tc_kind() != 25) { tc_expr(); if (tc_kind() == 25) { tc_next(); } } else { tc_next(); } }
    if (tc_kind() != 25) { tc_expr(); }
    if (tc_kind() == 25) { tc_next(); }
    if (tc_kind() != 21) { tc_expr(); }
    if (tc_kind() == 21) { tc_next(); }
    if (tc_kind() == 22) { tc_next(); tc_block(); if (tc_kind() == 23) { tc_next(); } }
    tc_exit();
    return 0;
}
// `let IDENT [: T] in` — признак for-in (текущий токен — `let`).
fn is_for_in_tc() -> bool {
    if (tc_kind() != 10 || !tc_is_tok(tck_at(1))) { return false; }
    let j = 2;
    if (tck_at(j) == 26) { j = j + 1; while (tck_at(j) != 17 && tck_at(j) != 27 && tck_at(j) != 0 && j < 40) { j = j + 1; } }
    return tck_at(j) == 17;
}
fn tc_for_in() -> int {
    tc_next();                        // let
    let vo = load32(TVAL() + get(0, 9) * 4); let vl = load32(TLEN() + get(0, 9) * 4);
    tc_next();                        // IDENT
    if (tc_kind() == 26) { tc_next(); tc_ann(); }
    if (tc_kind() == 17) { tc_next(); }    // in
    let it = tc_expr();            // iterable
    // oracle требует массив: строка в for-in — ошибка типов (а не байты).
    if (it == TY_STR()) { tcerr("error: type mismatch"); }
    tv_add(vo, vl, TY_NUM(), TY_UNK(), 0);
    if (tc_kind() == 21) { tc_next(); }
    if (tc_kind() == 22) { tc_next(); tc_block(); if (tc_kind() == 23) { tc_next(); } }
    tc_exit();
    return 0;
}

// spawn { ... } / spawn expr; — тело проверяется в новой области, как oracle.
fn tc_spawn() -> int {
    tc_next();
    tc_enter();
    if (tc_kind() == 22) { tc_next(); tc_block(); if (tc_kind() == 23) { tc_next(); } }
    else { tc_expr(); if (tc_kind() == 25) { tc_next(); } }
    tc_exit();
    return 0;
}
fn tc_yield() -> int {
    tc_next();
    if (tc_kind() == 25) { tc_next(); }
    return 0;
}
// test "name" { ... } / test("name") { ... } — тело проверяется; top-level
// такие блоки не эмитятся (нет раннера), внутри функции — обычное тело.
fn tc_test() -> int {
    tc_next();
    if (tc_kind() == 3) { tc_next(); }
    else {
        if (tc_kind() == 20) { tc_next(); if (tc_kind() == 3) { tc_next(); } if (tc_kind() == 21) { tc_next(); } }
    }
    tc_enter();
    if (tc_kind() == 22) { tc_next(); tc_block(); if (tc_kind() == 23) { tc_next(); } }
    tc_exit();
    return 0;
}
// select-инструкция: проверяются все ветки (как oracle), затем default.
fn tc_select_stmt() -> int {
    tc_next();
    if (tc_kind() == 22) { tc_next(); }
    while (tc_kind() != 23 && tc_kind() != 0) {
        let before = get(0, 9);
        if (tc_kind() == 24) { tc_next(); }
        if (tc_kind() == 97) { tc_next(); }
        let hasvar = 0; let vo = 0; let vl = 0;
        if (tc_kind() == 98) {
            tc_next();
            if (tc_kind() == 26) { tc_next(); }
        } else {
            if (tc_is_tok(tc_kind()) && tck_at(1) == 106) {
                vo = load32(TVAL() + get(0, 9) * 4);
                vl = load32(TLEN() + get(0, 9) * 4);
                tc_next(); tc_next();                    // IDENT, <-
                hasvar = 1;
            } else { if (tc_kind() == 106) { tc_next(); } }
            if (tc_kind() != 26) { tc_expr(); }      // выражение канала
            if (tc_kind() == 26) { tc_next(); }
        }
        tc_enter();
        if (hasvar == 1) { tv_add(vo, vl, TY_UNK(), TY_UNK(), 0); }
        if (tc_kind() == 22) { tc_next(); tc_block(); if (tc_kind() == 23) { tc_next(); } }
        tc_exit();
        if (get(0, 9) == before) { tc_next(); }
    }
    if (tc_kind() == 23) { tc_next(); }
    return 0;
}
// select-выражение: тип — fresh (как oracle); проверяются все ветки.
fn tc_select_expr() -> int {
    tc_next();
    if (tc_kind() == 22) { tc_next(); }
    let rt = TY_UNK();
    while (tc_kind() != 23 && tc_kind() != 0) {
        let before = get(0, 9);
        if (tc_kind() == 24) { tc_next(); }
        if (tc_kind() == 97) { tc_next(); }
        let hasvar = 0; let vo = 0; let vl = 0;
        if (tc_kind() == 98) {
            tc_next();
            if (tc_kind() == 26) { tc_next(); }
        } else {
            if (tc_is_tok(tc_kind()) && tck_at(1) == 106) {
                vo = load32(TVAL() + get(0, 9) * 4);
                vl = load32(TLEN() + get(0, 9) * 4);
                tc_next(); tc_next();
                hasvar = 1;
            } else { if (tc_kind() == 106) { tc_next(); } }
            if (tc_kind() != 26) { tc_expr(); }
            if (tc_kind() == 26) { tc_next(); }
        }
        tc_enter();
        if (hasvar == 1) { tv_add(vo, vl, TY_UNK(), TY_UNK(), 0); }
        rt = tc_expr();
        tc_exit();
        if (tc_kind() == 24) { tc_next(); }
        if (get(0, 9) == before) { tc_next(); }
    }
    if (tc_kind() == 23) { tc_next(); }
    return rt;
}

fn tc_block() -> int {
    while (tc_kind() != 23 && tc_kind() != 0) { let before = get(0, 9); tc_stmt(); if (get(0, 9) == before) { tc_next(); } }
    return 0;
}

// ===== часть: 45d_tc_program.lat =====
// ============================ ТАЙП-ЧЕКЕР: ПРОГРАММА ============================
// Регистрация типов результатов функций, верхнеуровневый проход
// (class/enum/async fn/fn/инструкции) и проверка тела одной функции.

// --- регистрация сигнатур ---
fn tc_register() -> int {
    let i = 0; let n = get(0, 2);
    while (i < n) {
        let tok = load32(FNTOK() + i * 4);
        // возврат: после '->'
        let r = TY_UNIT();
        let j = tok + 2;
        while (load32(KIND() + j * 4) != 21 && load32(KIND() + j * 4) != 0) { j = j + 1; }
        if (load32(KIND() + (j + 1) * 4) == 28) {
            let k2 = load32(KIND() + (j + 2) * 4);
            r = tag_of_ann_token(k2, load32(TVAL() + (j + 2) * 4), load32(TLEN() + (j + 2) * 4));
        }
        store32(FRETTY() + i * 4, r);
        i = i + 1;
    }
    return 0;
}
fn tag_of_ann_token(k, off, ln) -> int {
    if (k == 2 || (k >= 10 && k <= 19)) {
        if (is_lit(off, ln, "int", 3) || is_lit(off, ln, "float", 5)) { return TY_NUM(); }
        if (is_lit(off, ln, "bool", 4)) { return TY_BOOL(); }
        if (is_lit(off, ln, "string", 6)) { return TY_STR(); }
        if (is_lit(off, ln, "void", 4) || is_lit(off, ln, "unit", 4)) { return TY_UNIT(); }
        return TY_NAMED();
    }
    return TY_UNIT();
}

fn tc_program() -> int {
    set(0, 9, 0); set(0, 10, 0); set(0, 11, 0);
    let total = get(0, 1);
    tc_register();
    // Предобъявление функций: их имена видны глобально (find_func уже есть),
    // но возвращаемые типы нужны в tc_call — они в FRETTY из tc_register.
    while (get(0, 9) < total && load32(KIND() + get(0, 9) * 4) != 0) {
        let before = get(0, 9);
        let k = tc_kind();
        if (k == 92) { skip_class_tc(); }
        else {
            if (k == 96) { skip_enum_tc(); }
            else {
                if (k == 102) { tc_next(); if (tc_kind() == 11) { tc_fn(); } }   // async fn
                else { if (k == 11) { tc_fn(); } else { tc_stmt(); } }
            }
        }
        if (get(0, 9) == before) { tc_next(); }   // защита от зацикливания
    }
    return 0;
}
fn skip_class_tc() -> int {
    // class IDENT { ... } — пропускаем целиком (методы проверяются отдельно
    // через зарегистрированные сигнатуры).
    tc_next(); if (tc_is_tok(tc_kind())) { tc_next(); }
    if (tc_kind() == 22) { tc_next(); let d = 1; while (d > 0 && tc_kind() != 0) { if (tc_kind() == 22) { d = d + 1; } else { if (tc_kind() == 23) { d = d - 1; } } tc_next(); } }
    return 0;
}
fn skip_enum_tc() -> int {
    tc_next(); if (tc_is_tok(tc_kind())) { tc_next(); }
    if (tc_kind() == 22) { tc_next(); let d = 1; while (d > 0 && tc_kind() != 0) { if (tc_kind() == 22) { d = d + 1; } else { if (tc_kind() == 23) { d = d - 1; } } tc_next(); } }
    return 0;
}
fn tc_fn() -> int {
    tc_next();                        // fn
    let ni = find_func(load32(TVAL() + get(0, 9) * 4), load32(TLEN() + get(0, 9) * 4));
    tc_next();                        // NAME
    tc_enter();
    if (tc_kind() == 20) {
        tc_next();
        while (tc_kind() != 21 && tc_kind() != 0) {
            if (tc_is_tok(tc_kind())) {
                let po = load32(TVAL() + get(0, 9) * 4); let pl = load32(TLEN() + get(0, 9) * 4);
                tc_next();
                let pt = TY_UNK();
                if (tc_kind() == 26) { tc_next(); pt = tc_ann(); }
                tv_add(po, pl, pt, TY_UNK(), 0);
            }
            if (tc_kind() == 24) { tc_next(); }
        }
        if (tc_kind() == 21) { tc_next(); }
    }
    if (tc_kind() == 28) { tc_next(); tc_ann(); }
    store32(TCCUR(), 0);
    if (ni >= 0) { store32(TCCUR(), ni); }
    if (tc_kind() == 22) { tc_next(); tc_block(); if (tc_kind() == 23) { tc_next(); } }
    tc_exit();
    return 0;
}

// ===== часть: 50_stmt.lat =====
// --- инструкции ---
fn stmts() -> int {
    while (tok_kind() != 23 && tok_kind() != 0) {
        let before = get(0, 0);
        set(0, 7, 0);              // тип-стек выравнивается на границе инструкции
        set(0, 8, -1);             // класс последнего выражения сбрасывается
        stmt();
        if (get(0, 0) == before) { next_token(); }
    }
    return 0;
}
fn stmt() -> int {
    let k = tok_kind();
    if (k == 10) { return st_let(); }
    if (k == 15) { return st_return(); }
    if (k == 12) { return st_if(); }
    if (k == 14) { return st_while(); }
    if (k == 16) { return st_for(); }
    if (k == 100) { return st_spawn(); }
    if (k == 101) { return st_yield(); }
    if (k == 104) { return st_select(); }
    if (k == 105) { return st_test(); }
    if (is_ident_kind(k) && tok_kind_at(1) == 27) { return st_assign(); }
    if (k == 94 && tok_kind_at(1) == 29 && tok_kind_at(3) == 27) { return st_field_assign(k); }
    if (is_ident_kind(k) && tok_kind_at(1) == 29 && tok_kind_at(3) == 27) { return st_field_assign(k); }
    level_or();
    if (get(0, 5) == 1) { emit_op(26); }
    expect(25);
    return 0;
}
// Присваивание в поле: `this.f = v` или `obj.f = v`. Класс берётся из
// FNCLS текущей функции (для this) или из LOCCLS локальной переменной.
fn st_field_assign(k) -> int {
    let cls = -1;
    let base_slot = -1;
    if (k == 94) {
        next_token();                          // this
        cls = load32(FNCLS() + load32(CURFI()) * 4);
        base_slot = -1;                 // this = локаль 0
    } else {
        let boff = tok_val(); let blen = tok_len(); next_token();
        cls = load32(LOCCLS() + find_local(boff, blen) * 4);
        base_slot = find_local(boff, blen);
    }
    expect(29);                        // .
    let foff = tok_val(); let flen = tok_len();
    expect_ident();
    expect(27);                        // =
    let voff = reserve();
    level_or();
    emit_op(33); emit_leb(voff);              // сохраняем значение
    let off = field_off(cls, foff, flen);
    if (off < 0) { err(); }
    else {
        emit_op(32);
        if (base_slot >= 0) { emit_leb(base_slot); } else { emit_leb(0); }
        if (off > 0) { emit_op(65); emit_sleb(off); emit_op(106); }
        emit_op(32); emit_leb(voff);
        emit_op(54); emit_op(2); emit_op(0);          // i32.store
        // Присваивание — выражение: оставляем записанное значение.
        // (в st)-контексте достаточно; стек инструкций выравнивается вызовом)
    }
    expect(25); set(0, 5, 0);
    return 0;
}

fn st_assign() -> int {
    let noff = tok_val(); let nlen = tok_len();
    expect_ident(); expect(27);
    level_or();
    let vt = tpop();
    let li = find_local(noff, nlen);
    if (li < 0) { err(); } else { emit_op(33); emit_leb(li); set_local_tp(li, vt); }
    expect(25); set(0, 5, 0);
    return 0;
}
fn st_let() -> int {
    next_token();
    let noff = tok_val(); let nlen = tok_len();
    expect_ident();
    let ann = read_ann_after_colon();
    set(0, 5, 0);
    let vt = ann;
    if (tok_kind() == 27) { next_token(); level_or(); vt = tpop(); if (ann != T_INT()) { vt = ann; } } else { emit_op(65); emit_sleb(0); }
    expect(25);
    let idx = get(0, 3);
    add_local(noff, nlen, idx);
    set_local_tp(idx, vt);
    emit_op(33); emit_leb(idx);
    return 0;
}
fn st_return() -> int {
    next_token();
    if (tok_kind() != 25) { level_or(); } else { emit_op(65); emit_sleb(0); }
    emit_op(15);
    if (tok_kind() == 25) { next_token(); }
    return 0;
}
fn st_if() -> int {
    next_token(); expect(20); level_or(); expect(21);
    emit_op(4); emit_op(64); expect(22); stmts(); expect(23);
    if (tok_kind() == 13) {
        next_token();
        if (tok_kind() == 12) { emit_op(5); st_if(); emit_op(11); return 0; }
        emit_op(5); expect(22); stmts(); expect(23); emit_op(11); return 0;
    }
    emit_op(11);
    return 0;
}
fn st_while() -> int {
    next_token(); expect(20);
    emit_op(2); emit_op(64); emit_op(3); emit_op(64);
    level_or(); expect(21);
    emit_op(69); emit_op(13); emit_leb(1);
    expect(22); stmts(); expect(23);
    emit_op(12); emit_leb(0); emit_op(11); emit_op(11);
    return 0;
}
// Различает `for (let x in arr)` от C-стиля `for (let x = ...)`.
// Текущий токен — `let`; смотрим вперёд: let IDENT [ : T ] in ...
fn is_for_in() -> bool {
    if (tok_kind() != 10) { return false; }
    if (!is_ident_kind(tok_kind_at(1))) { return false; }
    let t2 = tok_kind_at(2);
    if (t2 == 17) { return true; }
    if (t2 != 26) { return false; }
    let j = 3;
    while (load32(KIND() + (get(0, 0) + j) * 4) != 0) {
        let k = load32(KIND() + (get(0, 0) + j) * 4);
        if (k == 17) { return true; }
        if (k == 27) { return false; }
        j = j + 1;
    }
    return false;
}

// for (let x in arr) { body } — итерация по массиву [len u32][e0..].
fn st_for_in() -> int {
    next_token();                                   // let
    let voff = tok_val(); let vlen = tok_len();
    expect_ident();
    if (tok_kind() == 26) { next_token(); skip_type(); }
    expect(17);                              // in
    level_or();                              // iterable
    let arr = reserve(); emit_op(33); emit_leb(arr);
    let idx = reserve(); emit_op(65); emit_sleb(0); emit_op(33); emit_leb(idx);
    let v = add_local(voff, vlen, get(0, 3));
    expect(21);
    emit_op(2); emit_op(64); emit_op(3); emit_op(64);
    emit_op(32); emit_leb(idx);
    emit_op(32); emit_leb(arr); emit_op(40); emit_op(2); emit_op(0);   // len
    emit_op(78);                                       // i32.ge_s
    emit_op(13); emit_leb(1);                            // br_if 1 (выход)
    emit_op(32); emit_leb(arr);
    emit_op(32); emit_leb(idx); emit_op(65); emit_sleb(4); emit_op(108); emit_op(106);
    emit_op(65); emit_sleb(4); emit_op(106);
    emit_op(40); emit_op(2); emit_op(0);                         // load
    emit_op(33); emit_leb(v);
    expect(22); stmts(); expect(23);
    emit_op(32); emit_leb(idx); emit_op(65); emit_sleb(1); emit_op(106); emit_op(33); emit_leb(idx);
    emit_op(12); emit_leb(0); emit_op(11); emit_op(11);
    set(0, 5, 0);
    return 0;
}

// Пропуск токенов до закрывающей `}` текущего блока (сама `}` остаётся).
// Используется после уже разобранной ветки select: oracle исполняет только
// первую ветку, остальные в код не попадают.
fn skip_to_rbrace() -> int {
    let d = 0;
    while (tok_kind() != 0) {
        let k = tok_kind();
        if (k == 22) { d = d + 1; }
        else {
            if (k == 23) {
                if (d == 0) { return 0; }
                d = d - 1;
            }
        }
        next_token();
    }
    return 0;
}

// spawn { ... } / spawn expr; — oracle выполняет тело последовательно (inline).
fn st_spawn() -> int {
    next_token();
    if (tok_kind() == 22) {
        next_token(); stmts(); expect(23);
    } else {
        level_or();
        if (get(0, 5) == 1) { emit_op(26); }      // результат выражения отбрасывается
    }
    if (tok_kind() == 25) { next_token(); }
    set(0, 5, 0);
    return 0;
}

// yield; — no-op (как в oracle: кооперативного планировщика нет).
fn st_yield() -> int {
    next_token();
    expect(25);
    return 0;
}

// test "name" { ... } / test("name") { ... } внутри функции — обычное тело
// (на верхнем уровне не эмитится, т.к. top-level инструкции не компилируются).
fn st_test() -> int {
    next_token();
    if (tok_kind() == 3) { next_token(); }
    else {
        if (tok_kind() == 20) {
            next_token();
            if (tok_kind() == 3) { next_token(); }
            expect(21);
        }
    }
    expect(22); stmts(); expect(23);
    return 0;
}

// select { case v <- ch: { ... } default: { ... } } — oracle не вычисляет
// выражения каналов и исполняет тело ПЕРВОЙ ветки (v связывается с 0);
// default исполняется, только если веток нет.
fn st_select() -> int {
    next_token(); expect(22);
    if (tok_kind() == 98) {
        next_token(); expect(26);
        expect(22); stmts(); expect(23);
        skip_to_rbrace(); expect(23);
        set(0, 5, 0);
        return 0;
    }
    if (tok_kind() != 23) {
        if (tok_kind() == 97) { next_token(); }
        if (is_ident_kind(tok_kind()) && tok_kind_at(1) == 106) {
            let voff = tok_val(); let vlen = tok_len();
            next_token(); next_token();                    // IDENT, <-
            let slot = get(0, 3);
            add_local(voff, vlen, slot);
            set_local_tp(slot, T_INT());
            store32(LOCCLS() + slot * 4, -1);
            emit_op(65); emit_sleb(0); emit_op(33); emit_leb(slot);
        } else {
            if (tok_kind() == 106) { next_token(); }
        }
        // Выражение канала не исполняется: эмитим и откатываем буфер.
        let save = blen(FNB()); let tsp = get(0, 7);
        if (tok_kind() != 26) { level_or(); }
        store32(FNB(), save); set(0, 7, tsp);
        expect(26);
        expect(22); stmts(); expect(23);
    }
    skip_to_rbrace(); expect(23);
    set(0, 5, 0);
    return 0;
}

fn st_for() -> int {
    next_token(); expect(20);
    if (is_for_in()) { return st_for_in(); }
    if (tok_kind() == 10) { st_let(); } else { if (tok_kind() != 25) { level_or(); emit_op(26); expect(25); } else { next_token(); } }
    emit_op(2); emit_op(64); emit_op(3); emit_op(64);
    if (tok_kind() != 25) { level_or(); } else { emit_op(65); emit_sleb(1); }
    expect(25);
    emit_op(69); emit_op(13); emit_leb(1);
    let step_start = get(0, 0);
    while (tok_kind() != 21 && tok_kind() != 0) { next_token(); }
    let step_end = get(0, 0);
    expect(21);
    expect(22); stmts(); expect(23);
    let after_body = get(0, 0);
    set(0, 0, step_start);
    if (step_start != step_end) { level_or(); emit_op(26); }
    set(0, 0, after_body);
    emit_op(12); emit_leb(0); emit_op(11); emit_op(11);
    return 0;
}

// ===== часть: 60_func.lat =====
// --- сборка функций ---
fn scan_signatures() -> int {
    let i = 0; let cnt = 0; let depth = 0;
    let total = get(0, 1);
    while (i < total) {
        let tk = load32(KIND() + i * 4);
        if (tk == 22) { depth = depth + 1; }
        else { if (tk == 23) { depth = depth - 1; if (depth < 0) { depth = 0; } }
        // Функция верхнего уровня (depth 0) или метод класса (записан в
        // METHTOK скан-классов). Прочие `fn` внутри тел — лямбды (scan_lambdas).
        else { if (tk == 11 && (depth == 0 || method_class(i) >= 0)) {
            store32(FNTOK() + cnt * 4, i);
            store32(FNOFF() + cnt * 4, load32(TVAL() + (i + 1) * 4));
            store32(FNLEN() + cnt * 4, load32(TLEN() + (i + 1) * 4));
            let j = i + 2; let p = 0; let prev = 20;
            while (j < total && load32(KIND() + j * 4) != 21) {
                let kk = load32(KIND() + j * 4);
                if ((kk == 2 || (kk >= 10 && kk <= 19)) && (prev == 20 || prev == 24)) { p = p + 1; }
                prev = kk; j = j + 1;
            }
            let mc = method_class(i);
            store32(FNCLS() + cnt * 4, mc);
            // Метод получает неявный первый параметр `this`.
            if (mc >= 0) { p = p + 1; }
            store32(FNNP() + cnt * 4, p);
            store32(FNRET() + cnt * 4, fn_ret_tp(total, i));
            cnt = cnt + 1;
        } }
        }
        i = i + 1;
    }
    set(0, 2, cnt);
    return cnt;
}

// Тип результата функции для выбора строковых/числовых опкодов: строковым
// считаем функцию с аннотацией `-> string`; иначе int (как oracle-дефолт).
fn fn_ret_tp(total, ftok) -> int {
    let j = ftok + 2;                  // после имени: '('
    while (j < total && load32(KIND() + j * 4) != 21) { j = j + 1; }
    if (j + 1 >= total) { return T_INT(); }
    if (load32(KIND() + (j + 1) * 4) != 28) { return T_INT(); }   // нет '->'
    let rt = j + 2;
    if (load32(KIND() + rt * 4) == 2) {
        if (is_lit(load32(TVAL() + rt * 4), load32(TLEN() + rt * 4), "string", 6)) { return T_STR(); }
        if (is_lit(load32(TVAL() + rt * 4), load32(TLEN() + rt * 4), "float", 5)) { return T_FLT(); }
    }
    return T_INT();
}
// Пропускает аннотацию типа до разделителя: `,` `)` `}` `=` `;` или EOF.
fn skip_type() -> int {
    while (tok_kind() != 24 && tok_kind() != 21 && tok_kind() != 22 && tok_kind() != 27
        && tok_kind() != 25 && tok_kind() != 0) { next_token(); }
    return 0;
}
// Читает аннотацию типа и возвращает тег для LOTP (T_INT/T_FLT/T_STR),
// потребляя токены до разделителя. `: string` → T_STR и т.п.
fn read_type_tag() -> int {
    let t = T_INT();
    if (is_ident_kind(tok_kind())) {
        let off = tok_val(); let ln = tok_len();
        if (is_lit(off, ln, "string", 6)) { t = T_STR(); }
        else { if (is_lit(off, ln, "float", 5)) { t = T_FLT(); } }
    }
    skip_type();
    return t;
}
// Аннотация с ведущим `:` (текущий токен — 26).
fn read_ann_after_colon() -> int {
    if (tok_kind() == 26) { next_token(); return read_type_tag(); }
    return T_INT();
}

// Декларации локальных групп для code-секции: идём по слотам nparams..ntot
// и группируем подряд идущие одинаковые valtype (0x7f=i32, 0x7c=f64).
// Так float-локальные (LOTP=T_FLT) получают корректный f64-valtype.
fn emit_local_decls(nparams, ntot) -> int {
    let i = nparams;
    let ngrp = 0;
    while (i < ntot) {
        let t = local_valtype(i);
        let j = i + 1;
        while (j < ntot && local_valtype(j) == t) { j = j + 1; }
        ngrp = ngrp + 1;
        i = j;
    }
    bleb(BODYC(), ngrp);
    i = nparams;
    while (i < ntot) {
        let t = local_valtype(i);
        let j = i + 1;
        while (j < ntot && local_valtype(j) == t) { j = j + 1; }
        bleb(BODYC(), j - i);
        bput(BODYC(), t);
        i = j;
    }
    return 0;
}
fn local_valtype(idx) -> int {
    if (load32(LOTP() + idx * 4) == T_FLT()) { return 124; }   // f64
    return 127;                                                // i32
}

fn compile_fn(fi) -> int {
    set(0, 0, load32(FNTOK() + fi * 4));
    store32(CURFI(), fi);
    expect(11); expect_ident();
    binit(FNB());
    set(0, 3, 0);
    let cls = load32(FNCLS() + fi * 4);
    if (cls >= 0) {
        // Неявный `this` = локаль 0 (offset -1, распознаётся по имени в primary).
        add_local(-1, 4, 0); set_local_tp(0, T_INT()); store32(LOCCLS() + 0 * 4, cls);
    }
    expect(20);
    let idx = 0;
    while (tok_kind() != 21 && tok_kind() != 0) {
        let poff = tok_val(); let plen = tok_len();
        expect_ident();
        let slot = get(0, 3);
        // Параметры подписаны всегда i32 (mixed-float параметры не поддержаны
        // ни oracle, ни нами), но аннотация нужна для ТИПА локальной: строковый
        // параметр обязан быть T_STR, иначе `s[i]` компилируется как индекс
        // массива (4-байтовые ячейки) вместо str_char_at — так ломался текст
        // ошибок у stage2 (tcerr_msg(s: string)).
        let pt = read_ann_after_colon();
        add_local(poff, plen, slot);
        if (pt == T_STR()) { set_local_tp(slot, T_STR()); } else { set_local_tp(slot, T_INT()); }
        idx = idx + 1;
        if (tok_kind() == 24) { next_token(); }
    }
    expect(21);
    if (tok_kind() == 28) { next_token(); skip_type(); }
    expect(22);
    stmts();
    expect(23);
    let lb = load8(FNB() + 4 + load32(FNB()) - 1);
    if (lb != 15) { emit_op(65); emit_sleb(0); }
    emit_op(11);
    // финальное тело: декларации локальных групп по типу (i32/f64).
    binit(BODYC());
    let nparams = load32(FNNP() + fi * 4);
    emit_local_decls(nparams, get(0, 3));
    bcopy(BODYC(), FNB(), 0, blen(FNB()));
    store32(CODEOF() + fi * 4, load32(CODEB()));
    store32(CODELN() + fi * 4, blen(BODYC()));
    bcopy(CODEB(), BODYC(), 0, blen(BODYC()));
    return 0;
}

// ===== часть: 70a_module_helpers.lat =====
// ============================ МОДУЛЬ: ХЕЛПЕРЫ ПАМЯТИ И СТРОК ============================
// Байткод alloc/memcopy/str_concat/str_eq/str_char_at. Каждый эмиттер пишет
// тело в BODYC и добавляет его в CODEB по индексу nf()+k; порядок вызовов в
// helper_bodies = порядок индексов, поэтому диспетчер фиксирован.

fn helper_bodies() -> int {
    helper_alloc(0);
    helper_memcopy(1);
    helper_str_concat(2);
    helper_str_eq(3);
    helper_str_char_at(4);
    helper_i32_to_str(5);
    helper_str_to_i32(6);
    helper_f64_to_str(7);
    return 0;
}

fn emit_helper_body(k) -> int {
    store32(CODEOF() + (nf() + k) * 4, load32(CODEB()));
    store32(CODELN() + (nf() + k) * 4, blen(BODYC()));
    bcopy(CODEB(), BODYC(), 0, blen(BODYC()));
    return 0;
}

fn helper_alloc(k) -> int {
    // alloc(size)->ptr
    binit(BODYC());
    bleb(BODYC(), 1); bleb(BODYC(), 3); bput(BODYC(), 127);   // locals: 3×i32
    // ptr = heap (global 0)
    bput(BODYC(), 35); bleb(BODYC(), 0); bput(BODYC(), 33); bleb(BODYC(), 1);
    // heap = heap + size
    bput(BODYC(), 35); bleb(BODYC(), 0); bput(BODYC(), 32); bleb(BODYC(), 0); bput(BODYC(), 106); bput(BODYC(), 36); bleb(BODYC(), 0);
    // need = (heap + 65535) / 65536
    bput(BODYC(), 35); bleb(BODYC(), 0); bput(BODYC(), 65); bleb(BODYC(), 65535);
    bput(BODYC(), 106);
    bput(BODYC(), 65); bleb(BODYC(), 65536);
    bput(BODYC(), 110); bput(BODYC(), 33); bleb(BODYC(), 2);
    // cur = memory.size 0
    bput(BODYC(), 63); bput(BODYC(), 0); bput(BODYC(), 33); bleb(BODYC(), 3);
    // if cur < need { grow(need-cur); drop }
    bput(BODYC(), 32); bleb(BODYC(), 3); bput(BODYC(), 32); bleb(BODYC(), 2); bput(BODYC(), 73);
    bput(BODYC(), 4); bput(BODYC(), 64);
    bput(BODYC(), 32); bleb(BODYC(), 2); bput(BODYC(), 32); bleb(BODYC(), 3); bput(BODYC(), 107);
    bput(BODYC(), 64); bput(BODYC(), 0); bput(BODYC(), 26);
    bput(BODYC(), 11);
    bput(BODYC(), 32); bleb(BODYC(), 1);
    bput(BODYC(), 11);
    return emit_helper_body(k);
}

fn helper_memcopy(k) -> int {
    // memcopy(dst,src,len)->i32 (возвращает 0)
    binit(BODYC());
    bleb(BODYC(), 1); bleb(BODYC(), 1); bput(BODYC(), 127);   // local i (idx3)
    bput(BODYC(), 65); bleb(BODYC(), 0); bput(BODYC(), 33); bleb(BODYC(), 3);
    bput(BODYC(), 2); bput(BODYC(), 64); bput(BODYC(), 3); bput(BODYC(), 64);
    bput(BODYC(), 32); bleb(BODYC(), 3); bput(BODYC(), 32); bleb(BODYC(), 2); bput(BODYC(), 79);
    bput(BODYC(), 13); bleb(BODYC(), 1);
    bput(BODYC(), 32); bleb(BODYC(), 0); bput(BODYC(), 32); bleb(BODYC(), 3); bput(BODYC(), 106);
    bput(BODYC(), 32); bleb(BODYC(), 1); bput(BODYC(), 32); bleb(BODYC(), 3); bput(BODYC(), 106);
    bput(BODYC(), 45); bput(BODYC(), 0); bput(BODYC(), 0);
    bput(BODYC(), 58); bput(BODYC(), 0); bput(BODYC(), 0);
    bput(BODYC(), 32); bleb(BODYC(), 3); bput(BODYC(), 65); bleb(BODYC(), 1); bput(BODYC(), 106); bput(BODYC(), 33); bleb(BODYC(), 3);
    bput(BODYC(), 12); bleb(BODYC(), 0);
    bput(BODYC(), 11); bput(BODYC(), 11);
    bput(BODYC(), 65); bleb(BODYC(), 0);
    bput(BODYC(), 11);
    return emit_helper_body(k);
}

fn helper_str_concat(k) -> int {
    // str_concat(a,b)->ptr: [len u32][utf8] с общим заголовком длины.
    // locals: params 0 a,1 b; declared 2 alen,3 blen,4 p.
    binit(BODYC());
    bleb(BODYC(), 1); bleb(BODYC(), 3); bput(BODYC(), 127);
    bput(BODYC(), 32); bleb(BODYC(), 0); bput(BODYC(), 40); bput(BODYC(), 2); bput(BODYC(), 0); bput(BODYC(), 33); bleb(BODYC(), 2);
    bput(BODYC(), 32); bleb(BODYC(), 1); bput(BODYC(), 40); bput(BODYC(), 2); bput(BODYC(), 0); bput(BODYC(), 33); bleb(BODYC(), 3);
    bput(BODYC(), 32); bleb(BODYC(), 2); bput(BODYC(), 32); bleb(BODYC(), 3); bput(BODYC(), 106);
    bput(BODYC(), 65); bleb(BODYC(), 4); bput(BODYC(), 106);
    bput(BODYC(), 16); bleb(BODYC(), ALLOC_FI()); bput(BODYC(), 33); bleb(BODYC(), 4);
    // store len at p
    bput(BODYC(), 32); bleb(BODYC(), 4); bput(BODYC(), 32); bleb(BODYC(), 2); bput(BODYC(), 32); bleb(BODYC(), 3); bput(BODYC(), 106); bput(BODYC(), 54); bput(BODYC(), 2); bput(BODYC(), 0);
    // mem_copy(p+4, a+4, alen)  — memcopy возвращает i32, гасим drop(26)
    bput(BODYC(), 32); bleb(BODYC(), 4); bput(BODYC(), 65); bleb(BODYC(), 4); bput(BODYC(), 106);
    bput(BODYC(), 32); bleb(BODYC(), 0); bput(BODYC(), 65); bleb(BODYC(), 4); bput(BODYC(), 106);
    bput(BODYC(), 32); bleb(BODYC(), 2);
    bput(BODYC(), 16); bleb(BODYC(), MEM_FI()); bput(BODYC(), 26);
    // mem_copy(p+4+alen, b+4, blen)
    bput(BODYC(), 32); bleb(BODYC(), 4); bput(BODYC(), 65); bleb(BODYC(), 4); bput(BODYC(), 106); bput(BODYC(), 32); bleb(BODYC(), 2); bput(BODYC(), 106);
    bput(BODYC(), 32); bleb(BODYC(), 1); bput(BODYC(), 65); bleb(BODYC(), 4); bput(BODYC(), 106);
    bput(BODYC(), 32); bleb(BODYC(), 3);
    bput(BODYC(), 16); bleb(BODYC(), MEM_FI()); bput(BODYC(), 26);
    bput(BODYC(), 32); bleb(BODYC(), 4);
    bput(BODYC(), 11);
    return emit_helper_body(k);
}

fn helper_str_eq(k) -> int {
    // str_eq(a,b)->i32 (1/0): ранние return в void-ветках (без смешанных if).
    // locals: params 0 a,1 b; declared 2 i,3 len.
    binit(BODYC());
    bleb(BODYC(), 1); bleb(BODYC(), 2); bput(BODYC(), 127);
    // if load(a) != load(b) return 0
    bput(BODYC(), 32); bleb(BODYC(), 0); bput(BODYC(), 40); bput(BODYC(), 2); bput(BODYC(), 0);
    bput(BODYC(), 32); bleb(BODYC(), 1); bput(BODYC(), 40); bput(BODYC(), 2); bput(BODYC(), 0);
    bput(BODYC(), 71); bput(BODYC(), 4); bput(BODYC(), 64);
    bput(BODYC(), 65); bleb(BODYC(), 0); bput(BODYC(), 15); bput(BODYC(), 11);
    // len = load(a)
    bput(BODYC(), 32); bleb(BODYC(), 0); bput(BODYC(), 40); bput(BODYC(), 2); bput(BODYC(), 0); bput(BODYC(), 33); bleb(BODYC(), 3);
    // i = 0
    bput(BODYC(), 65); bleb(BODYC(), 0); bput(BODYC(), 33); bleb(BODYC(), 2);
    bput(BODYC(), 2); bput(BODYC(), 64); bput(BODYC(), 3); bput(BODYC(), 64);
    // if i >= len break
    bput(BODYC(), 32); bleb(BODYC(), 2); bput(BODYC(), 32); bleb(BODYC(), 3); bput(BODYC(), 79); bput(BODYC(), 13); bleb(BODYC(), 1);
    // if a[4+i] != b[4+i] return 0
    bput(BODYC(), 32); bleb(BODYC(), 0); bput(BODYC(), 65); bleb(BODYC(), 4); bput(BODYC(), 106); bput(BODYC(), 32); bleb(BODYC(), 2); bput(BODYC(), 106); bput(BODYC(), 45); bput(BODYC(), 0); bput(BODYC(), 0);
    bput(BODYC(), 32); bleb(BODYC(), 1); bput(BODYC(), 65); bleb(BODYC(), 4); bput(BODYC(), 106); bput(BODYC(), 32); bleb(BODYC(), 2); bput(BODYC(), 106); bput(BODYC(), 45); bput(BODYC(), 0); bput(BODYC(), 0);
    bput(BODYC(), 71); bput(BODYC(), 4); bput(BODYC(), 64); bput(BODYC(), 65); bleb(BODYC(), 0); bput(BODYC(), 15); bput(BODYC(), 11);
    // i++
    bput(BODYC(), 32); bleb(BODYC(), 2); bput(BODYC(), 65); bleb(BODYC(), 1); bput(BODYC(), 106); bput(BODYC(), 33); bleb(BODYC(), 2);
    bput(BODYC(), 12); bleb(BODYC(), 0); bput(BODYC(), 11); bput(BODYC(), 11);
    bput(BODYC(), 65); bleb(BODYC(), 1);
    bput(BODYC(), 11);
    return emit_helper_body(k);
}

fn helper_str_char_at(k) -> int {
    // str_char_at(ptr,i)->i32: байт по i в [0,len), иначе -1. Void-ветки с return.
    binit(BODYC());
    bleb(BODYC(), 0);
    bput(BODYC(), 32); bleb(BODYC(), 1); bput(BODYC(), 65); bleb(BODYC(), 0); bput(BODYC(), 72); bput(BODYC(), 4); bput(BODYC(), 64);
    bput(BODYC(), 65); bsleb(BODYC(), -1); bput(BODYC(), 15); bput(BODYC(), 11);
    bput(BODYC(), 32); bleb(BODYC(), 1); bput(BODYC(), 32); bleb(BODYC(), 0); bput(BODYC(), 40); bput(BODYC(), 2); bput(BODYC(), 0); bput(BODYC(), 79); bput(BODYC(), 4); bput(BODYC(), 64);
    bput(BODYC(), 65); bsleb(BODYC(), -1); bput(BODYC(), 15); bput(BODYC(), 11);
    bput(BODYC(), 32); bleb(BODYC(), 0); bput(BODYC(), 65); bleb(BODYC(), 4); bput(BODYC(), 106); bput(BODYC(), 32); bleb(BODYC(), 1); bput(BODYC(), 106); bput(BODYC(), 45); bput(BODYC(), 0); bput(BODYC(), 0);
    bput(BODYC(), 11);
    return emit_helper_body(k);
}

// ===== часть: 70b_module_convert.lat =====
// ============================ МОДУЛЬ: ХЕЛПЕРЫ КОНВЕРСИЙ ============================
// Байткод i32_to_str/str_to_i32/f64_to_str и эмиттеры f64-констант 0.0/10.0.
// Как и хелперы памяти, тела дописываются в CODEB по nf()+k.

fn helper_i32_to_str(k) -> int {
    // i32_to_str(n)->ptr: "<n>" в [len][utf8] (как в oracle). Переносим -n.
    // locals: param 0 n; declared 1 neg,2 v,3 digits,4 i,5 p.
    binit(BODYC());
    bleb(BODYC(), 1); bleb(BODYC(), 5); bput(BODYC(), 127);
    // neg = n < 0
    bput(BODYC(), 32); bleb(BODYC(), 0); bput(BODYC(), 65); bleb(BODYC(), 0); bput(BODYC(), 72); bput(BODYC(), 33); bleb(BODYC(), 1);
    // v = neg ? 0-n : n
    bput(BODYC(), 32); bleb(BODYC(), 1); bput(BODYC(), 4); bput(BODYC(), 64);
    bput(BODYC(), 65); bleb(BODYC(), 0); bput(BODYC(), 32); bleb(BODYC(), 0); bput(BODYC(), 107); bput(BODYC(), 33); bleb(BODYC(), 2);
    bput(BODYC(), 5);
    bput(BODYC(), 32); bleb(BODYC(), 0); bput(BODYC(), 33); bleb(BODYC(), 2);
    bput(BODYC(), 11);
    // digits = 1; i = v
    bput(BODYC(), 65); bleb(BODYC(), 1); bput(BODYC(), 33); bleb(BODYC(), 3);
    bput(BODYC(), 32); bleb(BODYC(), 2); bput(BODYC(), 33); bleb(BODYC(), 4);
    bput(BODYC(), 2); bput(BODYC(), 64); bput(BODYC(), 3); bput(BODYC(), 64);
    bput(BODYC(), 32); bleb(BODYC(), 4); bput(BODYC(), 65); bleb(BODYC(), 10); bput(BODYC(), 73); bput(BODYC(), 13); bleb(BODYC(), 1);
    bput(BODYC(), 32); bleb(BODYC(), 4); bput(BODYC(), 65); bleb(BODYC(), 10); bput(BODYC(), 110); bput(BODYC(), 33); bleb(BODYC(), 4);
    bput(BODYC(), 32); bleb(BODYC(), 3); bput(BODYC(), 65); bleb(BODYC(), 1); bput(BODYC(), 106); bput(BODYC(), 33); bleb(BODYC(), 3);
    bput(BODYC(), 12); bleb(BODYC(), 0); bput(BODYC(), 11); bput(BODYC(), 11);
    // p = alloc(4 + digits + neg)
    bput(BODYC(), 65); bleb(BODYC(), 4); bput(BODYC(), 32); bleb(BODYC(), 3); bput(BODYC(), 106); bput(BODYC(), 32); bleb(BODYC(), 1); bput(BODYC(), 106);
    bput(BODYC(), 16); bleb(BODYC(), ALLOC_FI()); bput(BODYC(), 33); bleb(BODYC(), 5);
    // store len = digits + neg
    bput(BODYC(), 32); bleb(BODYC(), 5); bput(BODYC(), 32); bleb(BODYC(), 3); bput(BODYC(), 32); bleb(BODYC(), 1); bput(BODYC(), 106); bput(BODYC(), 54); bput(BODYC(), 2); bput(BODYC(), 0);
    // if neg: p[4] = '-'
    bput(BODYC(), 32); bleb(BODYC(), 1); bput(BODYC(), 4); bput(BODYC(), 64);
    bput(BODYC(), 32); bleb(BODYC(), 5); bput(BODYC(), 65); bleb(BODYC(), 4); bput(BODYC(), 106); bput(BODYC(), 65); bleb(BODYC(), 45); bput(BODYC(), 58); bput(BODYC(), 0); bput(BODYC(), 0);
    bput(BODYC(), 11);
    // i = digits; loop { if i==0 break; i--; p[4+neg+i]='0'+v%10; v/=10 }
    bput(BODYC(), 32); bleb(BODYC(), 3); bput(BODYC(), 33); bleb(BODYC(), 4);
    bput(BODYC(), 2); bput(BODYC(), 64); bput(BODYC(), 3); bput(BODYC(), 64);
    bput(BODYC(), 32); bleb(BODYC(), 4); bput(BODYC(), 69); bput(BODYC(), 13); bleb(BODYC(), 1);
    bput(BODYC(), 32); bleb(BODYC(), 4); bput(BODYC(), 65); bleb(BODYC(), 1); bput(BODYC(), 107); bput(BODYC(), 33); bleb(BODYC(), 4);
    bput(BODYC(), 32); bleb(BODYC(), 5); bput(BODYC(), 65); bleb(BODYC(), 4); bput(BODYC(), 106); bput(BODYC(), 32); bleb(BODYC(), 1); bput(BODYC(), 106); bput(BODYC(), 32); bleb(BODYC(), 4); bput(BODYC(), 106);
    bput(BODYC(), 32); bleb(BODYC(), 2); bput(BODYC(), 65); bleb(BODYC(), 10); bput(BODYC(), 112); bput(BODYC(), 65); bleb(BODYC(), 48); bput(BODYC(), 106);
    bput(BODYC(), 58); bput(BODYC(), 0); bput(BODYC(), 0);
    bput(BODYC(), 32); bleb(BODYC(), 2); bput(BODYC(), 65); bleb(BODYC(), 10); bput(BODYC(), 110); bput(BODYC(), 33); bleb(BODYC(), 2);
    bput(BODYC(), 12); bleb(BODYC(), 0); bput(BODYC(), 11); bput(BODYC(), 11);
    bput(BODYC(), 32); bleb(BODYC(), 5);
    bput(BODYC(), 11);
    return emit_helper_body(k);
}

fn helper_str_to_i32(k) -> int {
    // str_to_i32(ptr)->i32: опциональный '-' и ASCII-цифры.
    // locals: param 0 ptr; declared 1 len,2 i,3 neg,4 acc,5 c.
    binit(BODYC());
    bleb(BODYC(), 1); bleb(BODYC(), 5); bput(BODYC(), 127);
    bput(BODYC(), 32); bleb(BODYC(), 0); bput(BODYC(), 40); bput(BODYC(), 2); bput(BODYC(), 0); bput(BODYC(), 33); bleb(BODYC(), 1);
    bput(BODYC(), 65); bleb(BODYC(), 0); bput(BODYC(), 33); bleb(BODYC(), 2);
    bput(BODYC(), 65); bleb(BODYC(), 0); bput(BODYC(), 33); bleb(BODYC(), 3);
    bput(BODYC(), 65); bleb(BODYC(), 0); bput(BODYC(), 33); bleb(BODYC(), 4);
    // if len>0 && ptr[4]=='-' { neg=1; i=1 }
    bput(BODYC(), 32); bleb(BODYC(), 1); bput(BODYC(), 65); bleb(BODYC(), 0); bput(BODYC(), 74); bput(BODYC(), 4); bput(BODYC(), 64);
    bput(BODYC(), 32); bleb(BODYC(), 0); bput(BODYC(), 65); bleb(BODYC(), 4); bput(BODYC(), 106); bput(BODYC(), 45); bput(BODYC(), 0); bput(BODYC(), 0); bput(BODYC(), 65); bleb(BODYC(), 45); bput(BODYC(), 70); bput(BODYC(), 4); bput(BODYC(), 64);
    bput(BODYC(), 65); bleb(BODYC(), 1); bput(BODYC(), 33); bleb(BODYC(), 3);
    bput(BODYC(), 65); bleb(BODYC(), 1); bput(BODYC(), 33); bleb(BODYC(), 2);
    bput(BODYC(), 11); bput(BODYC(), 11);
    bput(BODYC(), 2); bput(BODYC(), 64); bput(BODYC(), 3); bput(BODYC(), 64);
    // if i>=len break
    bput(BODYC(), 32); bleb(BODYC(), 2); bput(BODYC(), 32); bleb(BODYC(), 1); bput(BODYC(), 79); bput(BODYC(), 13); bleb(BODYC(), 1);
    // c = ptr[4+i]
    bput(BODYC(), 32); bleb(BODYC(), 0); bput(BODYC(), 65); bleb(BODYC(), 4); bput(BODYC(), 106); bput(BODYC(), 32); bleb(BODYC(), 2); bput(BODYC(), 106); bput(BODYC(), 45); bput(BODYC(), 0); bput(BODYC(), 0); bput(BODYC(), 33); bleb(BODYC(), 5);
    // if c < '0' break; if c > '9' break
    bput(BODYC(), 32); bleb(BODYC(), 5); bput(BODYC(), 65); bleb(BODYC(), 48); bput(BODYC(), 72); bput(BODYC(), 13); bleb(BODYC(), 1);
    bput(BODYC(), 32); bleb(BODYC(), 5); bput(BODYC(), 65); bleb(BODYC(), 57); bput(BODYC(), 74); bput(BODYC(), 13); bleb(BODYC(), 1);
    // acc = acc*10 + (c-'0')
    bput(BODYC(), 32); bleb(BODYC(), 4); bput(BODYC(), 65); bleb(BODYC(), 10); bput(BODYC(), 108); bput(BODYC(), 32); bleb(BODYC(), 5); bput(BODYC(), 65); bleb(BODYC(), 48); bput(BODYC(), 107); bput(BODYC(), 106); bput(BODYC(), 33); bleb(BODYC(), 4);
    bput(BODYC(), 32); bleb(BODYC(), 2); bput(BODYC(), 65); bleb(BODYC(), 1); bput(BODYC(), 106); bput(BODYC(), 33); bleb(BODYC(), 2);
    bput(BODYC(), 12); bleb(BODYC(), 0); bput(BODYC(), 11); bput(BODYC(), 11);
    // neg ? -acc : acc  (if с результатом i32 = 0x7f)
    bput(BODYC(), 32); bleb(BODYC(), 3); bput(BODYC(), 4); bput(BODYC(), 127);
    bput(BODYC(), 65); bleb(BODYC(), 0); bput(BODYC(), 32); bleb(BODYC(), 4); bput(BODYC(), 107); bput(BODYC(), 5);
    bput(BODYC(), 32); bleb(BODYC(), 4);
    bput(BODYC(), 11);   // end if (i32)
    bput(BODYC(), 11);   // end function
    return emit_helper_body(k);
}

fn helper_f64_to_str(k) -> int {
    // f64_to_str(n)->ptr: "<int>.<6 цифр>" (фиксированные 6 знаков), как oracle.
    // param 0 n(f64); i32-локали 1 neg,2 p,3 ipart,4 s,5 i,6 digit; f64-локаль 7 frac.
    binit(BODYC());
    bleb(BODYC(), 2); bleb(BODYC(), 6); bput(BODYC(), 127); bleb(BODYC(), 1); bput(BODYC(), 124);
    // neg = n < 0.0
    bput(BODYC(), 32); bleb(BODYC(), 0); bput(BODYC(), 68); f64zero();
    bput(BODYC(), 99); bput(BODYC(), 33); bleb(BODYC(), 1);
    // if neg { n = -n }
    bput(BODYC(), 32); bleb(BODYC(), 1); bput(BODYC(), 4); bput(BODYC(), 64);
    bput(BODYC(), 32); bleb(BODYC(), 0); bput(BODYC(), 154); bput(BODYC(), 33); bleb(BODYC(), 0);
    bput(BODYC(), 11);
    // ipart = trunc(n) as i32
    bput(BODYC(), 32); bleb(BODYC(), 0); bput(BODYC(), 170); bput(BODYC(), 33); bleb(BODYC(), 3);
    // p = alloc(23)
    bput(BODYC(), 65); bleb(BODYC(), 23); bput(BODYC(), 16); bleb(BODYC(), ALLOC_FI()); bput(BODYC(), 33); bleb(BODYC(), 2);
    // s = i32_to_str(ipart)
    bput(BODYC(), 32); bleb(BODYC(), 3); bput(BODYC(), 16); bleb(BODYC(), I32S_FI()); bput(BODYC(), 33); bleb(BODYC(), 4);
    // mem_copy(p+4, s+4, load(s))
    bput(BODYC(), 32); bleb(BODYC(), 2); bput(BODYC(), 65); bleb(BODYC(), 4); bput(BODYC(), 106);
    bput(BODYC(), 32); bleb(BODYC(), 4); bput(BODYC(), 65); bleb(BODYC(), 4); bput(BODYC(), 106);
    bput(BODYC(), 32); bleb(BODYC(), 4); bput(BODYC(), 40); bput(BODYC(), 2); bput(BODYC(), 0);
    bput(BODYC(), 16); bleb(BODYC(), MEM_FI()); bput(BODYC(), 26);
    // p[4+neg+load(s)] = '.'
    bput(BODYC(), 32); bleb(BODYC(), 2); bput(BODYC(), 65); bleb(BODYC(), 4); bput(BODYC(), 106);
    bput(BODYC(), 32); bleb(BODYC(), 1); bput(BODYC(), 106);
    bput(BODYC(), 32); bleb(BODYC(), 4); bput(BODYC(), 40); bput(BODYC(), 2); bput(BODYC(), 0); bput(BODYC(), 106);
    bput(BODYC(), 65); bleb(BODYC(), 46); bput(BODYC(), 58); bput(BODYC(), 0); bput(BODYC(), 0);
    // frac = n - convert(ipart)
    bput(BODYC(), 32); bleb(BODYC(), 0); bput(BODYC(), 32); bleb(BODYC(), 3); bput(BODYC(), 183); bput(BODYC(), 161); bput(BODYC(), 33); bleb(BODYC(), 7);
    // i = 0
    bput(BODYC(), 65); bleb(BODYC(), 0); bput(BODYC(), 33); bleb(BODYC(), 5);
    bput(BODYC(), 2); bput(BODYC(), 64); bput(BODYC(), 3); bput(BODYC(), 64);
    // if i >= 6 break
    bput(BODYC(), 32); bleb(BODYC(), 5); bput(BODYC(), 65); bleb(BODYC(), 6); bput(BODYC(), 78); bput(BODYC(), 13); bleb(BODYC(), 1);
    // frac *= 10.0
    bput(BODYC(), 32); bleb(BODYC(), 7); bput(BODYC(), 68); f64ten(); bput(BODYC(), 162); bput(BODYC(), 33); bleb(BODYC(), 7);
    // digit = trunc(frac)
    bput(BODYC(), 32); bleb(BODYC(), 7); bput(BODYC(), 170); bput(BODYC(), 33); bleb(BODYC(), 6);
    // frac -= convert(digit)
    bput(BODYC(), 32); bleb(BODYC(), 7); bput(BODYC(), 32); bleb(BODYC(), 6); bput(BODYC(), 183); bput(BODYC(), 161); bput(BODYC(), 33); bleb(BODYC(), 7);
    // p[4+neg+load(s)+1+i] = '0'+digit
    bput(BODYC(), 32); bleb(BODYC(), 2); bput(BODYC(), 65); bleb(BODYC(), 4); bput(BODYC(), 106);
    bput(BODYC(), 32); bleb(BODYC(), 1); bput(BODYC(), 106);
    bput(BODYC(), 32); bleb(BODYC(), 4); bput(BODYC(), 40); bput(BODYC(), 2); bput(BODYC(), 0); bput(BODYC(), 106);
    bput(BODYC(), 65); bleb(BODYC(), 1); bput(BODYC(), 106);
    bput(BODYC(), 32); bleb(BODYC(), 5); bput(BODYC(), 106);
    bput(BODYC(), 32); bleb(BODYC(), 6); bput(BODYC(), 65); bleb(BODYC(), 48); bput(BODYC(), 106);
    bput(BODYC(), 58); bput(BODYC(), 0); bput(BODYC(), 0);
    // i++
    bput(BODYC(), 32); bleb(BODYC(), 5); bput(BODYC(), 65); bleb(BODYC(), 1); bput(BODYC(), 106); bput(BODYC(), 33); bleb(BODYC(), 5);
    bput(BODYC(), 12); bleb(BODYC(), 0); bput(BODYC(), 11); bput(BODYC(), 11);
    // len = neg + load(s) + 7; store at p
    bput(BODYC(), 32); bleb(BODYC(), 2);
    bput(BODYC(), 32); bleb(BODYC(), 1); bput(BODYC(), 32); bleb(BODYC(), 4); bput(BODYC(), 40); bput(BODYC(), 2); bput(BODYC(), 0); bput(BODYC(), 106); bput(BODYC(), 65); bleb(BODYC(), 7); bput(BODYC(), 106);
    bput(BODYC(), 54); bput(BODYC(), 2); bput(BODYC(), 0);
    bput(BODYC(), 32); bleb(BODYC(), 2);
    bput(BODYC(), 11);
    return emit_helper_body(k);
}

fn f64zero() -> int { let i = 0; while (i < 8) { bput(BODYC(), 0); i = i + 1; } return 0; }

fn f64ten() -> int {
    bput(BODYC(), 0); bput(BODYC(), 0); bput(BODYC(), 0); bput(BODYC(), 0);
    bput(BODYC(), 0); bput(BODYC(), 0); bput(BODYC(), 36); bput(BODYC(), 64);
    return 0;
}

// ===== часть: 70c_module_sections.lat =====
// ============================ МОДУЛЬ: СЕКЦИИ ============================
// Сборка type/import/func/table/memory/global/export/element/code/data-секций
// и поиск индекса main для экспорта. Тела хелперов — в 70a/70b.

fn emit_sec(id, content) -> int {
    bput(OUTB(), id); bleb(OUTB(), blen(content)); bcopy(OUTB(), content, 0, blen(content));
    return 0;
}

fn build_module() -> int {
    binit(OUTB());
    bput(OUTB(), 0); bput(OUTB(), 97); bput(OUTB(), 115); bput(OUTB(), 109);
    bput(OUTB(), 1); bput(OUTB(), 0); bput(OUTB(), 0); bput(OUTB(), 0);
    let n = nf();
    let nl = nlam();
    emit_type_section();
    emit_import_section();
    emit_func_section(n, nl);
    emit_table_section(n, nl);
    emit_memory_section();
    emit_global_section();
    emit_export_section();
    emit_element_section(n, nl);
    emit_code_section(n, nl);
    emit_data_section();
    return 0;
}

fn emit_type_section() -> int {
    // type section: (i32)->void (idx0); arity 0..8 -> i32 (idx1..9);
    // arity 0..8 -> f64 (idx10..18) для float-возвращающих функций.
    // Лямбда арности np+1 берёт тип-индекс np+2 (см. lam_tp) => np до 7.
    binit(SCRB());
    bleb(SCRB(), 20);
    bput(SCRB(), 96); bleb(SCRB(), 1); bput(SCRB(), 127); bleb(SCRB(), 0);
    let a = 0;
    while (a < 9) {
        bput(SCRB(), 96); bleb(SCRB(), a);
        let q = 0; while (q < a) { bput(SCRB(), 127); q = q + 1; }
        bleb(SCRB(), 1); bput(SCRB(), 127);
        a = a + 1;
    }
    a = 0;
    while (a < 9) {
        bput(SCRB(), 96); bleb(SCRB(), a);
        let q = 0; while (q < a) { bput(SCRB(), 127); q = q + 1; }
        bleb(SCRB(), 1); bput(SCRB(), 124);   // -> f64
        a = a + 1;
    }
    // idx19: (f64)->i32 — f64_to_str.
    bput(SCRB(), 96); bleb(SCRB(), 1); bput(SCRB(), 124); bleb(SCRB(), 1); bput(SCRB(), 127);
    emit_sec(1, SCRB());
    return 0;
}

fn emit_import_section() -> int {
    // import
    binit(SCRB());
    bleb(SCRB(), 1);
    bleb(SCRB(), 3); bput(SCRB(),101); bput(SCRB(),110); bput(SCRB(),118);
    bleb(SCRB(), 5); bput(SCRB(),112); bput(SCRB(),114); bput(SCRB(),105); bput(SCRB(),110); bput(SCRB(),116);
    bput(SCRB(), 0); bleb(SCRB(), 0);
    emit_sec(2, SCRB());
    return 0;
}

fn emit_func_section(n, nl) -> int {
    // func section: n user + 7 хелперов + лямбды
    let nl = nlam();
    binit(SCRB());
    bleb(SCRB(), n + 8 + nl);
    let i = 0;
    while (i < n) {
        // float-возвращающая функция берёт тип-индекс из блока ->f64 (10+arity).
        if (load32(FNRET() + i * 4) == T_FLT()) {
            bleb(SCRB(), 10 + load32(FNNP() + i * 4));
        } else {
            bleb(SCRB(), load32(FNNP() + i * 4) + 1);
        }
        i = i + 1;
    }
    bleb(SCRB(), 2);   // alloc: (i32)->i32 = type2
    bleb(SCRB(), 4);   // memcopy: (i32,i32,i32)->i32 = type4
    bleb(SCRB(), 3);   // str_concat: (i32,i32)->i32 = type3
    bleb(SCRB(), 3);   // str_eq
    bleb(SCRB(), 3);   // str_char_at
    bleb(SCRB(), 2);   // i32_to_str: (i32)->i32 = type2
    bleb(SCRB(), 2);   // str_to_i32: (i32)->i32 = type2
    bleb(SCRB(), 19);  // f64_to_str: (f64)->i32 = type19
    i = 0;
    while (i < nl) { bleb(SCRB(), lam_tp(i)); i = i + 1; }
    emit_sec(3, SCRB());
    return 0;
}

fn emit_table_section(n, nl) -> int {
    // table section (id 4): funcref, если есть лямбды. Все функции модуля
    // лежат в таблице по слотам = индексам функций (0..total-1).
    if (nl > 0) {
        binit(SCRB());
        bleb(SCRB(), 1);            // 1 таблица
        bput(SCRB(), 112);          // funcref
        bput(SCRB(), 0);            // limits: min only
        bleb(SCRB(), 1 + n + 8 + nl);
        emit_sec(4, SCRB());
    }
    return 0;
}

fn emit_memory_section() -> int {
    // memory: 16 pages
    binit(SCRB());
    bleb(SCRB(), 1); bput(SCRB(), 0); bleb(SCRB(), 64);
    emit_sec(5, SCRB());
    return 0;
}

fn emit_global_section() -> int {
    // global: heap = 1024 + data_len
    binit(SCRB());
    bleb(SCRB(), 1); bput(SCRB(), 127); bput(SCRB(), 1);
    bput(SCRB(), 65); bleb(SCRB(), 1024 + load32(DATAB())); bput(SCRB(), 11);
    emit_sec(6, SCRB());
    return 0;
}

fn emit_export_section() -> int {
    // export: memory + main
    binit(SCRB());
    bleb(SCRB(), 2);
    bleb(SCRB(), 6); bput(SCRB(),109); bput(SCRB(),101); bput(SCRB(),109); bput(SCRB(),111); bput(SCRB(),114); bput(SCRB(),121);
    bput(SCRB(), 2); bleb(SCRB(), 0);
    bleb(SCRB(), 4); bput(SCRB(),109); bput(SCRB(),97); bput(SCRB(),105); bput(SCRB(),110);
    bput(SCRB(), 0); bleb(SCRB(), find_main() + 1);
    emit_sec(7, SCRB());
    return 0;
}

fn emit_element_section(n, nl) -> int {
    // element section (id 9): все функции модуля в таблице (слот = индекс).
    if (nl > 0) {
        binit(SCRB());
        bleb(SCRB(), 1);            // 1 сегмент
        bput(SCRB(), 0);            // active, table 0
        bput(SCRB(), 65); bleb(SCRB(), 0); bput(SCRB(), 11);   // offset = 0
        let tot = 1 + n + 8 + nl;
        bleb(SCRB(), tot);
        let q = 0;
        while (q < tot) { bleb(SCRB(), q); q = q + 1; }
        emit_sec(9, SCRB());
    }
    return 0;
}

fn emit_code_section(n, nl) -> int {
    // code section: n + 8 + nl bodies
    binit(SCRB());
    bleb(SCRB(), n + 8 + nl);
    let i = 0;
    while (i < n + 8 + nl) {
        bleb(SCRB(), load32(CODELN() + i * 4));
        let q = 0;
        while (q < load32(CODELN() + i * 4)) {
            bput(SCRB(), load8(CODEB() + 4 + load32(CODEOF() + i * 4) + q));
            q = q + 1;
        }
        i = i + 1;
    }
    emit_sec(10, SCRB());
    return 0;
}

fn emit_data_section() -> int {
    // data section: одна активная сегмент-группа на каждый литерал
    if (get(0, 6) > 0) {
        binit(SCRB());
        bleb(SCRB(), 1);      // 1 segment (объединяет все блобы подряд по адресу 1024)
        bput(SCRB(), 0);      // active, mem 0
        bput(SCRB(), 65); bleb(SCRB(), 1024); bput(SCRB(), 11);
        bleb(SCRB(), load32(DATAB()));
        let q = 0;
        while (q < load32(DATAB())) { bput(SCRB(), load8(DATAB() + 4 + q)); q = q + 1; }
        emit_sec(11, SCRB());
    }
    return 0;
}

fn find_main() -> int {
    let i = 0; let n = nf();
    while (i < n) {
        if (is_lit(load32(FNOFF() + i * 4), load32(FNLEN() + i * 4), "main", 4)) { return i; }
        i = i + 1;
    }
    return 0;
}

// ===== часть: 90_driver.lat =====
fn compile_program() -> int {
    let reserve = alloc(4600000);   // гарантировать рост памяти под все области
    store32(reserve, 0);
    binit(OUTB()); binit(SCRB()); binit(FNB()); binit(CODEB()); binit(BODYC()); binit(DATAB());
    set(0, 4, 0); set(0, 5, 0); set(0, 6, 0); set(0, 7, 0);
    set_ncls(0); set_nfcls(0); set_nmeth(0); set_nvar(4);
    set_nlam(0); set_ncap(0);
    let nt = tokenize();
    set(0, 1, nt);
    scan_classes();
    scan_enums();
    let n = scan_signatures();
    scan_lambdas();
    register_lambdas();
    // Тайп-чек: при ошибке пишем её текст в OUTB и возвращаем -длину
    // (отрицательный результат отличает ошибку от успешного WASM).
    tc_program();
    if (get(0, 4) != 0) {
        binit(OUTB());
        bcopy(OUTB(), ERRB(), 0, blen(ERRB()));
        return 0 - blen(OUTB());
    }
    let i = 0;
    while (i < n) { compile_fn(i); i = i + 1; }
    let li = 0;
    while (li < nlam()) { compile_lambda(li); li = li + 1; }
    helper_bodies();
    // Ошибка кодогена не должна давать невалидный WASM: сообщение уже в ERRB
    // (err_named/err), возвращаем отрицательную длину — как при ошибках типов.
    if (get(0, 4) != 0) {
        if (blen(ERRB()) == 0) { tcerr_msg("error: compilation failed"); }
        binit(OUTB());
        bcopy(OUTB(), ERRB(), 0, blen(ERRB()));
        return 0 - blen(OUTB());
    }
    build_module();
    return blen(OUTB());
}

fn main() -> int { return compile_program(); }
