// Все операторы языка: арифметика, сравнение, логика, приоритет

fn main() -> int {
    let a = 17;
    let b = 5;

    // Арифметика
    print("a + b =", a + b);
    print("a - b =", a - b);
    print("a * b =", a * b);
    print("a / b =", a / b);
    print("a % b =", a % b);

    // Сравнения
    print("a == b:", a == b, " a != b:", a != b);
    print("a > b:", a > b, " a < b:", a < b);
    print("a >= b:", a >= b, " a <= b:", a <= b);

    // Приоритет: умножение выше сложения, скобки меняют порядок
    print("2 + 3 * 4 =", 2 + 3 * 4);
    print("(2 + 3) * 4 =", (2 + 3) * 4);

    // Логические операторы и унарный минус
    let t = true;
    let g = false;
    print("t && g:", t && g, " t || g:", t || g, " !t:", !t);
    print("unary -a =", -a);

    return 0;
}
